<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata" fqn="myTableComponent">
    <apiVersion>59.0</apiVersion>
    <isExposed>true</isExposed>
    <targets>
        <target>lightning__RecordPage</target>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__FlowScreen</target>
        <!-- Agrega cualquier otro target que necesites -->
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__HomePage,lightning__RecordPage">
            <property name="infoName" type="String" default="Welcome in Salesforce" label="Data"/>
            <property name="colName" type="String" default="true" label="Columns"/>
            <property name="hideCheckboxName" type="String" default="" label="Select Rows"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>