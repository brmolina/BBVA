<aura:component extends="arce:Arc_IFIS_Aura_Utils" controller="Arc_IFIS_ButtonsCancel_Ctrl" access="global">
    <aura:attribute name="ahaId" type="String" default="" description="Indicates the id of the current record" access="global" />
    <aura:attribute name="modalHeader" type="String" default="" description="Indicates the title of the modal" access="global" />
    <aura:attribute name="showModal" type="String" default="" description="Controls the modal visibility" access="global" />
    <aura:attribute name="isLoading" type="boolean" default="false" description="Indicates if the spinner is active" access="global" />
    <aura:attribute name="disableButtons" type="Boolean" default="true" description="Disables finish button"/>
    <aura:attribute name="reasonValue" type="String" description="saves the selected reason"/>
    <aura:attribute name="reasonLabel" type="String" description="saves the selected reason lavel"/>
    <aura:attribute name="reasonList" type="List" default="" description="List of the different values from comments of exclusion"/>

    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />

    <aura:if isTrue="{!v.showModal}">
        <section role="dialog" tabindex="-1" aria-modal="true" aria-labelledby="modal-heading-01" class="slds-modal slds-fade-in-open slds-modal_small">
            <div class="slds-modal__container">

                <lightning:buttonIcon
                    iconName="utility:close"
                    onclick="{!c.handleClose}"
                    alternativeText="{!$Label.arce.Arc_IFIS_Cancel_Close}"
                    variant="bare-inverse"
                    class="slds-modal__close" />

                <div class="slds-modal__header">
                    <h1 id="modal-heading-01" class="slds-modal__title slds-hyphenate">{!v.modalHeader}</h1>
                </div>

                <div class="slds-modal__content slds-var-p-horizontal_medium slds-var-p-vertical_large" id="modal-content-id-1">
                    <aura:if isTrue="{!v.isLoading}">

                        <div class="slds-p-around_x-large">
                            <div role="status" class="slds-spinner slds-spinner_medium slds-spinner_brand">
                                <span class="slds-assistive-text">{!$Label.arce.Arc_IFIS_Loading}</span>
                                <div class="slds-spinner__dot-a"></div>
                                <div class="slds-spinner__dot-b"></div>
                            </div>
                        </div>

                        <aura:set attribute="else">
                            <div class="slds-m-bottom_xx-small">
                                <lightning:combobox aura:id="reasonCombo"
                                    name="reasonCombo"
                                    label="{!$Label.arce.Arc_IFIS_BtnCancel_Reason}"
                                    onchange="{!c.onSelectReason}"
                                    value="{!v.reasonValue}"
                                    maxlength="255"
                                    options="{!v.reasonList}"
                                    required="true" />
                            </div>
                            <div class="slds-m-bottom_xx-small">
                                <lightning:textarea aura:id="reasonDesc"
                                    name="reasonDesc"
                                    label="{!$Label.arce.Arc_IFIS_Comments}"
                                    maxlength="255" />
                            </div>
                        </aura:set>
                    </aura:if>
                </div>

                <div class="slds-modal__footer">
                    <lightning:button
                        variant="neutral"
                        label="{!$Label.arce.Arc_IFIS_Cancel}"
                        title="{!$Label.arce.Arc_IFIS_Cancel}"
                        onclick="{!c.handleClose}"/>
                    <lightning:button
                        variant="brand"
                        label="{!$Label.arce.Arc_IFIS_Save}"
                        title="{!$Label.arce.Arc_IFIS_Save}"
                        disabled="{!v.disableButtons}"
                        onclick="{!c.handleSave}"/>
                </div>
            </div>
        </section>
        <div class="slds-backdrop slds-backdrop_open" role="presentation"></div>
    </aura:if>
</aura:component>