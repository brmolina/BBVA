<aura:component
    implements="force:appHostable,force:hasSObjectName,lightning:actionOverride,flexipage:availableForRecordHome,force:lightningQuickActionWithoutHeader,force:hasRecordId"
    controller="DMT_OpportunityTriggerHandler"
    access="global">

    <aura:attribute name="recordId" type="Id"/>

    <aura:handler name="init"
                  value="{!this}"
                  action="{!c.doInit}"/>

</aura:component>