        </div>
        <div class="slds-col slds-size_1-of-3">
            <aura:if isTrue="{!v.NewODT__c}">
                <div class="slds-size_4-of-4 slds-m-right_xx-small">
                    <div class="slds-m-top_small slds-m-bottom_large slds-text-heading_small">
                        <div class="slds-box slds-size_4-of-4 slds-m-right_xx-small slds-m-left_xx-small">
                            <div class="slds-m-top_small slds-m-bottom_large slds-text-heading_small">
                                <strong><p>Requisitos</p></strong>
                            </div>
                            <div class="slds-m-top_small slds-m-bottom_large slds-text-heading_small">
                                <lightning:input type="checkbox" aura:id="fimaRepresODT" checked="{!v.FirmOdtClient__c}" name="fimaRepresODT" label="Revisar que el apoderado legal este dado de alta en 32-70 (PU)" onchange="{!c.handleIsCheck}" />
                            </div>

                            <div class="slds-m-top_small slds-m-bottom_large slds-text-heading_small">
                                <lightning:input type="checkbox" aura:id="firmaClienteODT" checked="{!v.FirmODTUser__c}" name="firmaClienteODT" label="Orden de Trabajo (ODT) firmada por el  representante legal del cliente." onchange="{!c.handleIsCheck}" />
                            </div>

                            <div class="slds-m-top_small slds-m-bottom_large slds-text-heading_small">
                                <lightning:input type="checkbox" aura:id="scanODT" checked="{!v.ScanODT__c}" name="scanODT" label="Copia digital firmada de la ODT." onchange="{!c.handleIsCheck}" />
                            </div>

                            <div class="slds-m-top_small slds-m-bottom_large slds-text-heading_small">
                                <lightning:input type="checkbox" aura:id="archRespaldo" checked="{!v.archRespaldo__c}" name="archRespaldo" label="Archivo de respaldo de la copia digital." onchange="{!c.handleIsCheck}" />
                            </div>

                            <div class="slds-m-top_small slds-m-bottom_large slds-text-heading_small">
                                <lightning:button label="Guardar cambios" disabled="{!v.isDisable}" onclick="{!c.handleCheckODT}" variant="brand" />
                                <lightning:button name="Rechazar" label="Rechazar" disabled="{!v.disableButtons}" onclick="{!c.handleRechazar}" />
                            </div>
                        </div>
                    </div>
                </div>
                <aura:set attribute="else">
                    <div class="slds-size_4-of-4 slds-m-right_xx-small">
                        <div class="slds-m-top_small slds-m-bottom_large slds-text-heading_small">
                            <div class="slds-box slds-size_4-of-4 slds-m-right_xx-small slds-m-left_xx-small">
                                <span class="slds-page-header__title slds-truncate" title="Requisitos">Requisitos</span>
                                <div>
                                    Revisión de tasas e información de la solicitud de formalización.
                                </div>
                                <button class="slds-button slds-button_brand" disabled="{!v.disableButtons}" name="{!v.savebutton}" label="Autorizar" onclick="{!c.handleSave}">Autorizar</button>
                                <lightning:button name="Rechazar" label="Rechazar" disabled="{!v.disableButtons}" onclick="{!c.handleRechazar}" />
                            </div>
                        </div>
                    </div>
                </aura:set>
            </aura:if>
        </div>
        <div class="slds-scrollable_y" style="height:100rem;width:100rem" tabindex="0">
            <div class="slds-modal-body">
                <div class="slds-box slds-theme_default">
                    <div class="slds-grid slds-gutters">
                        <div class="slds-col slds-size_1-of-4">
                            <div class="slds-form-element">
                                <lightning:select name="existingUser" aura:id="existingUser" label="Seleccionar usuario para crear la ODT:" required="true" value="{!v.existingUser}" onchange="{!c.handleFieldChange}">
                                    <option value="{!v.existingUser}">{!v.existingUser}</option>
                                    <aura:iteration items="{!v.usersToODTNamesLst}" var="usersToODT">
                                        <option text="{!usersToODT}" value="{!usersToODT}" />
                                    </aura:iteration>
                                </lightning:select>
                            </div>
                            <div class="slds-form-element">
                                <lightning:textarea name="cc" aura:id="cc" value="" label="Agrege algun correo para que quede en copia: " onchange="{!c.checkCC}" messageWhenValueMissing="Este campo es obliatorio." />
                            </div>
                            <!-- <div class="slds-form-element">
                                <lightning:textarea name="asunto" aura:id="asunto" value="" label="Especifique asunto del correo: " messageWhenValueMissing="Este campo es obliatorio." />
                            </div>-->
                            <div class="slds-m-top_small slds-m-bottom slds-text-heading_small">
                                <div class="slds-form-element slds-dropdown-trigger slds-dropdown-trigger_click slds-is-open">
                                    <lightning:input aura:id="initDate" label="Inicio de vigencia de la tasa: " type="date" name="input1" min="{!v.minDate}" onchange="{!c.checDate}" />
                                </div>
                            </div>
                            <div class="slds-m-top_small slds-m-bottom slds-text-heading_small">
                                <div class="slds-form-element slds-dropdown-trigger slds-dropdown-trigger_click slds-is-open">
                                    <lightning:input aura:id="revisionDate" label="Recordatorio de revisión de tasa: " disabled="{!v.isDateSlected}" onchange="{!c.checDateRevision}" type="date" name="input2" min="{!v.minDateRevision}" />
                                </div>
                            </div>
                        </div>
                        <div class="slds-col slds-size_3-of-4">
                            <body>
                                <table width="100%;" Style="border-collapse: collapse;">
                                    <thead>
                                        <tr>
                                            <td Style="background-color: #004483; color:white;">
                                                <p class="Title">Tasa seleccionada</p>
                                            </td>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td style="padding-bottom: 25px;"></td>
                                        </tr>
                                        <tr>
                                            <table width="100%;" Style="border-collapse: collapse;">
                                                <tbody>
                                                    <tr class="Headboard">
                                                        <td>
                                                            <p class="HeadboardTitlePadding-left">Débito</p>
                                                        </td>
                                                        <td>
                                                            <p class="HeadboardTitle">Crédito</p>
                                                        </td>
                                                        <td>
                                                            <p class="HeadboardTitle">Internacional</p>
                                                        </td>
                                                        <td>
                                                            <p class="HeadboardTitle">Resultado</p>
                                                        </td>
