<aura:component implements="flexipage:availableForAllPageTypes,force:hasRecordId" access="global" controller="DPMX_FormalizeDetails_ctrl">

    <aura:attribute name="recordId" type="String" />
    <aura:attribute name="authType" type="String" />
    <aura:attribute name="authTypeName" type="String" />
    <aura:attribute name="authSolicitudeName" type="String" />
    <aura:attribute name="authTypeProduct" type="String" />
    <aura:attribute name="authTypeRazSoc" type="String" />
    <aura:attribute name="authTypeFam" type="String" />

    <aura:attribute name="authBai" type="String" />
    <aura:attribute name="authCredit" type="String" />
    <aura:attribute name="authDebit" type="String" />
    <aura:attribute name="authInternational" type="String" />
    <aura:attribute name="authProfitability" type="String" />
    <aura:attribute name="authResult" type="String" />
    <aura:attribute name="authFamily" type="String" default="---" />
    <aura:attribute name="isGs" type="Boolean" default="false" />

    <aura:attribute name="dynamicPricingId" type="String" />

    <aura:attribute name="debitBase" type="String" />
    <aura:attribute name="creditBase" type="String" />
    <aura:attribute name="internationalBase" type="String" />
    <aura:attribute name="rentaBase" type="String" />
    <aura:attribute name="baiBase" type="String" />

    <aura:attribute name="archRespaldo__c" type="Boolean" default="false" />

    <aura:attribute name="FirmODTUser__c" type="Boolean" default="false" />
    <aura:attribute name="FirmOdtClient__c" type="Boolean" default="false" />
    <aura:attribute name="NewODT__c" type="Boolean" default="false" />
    <aura:attribute name="ScanODT__c" type="Boolean" default="false" />
    <aura:attribute name="isDisable" type="Boolean" default="true" />

    <aura:attribute name="debitTasa" type="String" />
    <aura:attribute name="creditTasa" type="String" />
    <aura:attribute name="internationalTasa" type="String" />

    <aura:attribute name="DPMX_Company_Name__c" type="String" />
    <aura:attribute name="DPMX_familia__c" type="String" />
    <aura:attribute name="DPMX_NumeroCliente__c" type="String" />
    <aura:attribute name="consultDate" type="String" />

    <aura:attribute name="DPMX_debit" type="String" />
    <aura:attribute name="DPMX_credit" type="String" />
    <aura:attribute name="DPMX_International" type="String" />
    <aura:attribute name="DPMX_Resultado" type="String" />
    <aura:attribute name="DPMX_Rentabilidad" type="String" />
    <aura:attribute name="DPMX_BAI" type="String" />

    <aura:attribute name="DPMX_extraBillingRub" type="String" />
    <aura:attribute name="DPMX_billingRub" type="String" />
    <aura:attribute name="DPMX_cellnetRub" type="String" />

    <aura:attribute name="DPMX_Date" type="String" />

    <aura:attribute name="DPMX_monetaryCeiling" type="String" />
    <aura:attribute name="DPMX_extraBilling" type="String" />
    <aura:attribute name="DPMX_billing" type="String" />
    <aura:attribute name="DPMX_cellnet" type="String" />
    <aura:attribute name="DPMX_totalAmount" type="String" />
    <aura:attribute name="DPMX_totalAmountSim" type="String" />
    <aura:attribute name="DPMX_mit" type="String" />

    <aura:attribute name="DPMX_transaction_y_debit_own" type="String" />
    <aura:attribute name="DPMX_billing_debit_own" type="String" />
    <aura:attribute name="DPMX_tickets_debit_own" type="String" />
    <aura:attribute name="DPMX_percentage_debit_own" type="String" />

    <aura:attribute name="DPMX_transaction_y_debit_thirdParty" type="String" />
    <aura:attribute name="DPMX_billing_debit_thirdParty" type="String" />
    <aura:attribute name="DPMX_tickets_debit_thirdParty" type="String" />
    <aura:attribute name="DPMX_percentage_debit_thirdParty" type="String" />

    <aura:attribute name="DPMX_transaction_y_credit_own" type="String" />
    <aura:attribute name="DPMX_billing_credit_own" type="String" />
    <aura:attribute name="DPMX_tickets_credit_own" type="String" />
    <aura:attribute name="DPMX_percentage_credit_own" type="String" />

    <aura:attribute name="DPMX_transaction_y_credit_thirdParty" type="String" />
    <aura:attribute name="DPMX_billing_credit_thirdParty" type="String" />
    <aura:attribute name="DPMX_tickets_credit_thirdParty" type="String" />
    <aura:attribute name="DPMX_percentage_credit_thirdParty" type="String" />

    <aura:attribute name="DPMX_transaction_y_international" type="String" />
    <aura:attribute name="DPMX_billing_international" type="String" />
    <aura:attribute name="DPMX_tickets_international" type="String" />
    <aura:attribute name="DPMX_percentage_international" type="String" />

    <aura:attribute name="DPMX_transaction_y_total" type="String" />
    <aura:attribute name="DPMX_billing_total" type="String" />
    <aura:attribute name="DPMX_tickets_total" type="String" />
    <aura:attribute name="DPMX_percentage_total" type="String" />

    <aura:attribute name="DPMX_terminal" type="String" />
    <aura:attribute name="DPMX_pinPads" type="String" />
    <aura:attribute name="DPMX_ecommerceCheckbox" type="String" />
    <aura:attribute name="DPMX_devicesNumber" type="String" />

    <aura:attribute name="DPMX_scenario" type="String" />

    <aura:attribute name="DPMX_debitPorpio" type="String" />
    <aura:attribute name="DPMX_creditPorpio" type="String" />
    <aura:attribute name="DPMX_interPorpio" type="String" />
    <aura:attribute name="DPMX_resultPorpio" type="String" />
    <aura:attribute name="DPMX_rentPorpio" type="String" />
    <aura:attribute name="DPMX_baiPorpio" type="String" />

    <aura:attribute name="DPMX_oppPosExtra" type="String" />
    <aura:attribute name="DPMX_oppCallnet" type="String" />
    <aura:attribute name="DPMX_oppLowBilling" type="String" />

    <aura:attribute name="DPMX_basisPoints" type="String" />

    <aura:attribute name="DPMX_interchangeRates_debit" type="String" />
    <aura:attribute name="DPMX_interchangeRates_credit" type="String" />
    <aura:attribute name="DPMX_interchangeRates_International" type="String" />

    <aura:attribute name="DPMX_discountRates_debit" type="String" />
    <aura:attribute name="DPMX_discountRates_credit" type="String" />
    <aura:attribute name="DPMX_discountRates_International" type="String" />

    <aura:attribute name="DPMX_DescuentoMaximo" type="String" />

    <aura:attribute name="formalizeExist" type="Boolean" default="false" />

    <aura:attribute name="usersToODTLst" type="List" default="[]" />
    <aura:attribute name="usersToODTNamesLst" type="List" default="[]" />
    <aura:attribute name="existingUser" type="String" default="Seleccionar usuario" />

    <aura:attribute name="disableButtons" type="Boolean" default="true" />

    <aura:attribute name="DPMX_sel_debit" type="String" />
    <aura:attribute name="DPMX_sel_credit" type="String" />
    <aura:attribute name="DPMX_sel_International" type="String" />
    <aura:attribute name="DPMX_sel_Rent" type="String" />
    <aura:attribute name="DPMX_sel_Bai" type="String" />
    <aura:attribute name="DPMX_sel_Result" type="String" />


    <aura:attribute name="initDate" type="String" />
    <aura:attribute name="revisionDate" type="String" />

    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />

    <div class="slds-grid slds-gutters">
        <div class="slds-col slds-size_2-of-3">
            <div class="slds-box slds-box_small">
                <div class="slds-page-header slds-m-bottom_x-large">
                    <div class="slds-page-header__row">
                        <div class="slds-page-header__col-title">
                            <div class="slds-media">
                                <div class="slds-media__body">
                                    <div class="slds-page-header__name">
                                        <div class="slds-page-header__name-title">
                                            <h1>
                                                <span class="slds-page-header__title slds-truncate" title="Detalles de formalización">Detalles de formalización</span>
                                            </h1>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div>
                    <div class="slds-grid slds-gutters">
                        <div class="slds-col slds-size_1-of-3">
                            <p>Dynamic pricing</p>
                        </div>
                        <div class="slds-col slds-size_1-of-3">
                            <p>Propietario</p>
                        </div>
                        <div class="slds-col slds-size_1-of-3">
                            <p>Producto</p>
                        </div>
                    </div>
                    <div class="slds-grid slds-gutters slds-m-bottom_medium">
                        <div class="slds-col slds-size_1-of-3">
                            <p>{!v.authTypeName}</p>
                        </div>
                        <div class="slds-col slds-size_1-of-3">
                            <p>{!v.authSolicitudeName}</p>
                        </div>
                        <div class="slds-col slds-size_1-of-3">
                            <p>{!v.authTypeProduct}</p>
                        </div>
                    </div>
                    <div class="slds-grid slds-gutters">
                        <div class="slds-col slds-size_1-of-3">
                            <p>Razón social</p>
                        </div>
                        <div class="slds-col slds-size_1-of-3">
                            <p>Giro</p>
                        </div>
                        <div class="slds-col slds-size_1-of-3">
                            <p>Tipo de tasa</p>
                        </div>
                    </div>
                    <div class="slds-grid slds-gutters">
                        <div class="slds-col slds-size_1-of-3">
                            <p>{!v.authTypeRazSoc}</p>
                        </div>
                        <div class="slds-col slds-size_1-of-3">
                            <p>{!v.authTypeFam}</p>
                        </div>
                        <div class="slds-col slds-size_1-of-3">
                            <p>{!v.DPMX_sel_Result}</p>
                        </div>
                    </div>
                    <div class="slds-grid slds-gutters">
                        <div class="slds-col slds-size_1-of-2">
                            <p> ‎ </p>
                        </div>
                    </div>
                    <div class="slds-grid slds-gutters">
                        <div class="slds-col slds-size_1-of-3">
                            <p>Inicio de vigencia de la tasa:</p>
                        </div>
                        <div class="slds-col slds-size_1-of-3">
                            <p>Recordatorio de revisión de tasa:</p>
                        </div>
                    </div>
                    <div class="slds-grid slds-gutters">
                        <div class="slds-col slds-size_1-of-3">
                            <p>{!v.initDate}</p>
                        </div>
                        <div class="slds-col slds-size_1-of-3">
                            <p>{!v.revisionDate}</p>
                        </div>
                    </div>
                    <div class="slds-grid slds-gutters">
                        <div class="slds-col slds-size_1-of-2">
                            <p> ‎ </p>
                        </div>
                    </div>
                    <div>
                        <h1 class="slds-hyphenate">Propuesta por autorizar</h1>
                        <table class="slds-table slds-table_cell-buffer slds-table_bordered" aria-labelledby="element-with-table-label other-element-with-table-label">
                            <thead>
                                <tr class="slds-line-height_reset">
                                    <th class="" scope="col">
                                        <div class="slds-truncate" title="Tasa">Tasa</div>
                                    </th>
                                    <!--
                                    <th class="" scope="col">
                                        <div class="slds-truncate" title="Cliente">Cliente</div>
                                    </th>
                                    <th class="" scope="col">
                                        <div class="slds-truncate" title="Familia">Familia</div>
                                    </th>
                                    <th class="" scope="col">
                                        <div class="slds-truncate" title="Resultado">Resultado</div>
                                    </th>
                                    -->
                                    <th class="" scope="col">
                                        <div class="slds-truncate" title="Débito">Débito</div>
                                    </th>
                                    <th class="" scope="col">
                                        <div class="slds-truncate" title="Crédito">Crédito</div>
                                    </th>
                                    <th class="" scope="col">
                                        <div class="slds-truncate" title="Internacional">Internacional</div>
                                    </th>
                                    <th class="" scope="col">
                                        <div class="slds-truncate" title="Rentabilidad">Rentabilidad</div>
                                    </th>
                                    <th class="" scope="col">
                                        <div class="slds-truncate" title="BAI">BAI</div>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="slds-hint-parent">
                                    <td>
                                        <div class="slds-truncate">
                                            Tasa seleccionada
                                        </div>
                                    </td>
                                    <!--
                                    <td>
                                        <div class="slds-truncate">
                                            <c:DPMX_DynamicTableField fieldType="REFERENCE" fieldValue="{!v.clientName}" />
                                        </div>
                                    </td>
                                    <td>
                                        <div class="slds-truncate">
                                            <c:DPMX_DynamicTableField fieldType="REFERENCE" fieldValue="{!v.authFamily}" />
                                        </div>
                                    </td>
                                    <td>
                                        <div class="slds-truncate">
                                            <c:DPMX_DynamicTableField fieldType="REFERENCE" fieldValue="{!v.authResult}" />
                                        </div>
                                    </td>
                                    -->
                                    <td>
                                        <div class="slds-truncate">
                                            <aura:if isTrue="{!v.isGs}">
                                                <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!v.authDebit}" currencyText="MXN" />
                                                <aura:set attribute="else">
                                                    <c:DPMX_DynamicTableField fieldType="PERCENTAGE" fieldValue="{!v.authDebit}" />
                                                </aura:set>
                                            </aura:if>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="slds-truncate">
                                            <c:DPMX_DynamicTableField fieldType="PERCENTAGE" fieldValue="{!v.authCredit}" />
                                        </div>
                                    </td>
                                    <td>
                                        <div class="slds-truncate">
                                            <c:DPMX_DynamicTableField fieldType="PERCENTAGE" fieldValue="{!v.authInternational}" />
                                        </div>
                                    </td>
                                    <td>
                                        <div class="slds-truncate">
                                            <c:DPMX_DynamicTableField fieldType="NUMBER" fieldValue="{!v.authProfitability}" />
                                        </div>
                                    </td>
                                    <td>
                                        <div class="slds-truncate">
                                            <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!v.authBai}" currencyText="MXN" />
                                        </div>
                                    </td>
                                </tr>
                                <tr class="slds-hint-parent">
                                    <td>
                                        <div class="slds-truncate">
                                            Tasa actual
                                        </div>
                                    </td>
                                    <!--
                                    <td>
                                        <div class="slds-truncate">
                                            <c:DPMX_DynamicTableField fieldType="REFERENCE" fieldValue="{!v.clientName}" />
                                        </div>
                                    </td>
                                    <td>
                                        <div class="slds-truncate">
                                            <c:DPMX_DynamicTableField fieldType="REFERENCE" fieldValue="{!v.authTypeFam}" />
                                        </div>
                                    </td>
                                    <td>
                                        <div class="slds-truncate">
                                            <c:DPMX_DynamicTableField fieldType="REFERENCE" fieldValue="{!v.authResult}" />
                                        </div>
                                    </td>
                                    -->
                                    <td>
                                        <div class="slds-truncate">
                                            <aura:if isTrue="{!v.isGs}">
                                                <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!v.debitBase}" currencyText="MXN" />
                                                <aura:set attribute="else">
                                                    <c:DPMX_DynamicTableField fieldType="PERCENTAGE" fieldValue="{!v.debitBase}" />
                                                </aura:set>
                                            </aura:if>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="slds-truncate">
                                            <c:DPMX_DynamicTableField fieldType="PERCENTAGE" fieldValue="{!v.creditBase}" />
                                        </div>
                                    </td>
                                    <td>
                                        <div class="slds-truncate">
                                            <c:DPMX_DynamicTableField fieldType="PERCENTAGE" fieldValue="{!v.internationalBase}" />
                                        </div>
                                    </td>
                                    <td>
                                        <div class="slds-truncate">
                                            <c:DPMX_DynamicTableField fieldType="NUMBER" fieldValue="{!v.rentaBase}" />
                                        </div>
                                    </td>
                                    <td>
                                        <div class="slds-truncate">
                                            <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!v.baiBase}" currencyText="MXN" />
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>



                <!--<div class="slds-scrollable_y" style="height:100rem;width:100rem" tabindex="0">-->
                <div>
                    <div class="slds-modal-body">
                        <div class="slds-box slds-theme_default">
                            <div class="slds-grid slds-gutters">
                                <div class="slds-col slds-size_3-of-4">
                                    <div class="headParent">
                                        <div class="headChild2">
                                            <div>Nombre del grupo: {!v.DPMX_Company_Name__c} </div>
                                            <div>Giro: {!v.DPMX_familia__c} </div>
                                            <div>Número del cliente: {!v.DPMX_NumeroCliente__c} </div>
                                            <div>Fecha: {!v.consultDate}</div>
                                        </div>
                                    </div>
                                    <div class="slds-grid slds-gutters">
                                        <div class="slds-col slds-size_1-of-2">
                                            <p> ‎ </p>
                                        </div>
                                    </div>
                                    <body>
                                        <table width="100%;" Style="border-collapse: collapse;">
                                            <thead>
                                                <tr>
                                                    <td Style="background-color: #004483; color:white;">
                                                        <p class="Title">Tasa seleccionada</p>
                                                    </td>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td style="padding-bottom: 25px;"></td>
                                                </tr>
                                                <tr>
                                                    <table width="100%;" Style="border-collapse: collapse;">
                                                        <tbody>
                                                            <tr class="Headboard">
                                                                <td>
                                                                    <p class="HeadboardTitlePadding-left">Débito</p>
                                                                </td>
                                                                <td>
                                                                    <p class="HeadboardTitle">Crédito</p>
                                                                </td>
                                                                <td>
                                                                    <p class="HeadboardTitle">Internacional</p>
                                                                </td>
                                                                <td>
                                                                    <p class="HeadboardTitle">Resultado</p>
                                                                </td>
                                                                <td>
                                                                    <p class="HeadboardTitle">Rentabilidad</p>
                                                                </td>
                                                                <td>
                                                                    <p class="HeadboardTitle">BAI</p>
                                                                </td>
                                                            </tr>
                                                            <tr class="trParent">
                                                                <td>
                                                                    <p class="padding-left">{!v.DPMX_sel_debit}</p>
                                                                </td>
                                                                <td>
                                                                    <p>{!v.DPMX_sel_credit}</p>
                                                                </td>
                                                                <td>
                                                                    <p>{!v.DPMX_sel_International}</p>
                                                                </td>
                                                                <td>
                                                                    <p>{!v.DPMX_sel_Result}</p>
                                                                </td>
                                                                <td>
                                                                    <p>{!v.DPMX_sel_Rent}</p>
                                                                </td>
                                                                <td>
                                                                    <p>{!v.DPMX_sel_Bai}</p>
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </tr>
                                                <tr>
                                                    <td class="backgound-gray">
                                                        <p class="Between tasa select and rest"></p>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
    
                                        <table width="100%;" Style="border-collapse: collapse;">
                                            <thead>
                                                <tr>
                                                    <td Style="background-color: #004483; color:white;">
                                                        <p class="Title">Tasas de descuento pactadas en la última negociación</p>
                                                    </td>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td class="backgound-gray">
                                                        <p class="Title">Tasas descuento actuales</p>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="padding-bottom: 25px;"></td>
                                                </tr>
                                                <tr>
                                                    <table width="100%;" Style="border-collapse: collapse;">
                                                        <tbody>
                                                            <tr class="Headboard">
                                                                <td>
                                                                    <p class="HeadboardTitlePadding-left">Débito</p>
                                                                </td>
                                                                <td>
                                                                    <p class="HeadboardTitle">Crédito</p>
                                                                </td>
                                                                <td>
                                                                    <p class="HeadboardTitle">Internacional</p>
                                                                </td>
                                                                <td>
                                                                    <p class="HeadboardTitle">Resultado</p>
                                                                </td>
                                                                <td>
                                                                    <p class="HeadboardTitle">Rentabilidad</p>
                                                                </td>
                                                                <td>
                                                                    <p class="HeadboardTitle">BAI</p>
                                                                </td>
                                                            </tr>
                                                            <tr class="trParent">
                                                                <td>
                                                                    <p class="padding-left">{!v.DPMX_debit}</p>
                                                                </td>
                                                                <td>
                                                                    <p>{!v.DPMX_credit}</p>
                                                                </td>
                                                                <td>
                                                                    <p>{!v.DPMX_International}</p>
                                                                </td>
                                                                <td>
                                                                    <p>{!v.DPMX_Resultado}</p>
                                                                </td>
                                                                <td>
                                                                    <p>{!v.DPMX_Rentabilidad}</p>
                                                                </td>
                                                                <td>
                                                                    <p>{!v.DPMX_BAI}</p>
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </tr>
                                                <tr>
                                                    <td class="backgound-gray">
                                                        <p class="Title">Resumen de información del último mes del cliente - {!v.DPMX_Date}</p>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="padding-bottom: 25px;"></td>
                                                </tr>
                                                <tr>
                                                    <table width="100%;" Style="border-collapse: collapse;">
                                                        <tbody>
                                                            <tr class="Headboard">
                                                                <td>
                                                                    <p class="HeadboardTitle">TPV extra</p>
                                                                </td>
                                                                <td>
                                                                    <p class="HeadboardTitle">Baja facturación</p>
                                                                </td>
                                                                <td>
                                                                    <p class="HeadboardTitle">Red celular</p>
                                                                </td>
                                                                <td>
                                                                    <p class="HeadboardTitle">Gastos totales</p>
                                                                </td>
                                                                <td>
                                                                    <p class="HeadboardTitle">Gastos MIT y eBIND</p>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <p>{!v.DPMX_extraBilling}</p>
                                                                </td>
                                                                <td>
                                                                    <p>{!v.DPMX_billing}</p>
                                                                </td>
                                                                <td>
                                                                    <p>{!v.DPMX_cellnet}</p>
                                                                </td>
                                                                <td>
                                                                    <p>{!v.DPMX_totalAmount}</p>
                                                                </td>
                                                                <td>
