<aura:component implements="force:lightningQuickActionWithoutHeader,force:hasRecordId" controller="DPMX_SendReportAction_ctrl" access="global">


    <aura:attribute name="templateName" type="String" default="DPMX_SendReport" />
    <aura:attribute name="templateBody" type="String" />
    <aura:attribute name="sectionLst" type="Object" />
    <aura:attribute name="checkCC" type="Boolean" default="true" />
    <aura:attribute name="sendCC" type="List" default="[]" />
    <aura:attribute name="dynamicPricing" type="Object" />
    <aura:attribute name="isTasaSelectd" type="Boolean" default="false" />
    <aura:attribute name="isCustom" type="Boolean" default="false" />
    <aura:attribute name="isSelectDisabled" type="Boolean" default="false" />
    <aura:attribute name="saludoTasa" type="String" />
    <aura:attribute name="introduccionTasa" type="String" />
    <aura:attribute name="closeTasa" type="String" />

    <aura:attribute name="debitTasa" type="String" />
    <aura:attribute name="creditTasa" type="String" />
    <aura:attribute name="internationalTasa" type="String" />

    <aura:attribute name="DPMX_Company_Name__c" type="String" />
    <aura:attribute name="DPMX_familia__c" type="String" />
    <aura:attribute name="DPMX_NumeroCliente__c" type="String" />
    <aura:attribute name="consultDate" type="String" />

    <aura:attribute name="DPMX_debit" type="String" />
    <aura:attribute name="DPMX_credit" type="String" />
    <aura:attribute name="DPMX_International" type="String" />
    <aura:attribute name="DPMX_Resultado" type="String" />
    <aura:attribute name="DPMX_Rentabilidad" type="String" />
    <aura:attribute name="DPMX_BAI" type="String" />

    <aura:attribute name="DPMX_Date" type="String" />

    <aura:attribute name="DPMX_monetaryCeiling" type="String" />
    <aura:attribute name="DPMX_extraBilling" type="String" />
    <aura:attribute name="DPMX_billing" type="String" />
    <aura:attribute name="DPMX_cellnet" type="String" />
    <aura:attribute name="DPMX_extraBillingRub" type="String" />
    <aura:attribute name="DPMX_billingRub" type="String" />
    <aura:attribute name="DPMX_cellnetRub" type="String" />
    <aura:attribute name="DPMX_totalAmount" type="String" />
    <aura:attribute name="DPMX_totalAmountSim" type="String" />
    <aura:attribute name="DPMX_mit" type="String" />

    <aura:attribute name="DPMX_transaction_y_debit_own" type="String" />
    <aura:attribute name="DPMX_billing_debit_own" type="String" />
    <aura:attribute name="DPMX_tickets_debit_own" type="String" />
    <aura:attribute name="DPMX_percentage_debit_own" type="String" />

    <aura:attribute name="DPMX_transaction_y_debit_thirdParty" type="String" />
    <aura:attribute name="DPMX_billing_debit_thirdParty" type="String" />
    <aura:attribute name="DPMX_tickets_debit_thirdParty" type="String" />
    <aura:attribute name="DPMX_percentage_debit_thirdParty" type="String" />

    <aura:attribute name="DPMX_transaction_y_credit_own" type="String" />
    <aura:attribute name="DPMX_billing_credit_own" type="String" />
    <aura:attribute name="DPMX_tickets_credit_own" type="String" />
    <aura:attribute name="DPMX_percentage_credit_own" type="String" />

    <aura:attribute name="DPMX_transaction_y_credit_thirdParty" type="String" />
    <aura:attribute name="DPMX_billing_credit_thirdParty" type="String" />
    <aura:attribute name="DPMX_tickets_credit_thirdParty" type="String" />
    <aura:attribute name="DPMX_percentage_credit_thirdParty" type="String" />

    <aura:attribute name="DPMX_transaction_y_international" type="String" />
    <aura:attribute name="DPMX_billing_international" type="String" />
    <aura:attribute name="DPMX_tickets_international" type="String" />
    <aura:attribute name="DPMX_percentage_international" type="String" />

    <aura:attribute name="DPMX_transaction_y_total" type="String" />
    <aura:attribute name="DPMX_billing_total" type="String" />
    <aura:attribute name="DPMX_tickets_total" type="String" />
    <aura:attribute name="DPMX_percentage_total" type="String" />

    <aura:attribute name="DPMX_terminal" type="String" />
    <aura:attribute name="DPMX_pinPads" type="String" />
    <aura:attribute name="DPMX_ecommerceCheckbox" type="String" />
    <aura:attribute name="DPMX_devicesNumber" type="String" />

    <aura:attribute name="DPMX_scenario" type="String" />

    <aura:attribute name="DPMX_debitPorpio" type="String" />
    <aura:attribute name="DPMX_creditPorpio" type="String" />
    <aura:attribute name="DPMX_interPorpio" type="String" />
    <aura:attribute name="DPMX_resultPorpio" type="String" />
    <aura:attribute name="DPMX_rentPorpio" type="String" />
    <aura:attribute name="DPMX_baiPorpio" type="String" />

    <aura:attribute name="DPMX_oppPosExtra" type="String" />
    <aura:attribute name="DPMX_oppCallnet" type="String" />
    <aura:attribute name="DPMX_oppLowBilling" type="String" />

    <aura:attribute name="DPMX_basisPoints" type="String" />

    <aura:attribute name="DPMX_interchangeRates_debit" type="String" />
    <aura:attribute name="DPMX_interchangeRates_credit" type="String" />
    <aura:attribute name="DPMX_interchangeRates_International" type="String" />

    <aura:attribute name="DPMX_discountRates_debit" type="String" />
    <aura:attribute name="DPMX_discountRates_credit" type="String" />
    <aura:attribute name="DPMX_discountRates_International" type="String" />

    <aura:attribute name="DPMX_DescuentoMaximo" type="String" />

    <aura:attribute name="DPMX_sel_debit" type="String" />
    <aura:attribute name="DPMX_sel_credit" type="String" />
    <aura:attribute name="DPMX_sel_International" type="String" />
    <aura:attribute name="DPMX_sel_Rent" type="String" />
    <aura:attribute name="DPMX_sel_Bai" type="String" />
    <aura:attribute name="DPMX_sel_Result" type="String" />

    <!--Atributos de padre-->
    <aura:attribute name="recordId" type="String" />
    <aura:attribute name="isSimulationTab" type="Boolean" />
    <aura:attribute name="isLastMonthTab" type="Boolean" />
    <aura:attribute name="sendConditionLst" type="List" default="[]" />
    <aura:attribute name="sendSimulationLst" type="List" default="[]" />

    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />

    <aura:html tag="style">
        .slds-modal__container{ height : 100%; max-height: 100rem; width: 100%; max-width: 100rem; } .modal-body{ height : 100px !important; max-height: 100px !important; } .customFooter{ display: inline !important; } .cuf-content { padding: 0 0rem !important;
        } .slds-p-around--medium { padding: 0rem !important; } .slds-modal__content{ overflow-y:hidden !important; height:unset !important; max-height:unset !important; }
    </aura:html>
    <div class="slds-modal__header">
        <aura:if isTrue="{!v.isTasaSelectd}">
            <h1 id="modal-heading-01" class="slds-modal__title slds-hyphenate">Enviar propuesta de tasa seleccionada</h1>
            <aura:set attribute="else">
                <h1 id="modal-heading-01" class="slds-modal__title slds-hyphenate">Enviar de reporte</h1>
            </aura:set>
        </aura:if>
    </div>
    <div class="slds-box slds-theme_default">
        <div class="slds-grid slds-gutters">
            <div class="slds-col slds-size_1-of-4">
                    <div>
                        <lightning:select disabled="{!v.isSelectDisabled}" name="SaveTemplate" aura:id="SaveTemplate" label="Tipo de correo: " required="true" value="Simulación" onchange="{!c.handleSaveTemplate}">
                            <option text="Simulación" value="Simulación" />    
                            <option text="Propuestas de tasas de descuento" value="Propuestas de tasas de descuento" />
                        </lightning:select>
                    </div>
                <div class="slds-form-element">
                    <lightning:textarea name="cc" aura:id="cc" value="" label="Especifique destinatario del correo: " onchange="{!c.checkCC}" messageWhenValueMissing="Este campo es obliatorio." />
                </div>
                <div class="slds-form-element">
                    <lightning:textarea name="asunto" aura:id="asunto" value="" label="Especifique asunto del correo: " messageWhenValueMissing="Este campo es obliatorio." />
                </div>
                <aura:if isTrue="{!v.isTasaSelectd}">
                    <div class="slds-form-element">
                        <lightning:textarea name="Saludo" aura:id="Saludo" value="Saludos," label="Saludo: " onchange="{!c.checkComment}" messageWhenValueMissing="Este campo es obliatorio." />
                    </div>
                    <div class="slds-form-element">
                        <lightning:textarea name="Introdución:" onchange="{!c.checkComment}" aura:id="Introdución" value="En seguimiento a la solicitud que hemos conversado en días recientes, adjunto la propuesta de condiciones para la operación de actualización de tasa de descuento, a fin de que puedas revisarla y comunicarme tu decisión."
                            label="Introdución: " />
                    </div>
                    <div class="slds-form-element">
                        <lightning:textarea name="Cierre" onchange="{!c.checkComment}" aura:id="Cierre" value="Si existiera alguna duda sobre estas condiciones o requieres más información, no dudes en contactarme." label="Cierre: " />
                    </div>
                </aura:if>
            </div>
            <div class="slds-col slds-size_3-of-4">
                <aura:if isTrue="{!v.isTasaSelectd}">
                    <div>
                        {!v.saludoTasa}
                    </div>
                    <div>
                        {!v.introduccionTasa}
                    </div>
                    <table width="100%;" Style="border-collapse: collapse;">
                        <tbody>
                            <tr class="Headboard">
                                <td>
                                    <p class="HeadboardTitlePadding-left">Débito</p>
                                </td>
                                <td>
                                    <p class="HeadboardTitle">Crédito</p>
                                </td>
                                <td>
                                    <p class="HeadboardTitle">Internacional</p>
                                </td>
                            </tr>
                            <tr class="trParent">
                                <td>
                                    <p class="padding-left">{!v.debitTasa}</p>
                                </td>
                                <td>
                                    <p>{!v.creditTasa}</p>
                                </td>
                                <td>
                                    <p>{!v.internationalTasa}</p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <div>
                        {!v.closeTasa}
                    </div>
                    <div>
                        Un saludo.
                    </div>
                    <aura:set attribute="else">
                        <aura:if isTrue="{!v.isCustom}">
                            <div class="slds-scrollable_y" style="height:100rem;width:70rem" tabindex="0">
                                <div class="headParent">
                                    <div class="headChild2">
                                        <aura:if isTrue="{!v.isCustom}">
                                            <div>Nombre del grupo: {!v.DPMX_Company_Name__c} </div>
                                        </aura:if>
                                        <div>Giro: {!v.DPMX_familia__c} </div>
                                        <aura:if isTrue="{!v.isCustom}">
                                            <div>Número del cliente: {!v.DPMX_NumeroCliente__c} </div>
                                        </aura:if>
                                        <div>Fecha: {!v.consultDate}</div>
                                    </div>
                                </div>
    
                                <body>
                                    <table width="100%;" Style="border-collapse: collapse;">
                                        <thead>
                                            <tr>
                                                <td Style="background-color: #004483; color:white;">
                                                    <p class="Title">Tasa seleccionada</p>
                                                </td>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td style="padding-bottom: 25px;"></td>
                                            </tr>
                                            <tr>
                                                <table width="100%;" Style="border-collapse: collapse;">
                                                    <tbody>
                                                        <tr class="Headboard">
                                                            <td>
                                                                <p class="HeadboardTitlePadding-left">Débito</p>
                                                            </td>
                                                            <td>
                                                                <p class="HeadboardTitle">Crédito</p>
                                                            </td>
                                                            <td>
                                                                <p class="HeadboardTitle">Internacional</p>
                                                            </td>
                                                            <td>
                                                                <p class="HeadboardTitle">Resultado</p>
                                                            </td>
                                                            <td>
                                                                <p class="HeadboardTitle">Rentabilidad</p>
                                                            </td>
                                                            <td>
                                                                <p class="HeadboardTitle">BAI</p>
                                                            </td>
                                                        </tr>
                                                        <tr class="trParent">
                                                            <td>
                                                                <p class="padding-left">{!v.DPMX_sel_debit}</p>
                                                            </td>
                                                            <td>
                                                                <p>{!v.DPMX_sel_credit}</p>
                                                            </td>
                                                            <td>
                                                                <p>{!v.DPMX_sel_International}</p>
                                                            </td>
                                                            <td>
                                                                <p>{!v.DPMX_sel_Result}</p>
                                                            </td>
                                                            <td>
                                                                <p>{!v.DPMX_sel_Rent}</p>
                                                            </td>
                                                            <td>
                                                                <p>{!v.DPMX_sel_Bai}</p>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </tr>
                                            <tr>
                                                <td class="backgound-gray">
                                                    <p class="Between tasa select and rest"></p>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <table width="100%;" Style="border-collapse: collapse;">
                                        <thead>
                                            <tr>
                                                <td Style="background-color: #004483; color:white;">
                                                    <aura:if isTrue="{!v.isCustom}">
                                                        <p class="Title">Tasas de descuento pactadas en la última negociación</p>
                                                        <aura:set attribute="else">
                                                            <p class="Title">Información simulada del cliente</p>
                                                        </aura:set>
                                                    </aura:if>
                                                </td>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <aura:if isTrue="{!v.isCustom}">
                                                <tr>
                                                    <td class="backgound-gray">
                                                        <p class="Title">Tasas descuento actuales</p>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="padding-bottom: 25px;"></td>
                                                </tr>
                                                <tr>
                                                    <table width="100%;" Style="border-collapse: collapse;">
                                                        <tbody>
                                                            <tr class="Headboard">
                                                                <td>
                                                                    <p class="HeadboardTitlePadding-left">Débito</p>
                                                                </td>
                                                                <td>
                                                                    <p class="HeadboardTitle">Crédito</p>
                                                                </td>
                                                                <td>
                                                                    <p class="HeadboardTitle">Internacional</p>
                                                                </td>
                                                                <td>
                                                                    <p class="HeadboardTitle">Resultado</p>
                                                                </td>
                                                                <td>
                                                                    <p class="HeadboardTitle">Rentabilidad</p>
                                                                </td>
                                                                <td>
                                                                    <p class="HeadboardTitle">BAI</p>
                                                                </td>
                                                            </tr>
                                                            <tr class="trParent">
                                                                <td>
                                                                    <p class="padding-left">{!v.DPMX_debit}</p>
                                                                </td>
                                                                <td>
                                                                    <p>{!v.DPMX_credit}</p>
                                                                </td>
                                                                <td>
                                                                    <p>{!v.DPMX_International}</p>
                                                                </td>
                                                                <td>
                                                                    <p>{!v.DPMX_Resultado}</p>
                                                                </td>
                                                                <td>
                                                                    <p>{!v.DPMX_Rentabilidad}</p>
                                                                </td>
                                                                <td>
                                                                    <p>{!v.DPMX_BAI}</p>
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </tr>
                                                <tr>
                                                    <td class="backgound-gray">
                                                        <p class="Title">Resumen de información del último mes del cliente - {!v.DPMX_Date}</p>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="padding-bottom: 25px;"></td>
                                                </tr>
                                                <tr>
                                                    <table width="100%;" Style="border-collapse: collapse;">
                                                        <tbody>
                                                            <tr class="Headboard">
                                                                <td>
                                                                    <p class="HeadboardTitle">TPV extra</p>
                                                                </td>
                                                                <td>
                                                                    <p class="HeadboardTitle">Baja facturación</p>
                                                                </td>
                                                                <td>
                                                                    <p class="HeadboardTitle">Red celular</p>
                                                                </td>
                                                                <td>
                                                                    <p class="HeadboardTitle">Gastos totales</p>
                                                                </td>
                                                                <td>
                                                                    <p class="HeadboardTitle">Gastos MIT y eBIND</p>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <p>{!v.DPMX_extraBilling}</p>
                                                                </td>
                                                                <td>
                                                                    <p>{!v.DPMX_billing}</p>
                                                                </td>
                                                                <td>
                                                                    <p>{!v.DPMX_cellnet}</p>
                                                                </td>
                                                                <td>
                                                                    <p>{!v.DPMX_totalAmount}</p>
                                                                </td>
                                                                <td>
                                                                    <p>{!v.DPMX_mit}</p>
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </tr>
                                                <tr>
                                                    <td class="backgound-gray">
                                                        <aura:if isTrue="{!v.isLastMonthTab}">
                                                            <p class="Title">Información de último mes de cliente</p>
                                                            <aura:set attribute="else">
                                                                <p class="Title">Información simulada del cliente</p>
                                                            </aura:set>
                                                        </aura:if>
                                                    </td>
                                                </tr>
                                            </aura:if>
                                            <tr>
                                                <td style="padding-bottom: 25px;"></td>
                                            </tr>
                                            <tr>
                                                <table width="100%;" Style="border-collapse: collapse;">
                                                    <tbody>
                                                        <tr Style="background-color: #eeeeee;">
                                                            <td>
                                                                <p class="HeadboardTitlePadding-left">Producto</p>
                                                            </td>
                                                            <td>
                                                                <p class="HeadboardTitle"># Transacciones</p>
                                                            </td>
                                                            <td>
                                                                <p class="HeadboardTitle">Facturación mensual</p>
                                                            </td>
                                                            <td>
                                                                <p class="HeadboardTitle">Ticket promedio</p>
                                                            </td>
                                                            <td>
                                                                <p class="HeadboardTitle">% Mix</p>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td>
                                                                <p class="padding-left">Débito</p>
                                                            </td>
                                                            <td>
                                                                <p>{!v.DPMX_transaction_y_debit_own}</p>
                                                            </td>
                                                            <td>
                                                                <p>{!v.DPMX_billing_debit_own}</p>
                                                            </td>
                                                            <td>
                                                                <p>{!v.DPMX_tickets_debit_own}</p>
                                                            </td>
                                                            <td>
                                                                <p>{!v.DPMX_percentage_debit_own}</p>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td>
                                                                <p class="padding-left">Crédito</p>
                                                            </td>
                                                            <td>
                                                                <p>{!v.DPMX_transaction_y_credit_own}</p>
                                                            </td>
                                                            <td>
                                                                <p>{!v.DPMX_billing_credit_own}</p>
                                                            </td>
                                                            <td>
                                                                <p>{!v.DPMX_tickets_credit_own}</p>
                                                            </td>
                                                            <td>
                                                                <p>{!v.DPMX_percentage_credit_own}</p>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td>
                                                                <p class="padding-left">Internacional</p>
                                                            </td>
                                                            <td>
                                                                <p>{!v.DPMX_transaction_y_international}</p>
                                                            </td>
                                                            <td>
                                                                <p>{!v.DPMX_billing_international}</p>
                                                            </td>
                                                            <td>
                                                                <p>{!v.DPMX_tickets_international}</p>
                                                            </td>
                                                            <td>
                                                                <p>{!v.DPMX_percentage_international}</p>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td>
                                                                <p class="padding-left">Total</p>
                                                            </td>
                                                            <td>
                                                                <p>{!v.DPMX_transaction_y_total}</p>
                                                            </td>
                                                            <td>
                                                                <p>{!v.DPMX_billing_total}</p>
                                                            </td>
                                                            <td>
                                                                <p>{!v.DPMX_tickets_total}</p>
                                                            </td>
                                                            <td>
                                                                <p>{!v.DPMX_percentage_total}</p>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </tr>
                                            <tr>
                                                <td class="backgound-gray">
                                                    <p class="Title">Dispositivos simulados</p>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="padding-bottom: 25px;"></td>
                                            </tr>
                                            <tr>
                                                <table width="100%;" Style="border-collapse: collapse;">
                                                    <tbody>
                                                        <tr Style="background-color: #eeeeee;">
                                                            <td>
                                                                <p class="HeadboardTitlePadding-left">Dispositivo</p>
                                                            </td>
                                                            <td>
                                                                <p class="HeadboardTitle">No. Dispositivos</p>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td>
                                                                <p class="padding-left">Terminal Punto de Venta</p>
                                                            </td>
                                                            <td>
                                                                <p>{!v.DPMX_terminal}</p>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td>
                                                                <p class="padding-left">Interredes con pinpad</p>
                                                            </td>
                                                            <td>
                                                                <p>{!v.DPMX_pinPads}</p>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td>
                                                                <p class="padding-left">Ecommerce</p>
                                                            </td>
                                                            <td>
                                                                <p>{!v.DPMX_ecommerceCheckbox}</p>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td>
                                                                <p class="padding-left">Total</p>
                                                            </td>
                                                            <td>
                                                                <p>{!v.DPMX_devicesNumber}</p>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </tr>
                                            <tr>
                                                <td class="backgound-gray">
                                                    <p class="Title">Comisiones simuladas</p>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="padding-bottom: 25px;"></td>
                                            </tr>
                                            <tr>
                                                <table width="100%;" Style="border-collapse: collapse;">
                                                    <tbody>
                                                        <tr Style="background-color: #eeeeee;">
                                                            <td>
                                                                <p class="HeadboardTitlePadding-left">Rubro</p>
                                                            </td>
                                                            <td>
                                                                <p class="HeadboardTitle">Monto</p>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td>
                                                                <p class="padding-left">Cobro por baja facturación</p>
                                                            </td>
                                                            <td>
                                                                <p>{!v.DPMX_extraBillingRub}</p>
                                                            </td>
                                                        </tr>
