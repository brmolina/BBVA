                                                                    </td>
                                                                    <td>
                                                                        <p class="HeadboardTitle">BAI</p>
                                                                    </td>
                                                                </tr>
                                                                <tr>
                                                                    <td>
                                                                        <p class="padding-left">{!scenario.debit}</p>
                                                                    </td>
                                                                    <td>
                                                                        <p>{!scenario.credit}</p>
                                                                    </td>
                                                                    <td>
                                                                        <p>{!scenario.inter}</p>
                                                                    </td>
                                                                    <td>
                                                                        <p>{!scenario.result}</p>
                                                                    </td>
                                                                    <td>
                                                                        <p>{!scenario.rent}</p>
                                                                    </td>
                                                                    <td>
                                                                        <p>{!scenario.bai}</p>
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </aura:iteration>
                                                    </table>
                                                </tr>
                                                <tr>
                                                    <td class="backgound-gray">
                                                        <p class="Title">Tasa personalizada</p>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="padding-bottom: 25px;"></td>
                                                </tr>
                                                <tr>
                                                    <table width="100%;" Style="border-collapse: collapse;">
                                                        <tbody>
                                                            <tr Style="background-color: #eeeeee;">
                                                                <td>
                                                                    <p class="HeadboardTitlePadding-left">Débito</p>
                                                                </td>
                                                                <td>
                                                                    <p class="HeadboardTitle">Crédito</p>
                                                                </td>
                                                                <td>
                                                                    <p class="HeadboardTitle">Internacional</p>
                                                                </td>
                                                                <td>
                                                                    <p class="HeadboardTitle">Resultado</p>
                                                                </td>
                                                                <td>
                                                                    <p class="HeadboardTitle">Rentabilidad</p>
                                                                </td>
                                                                <td>
                                                                    <p class="HeadboardTitle">BAI</p>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <p class="padding-left">{!v.DPMX_debitPorpio}</p>
                                                                </td>
                                                                <td>
                                                                    <p>{!v.DPMX_creditPorpio}</p>
                                                                </td>
                                                                <td>
                                                                    <p>{!v.DPMX_interPorpio}</p>
                                                                </td>
                                                                <td>
                                                                    <p>{!v.DPMX_resultPorpio}</p>
                                                                </td>
                                                                <td>
                                                                    <p>{!v.DPMX_rentPorpio}</p>
                                                                </td>
                                                                <td>
                                                                    <p>{!v.DPMX_baiPorpio}</p>
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </tr>
                                                <tr>
                                                    <td class="backgound-gray">
                                                        <p class="Title">Oportunidades</p>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="padding-bottom: 25px;"></td>
                                                </tr>
                                                    <tr>
                                                        <table width="100%;" Style="border-collapse: collapse;">
                                                            <tbody>
                                                                <tr Style="background-color: #eeeeee;">
                                                                    <td>
                                                                        <p class="HeadboardTitlePadding-left">Rubro</p>
                                                                    </td>
                                                                    <td>
                                                                        <p class="HeadboardTitle">Monto</p>
                                                                    </td>
                                                                </tr>
                                                                <tr>
                                                                    <td>
                                                                        <p class="padding-left">Cobro por baja facturación</p>
                                                                    </td>
                                                                    <td>
                                                                        <p>{!v.DPMX_oppPosExtra}</p>
                                                                    </td>
                                                                </tr>
                                                                <tr>
                                                                    <td>
                                                                        <p class="padding-left">Cobro por cada TPV extra</p>
                                                                    </td>
                                                                    <td>
                                                                        <p>{!v.DPMX_oppCallnet}</p>
                                                                    </td>
                                                                </tr>
                                                                <tr>
                                                                    <td>
                                                                        <p class="padding-left">Cobro de red celular</p>
                                                                    </td>
                                                                    <td>
                                                                        <p>{!v.DPMX_oppLowBilling}</p>
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </tr>
                                            </tbody>
                                        </table>
                                        <table width="100%;" Style="border-collapse: collapse;">
                                            <thead>
                                                <tr>
                                                    <td Style="background-color: #004483; color:white;">
                                                        <p class="Title">Referencias</p>
                                                    </td>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td class="backgound-gray">
                                                        <p class="Title">Gastos</p>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="padding-bottom: 25px;"></td>
                                                </tr>
                                                <tr>
                                                    <table width="100%;" Style="border-collapse: collapse;">
                                                        <tbody>
                                                            <tr Style="background-color: #eeeeee;">
                                                                <td>
                                                                    <p class="HeadboardTitlePadding-left">Gastos totales</p>
                                                                </td>
                                                                <aura:if isTrue="{!v.isCustom}">
                                                                    <td>
                                                                        <p class="HeadboardTitle">Gastos MID y eBIND</p>
                                                                    </td>
                                                                </aura:if>
                                                                <td>
                                                                    <p class="HeadboardTitle">Basis points</p>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <p class="padding-left">{!v.DPMX_totalAmountSim}</p>
                                                                </td>
                                                                <aura:if isTrue="{!v.isCustom}">
                                                                    <td>
                                                                        <p>{!v.DPMX_mit}</p>
                                                                    </td>
                                                                </aura:if>
                                                                <td>
                                                                    <p>{!v.DPMX_basisPoints}</p>
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </tr>
                                                <tr>
                                                    <td style="padding-bottom: 25px;"></td>
                                                </tr>
                                                <aura:if isTrue="{!v.isCustom}">
                                                    <tr>
                                                        <td class="backgound-gray">
                                                            <p style="font-weight: bold;">Información referente al giro</p>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td style="padding-bottom: 25px;"></td>
                                                    </tr>
                                                    <tr>
                                                        <table width="100%;" Style="border-collapse: collapse;">
                                                            <tbody>
                                                                <tr Style="background-color: #eeeeee;">
                                                                    <td>
                                                                        <p class="HeadboardTitlePadding-left">Débito</p>
                                                                    </td>
                                                                    <td>
                                                                        <p class="HeadboardTitle">Crédito</p>
                                                                    </td>
                                                                    <td>
                                                                        <p class="HeadboardTitle">Internacional</p>
                                                                    </td>
                                                                    <td>
                                                                        <p class="HeadboardTitle">Tipo</p>
                                                                    </td>
                                                                </tr>
                                                                <tr>
                                                                    <td>
                                                                        <p class="padding-left">{!v.DPMX_interchangeRates_debit}</p>
                                                                    </td>
                                                                    <td>
                                                                        <p>{!v.DPMX_interchangeRates_credit}</p>
                                                                    </td>
                                                                    <td>
                                                                        <p>{!v.DPMX_interchangeRates_International}</p>
                                                                    </td>
                                                                    <td>
                                                                        <p>Intercambio</p>
                                                                    </td>
                                                                </tr>
                                                                <tr Style="background-color: #eeeeee;">
                                                                    <td>
                                                                        <p class="HeadboardTitlePadding-left">Débito</p>
                                                                    </td>
                                                                    <td>
                                                                        <p class="HeadboardTitle">Crédito</p>
                                                                    </td>
                                                                    <td>
                                                                        <p class="HeadboardTitle">Internacional</p>
                                                                    </td>
                                                                    <td>
                                                                        <p class="HeadboardTitle">Tipo</p>
                                                                    </td>
                                                                </tr>
                                                                <tr>
                                                                    <td>
                                                                        <p class="padding-left">{!v.DPMX_discountRates_debit}</p>
                                                                    </td>
                                                                    <td>
                                                                        <p>{!v.DPMX_discountRates_credit}</p>
                                                                    </td>
                                                                    <td>
                                                                        <p>{!v.DPMX_discountRates_International}</p>
                                                                    </td>
                                                                    <td>
                                                                        <p>Tasas máximas de descuento</p>
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </tr>
                                                </aura:if>
                                            </tbody>
                                        </table>
                                    </body>
                                </div>
                            </aura:set>
                        </aura:if>
                    </aura:set>
                </aura:if>
            </div>
        </div>
    </div>
    <div class="slds-modal__footer">
        <lightning:button name="{!v.closebutton}" label="Cancelar" onclick="{!c.handleClose}" />
        <button class="slds-button slds-button_brand" name="{!v.savebutton}" label="Aceptar" onclick="{!c.handleSave}">Aceptar</button>
    </div>

</aura:component>