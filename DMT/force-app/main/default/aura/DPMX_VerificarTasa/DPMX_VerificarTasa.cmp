                                                                </td>
                                                                <td>
                                                                    <p class="HeadboardTitle">Internacional</p>
                                                                </td>
                                                                <td>
                                                                    <p class="HeadboardTitle">Resultado</p>
                                                                </td>
                                                                <td>
                                                                    <p class="HeadboardTitle">Rentabilidad</p>
                                                                </td>
                                                                <td>
                                                                    <p class="HeadboardTitle">BAI</p>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <p class="padding-left">{!scenario.debit}</p>
                                                                </td>
                                                                <td>
                                                                    <p>{!scenario.credit}</p>
                                                                </td>
                                                                <td>
                                                                    <p>{!scenario.inter}</p>
                                                                </td>
                                                                <td>
                                                                    <p>{!scenario.result}</p>
                                                                </td>
                                                                <td>
                                                                    <p>{!scenario.rent}</p>
                                                                </td>
                                                                <td>
                                                                    <p>{!scenario.bai}</p>
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </aura:iteration>
                                                </table>
                                            </tr>
                                            <tr>
                                                <td class="backgound-gray">
                                                    <p class="Title">Tasa personalizada</p>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="padding-bottom: 25px;"></td>
                                            </tr>
                                            <tr>
                                                <table width="100%;" Style="border-collapse: collapse;">
                                                    <tbody>
                                                        <tr Style="background-color: #eeeeee;">
                                                            <td>
                                                                <p class="HeadboardTitlePadding-left">Débito</p>
                                                            </td>
                                                            <td>
                                                                <p class="HeadboardTitle">Crédito</p>
                                                            </td>
                                                            <td>
                                                                <p class="HeadboardTitle">Internacional</p>
                                                            </td>
                                                            <td>
                                                                <p class="HeadboardTitle">Resultado</p>
                                                            </td>
                                                            <td>
                                                                <p class="HeadboardTitle">Rentabilidad</p>
                                                            </td>
                                                            <td>
