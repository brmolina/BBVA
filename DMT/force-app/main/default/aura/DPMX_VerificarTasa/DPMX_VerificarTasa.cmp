                                                <td style="padding-bottom: 25px;"></td>
                                            </tr>
                                            <tr>
                                                <table width="100%;" Style="border-collapse: collapse;">
                                                    <tbody>
                                                        <tr Style="background-color: #eeeeee;">
                                                            <td>
                                                                <p class="HeadboardTitlePadding-left">Débito</p>
                                                            </td>
                                                            <td>
                                                                <p class="HeadboardTitle">Crédito</p>
                                                            </td>
                                                            <td>
                                                                <p class="HeadboardTitle">Internacional</p>
                                                            </td>
                                                            <td>
                                                                <p class="HeadboardTitle">Tipo</p>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td>
                                                                <p class="padding-left">{!v.DPMX_interchangeRates_debit}</p>
                                                            </td>
                                                            <td>
                                                                <p>{!v.DPMX_interchangeRates_credit}</p>
                                                            </td>
                                                            <td>
                                                                <p>{!v.DPMX_interchangeRates_International}</p>
                                                            </td>
                                                            <td>
                                                                <p>Intercambio</p>
                                                            </td>
                                                        </tr>
                                                        <tr Style="background-color: #eeeeee;">
                                                            <td>
                                                                <p class="HeadboardTitlePadding-left">Débito</p>
                                                            </td>
                                                            <td>
                                                                <p class="HeadboardTitle">Crédito</p>
                                                            </td>
                                                            <td>
                                                                <p class="HeadboardTitle">Internacional</p>
                                                            </td>
                                                            <td>
                                                                <p class="HeadboardTitle">Tipo</p>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td>
                                                                <p class="padding-left">{!v.DPMX_discountRates_debit}</p>
                                                            </td>
                                                            <td>
                                                                <p>{!v.DPMX_discountRates_credit}</p>
                                                            </td>
                                                            <td>
                                                                <p>{!v.DPMX_discountRates_International}</p>
                                                            </td>
                                                            <td>
                                                                <p>Tasas máximas de descuento</p>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </tr>
                                        </tbody>
                                    </table>
                                </body>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="slds-modal__footer">
                <lightning:button name="{!v.closebutton}" label="Cancelar" onclick="{!c.handleClose}" />
                <button class="slds-button slds-button_brand" name="{!v.savebutton}" label="Aceptar" disabled="{!v.disableButtons}" onclick="{!c.handleSave}">Aceptar</button>
            </div>
        </div>
    </section>
</aura:component>