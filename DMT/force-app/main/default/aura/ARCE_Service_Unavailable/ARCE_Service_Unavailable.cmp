<aura:component implements="force:lightningQuickActionWithoutHeader">

    <aura:attribute name="visible" type="Boolean" default="false" />
    <aura:attribute name="contents" type="String" />

   

        <div class="slds-notify_container slds-is-relative slds-m-bottom_small">
            <div class="slds-notify slds-notify_toast slds-theme_warning" role="status">
                <span class="slds-icon_container slds-icon-utility-warning slds-m-right_small slds-no-flex slds-align-top">
                    <lightning:icon iconName="utility:warning" size="large" variant="inverse" />
                </span>
                <div class="slds-notify__content">
                    <h2 class="slds-text-heading_small">
                        The system is currently under maintenance, please check again in a few minutes
                    </h2>
                </div>
            </div>
        </div>


</aura:component>