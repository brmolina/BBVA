                                <table class="slds-table slds-table_cell-buffer slds-table_bordered">
                                    <thead>
                                        <tr class="slds-line-height_reset">
                                            <th scope="col">
                                                <div class="slds-truncate">{!$Label.c.DPMX_InformationDetail_Devices_Column3}</div>
                                            </th>
                                            <th scope="col">
                                                <div class="slds-truncate">{!$Label.c.DPMX_InformationDetail_Devices_Column4}</div>
