<aura:component implements="flexipage:availableForAllPageTypes,force:hasRecordId" access="global" controller="DPMX_Container_Ctrl">
    <aura:attribute name="waiting" type="Boolean" default="false" />
    <aura:attribute name="recordId" type="String" />
    <aura:attribute name="acquirerActivitiesWrapper" type="Object" />
    <aura:attribute name="acquirerFeesWrapper" type="Object" />
    <aura:attribute name="acquirerCategoriesWrapper" type="Object" />
    <aura:attribute name="interchangeRates" type="Object" />
    <aura:attribute name="discountRates" type="Object" />
    <aura:attribute name="discountWrapper" type="Object" />
    <aura:attribute name="companyComparisonList" type="List" default="[]" />
    <aura:attribute name="DiscoruntDebitIsAmount" type="Boolean" default="false" />
    <aura:attribute name="isCustom" type="Boolean" default="false" />
    <aura:attribute name="isODTcheck" type="Boolean" default="true" />
    <aura:attribute name="TAMAccepted__c" type="Boolean" default="false" />
    <aura:attribute name="updDebit" type="Decimal" />
    <aura:attribute name="updDebitSimulation" type="Decimal" />
    <aura:attribute name="sectionLst" type="Object" />
    <aura:attribute name="index" type="Decimal" />
    <aura:attribute name="indexSimulation" type="Decimal" />
    <aura:attribute name="infoContent" type="String" default=""/>

    <aura:attribute name="percent" type="String" default="%" />

    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />

    <aura:attribute name="customerId" type="String" />
    <aura:attribute name="isGs" type="Boolean" default="false" />
    <aura:attribute name="accountsSelected" type="String" />
    <aura:attribute name="action" type="String" />
    <aura:attribute name="hasHeader" type="boolean" default="false" />
    <aura:attribute name="dynamicPricing" type="Object" />
    <aura:attribute name="dynamicPricingUpsert" type="Object" />
    <aura:attribute name="checkboxesWrapper" type="Object" />
    <aura:attribute name="resultRates" type="String" default="---" />
    <aura:attribute name="credit" type="Decimal" />
    <aura:attribute name="debit" type="Decimal" />
    <aura:attribute name="international" type="Decimal" />
    <aura:attribute name="profitability" type="Decimal" />
    <aura:attribute name="profitAmount" type="Decimal" />

    <aura:attribute name="lstScenearios" type="Object" />
    <aura:attribute name="lstSceneariosSim" type="Object" />

    <aura:attribute name="PrctMixOwn" type="Decimal" />
    <aura:attribute name="PrctMixExt" type="Decimal" />
    <aura:attribute name="PrctCrMixOwn" type="Decimal" />
    <aura:attribute name="PrctCrMixExt" type="Decimal" />
    <aura:attribute name="PrctIntMix" type="Decimal" />
    <aura:attribute name="PrctTotalMix" type="Decimal" />

    <aura:attribute name="PrctDebOwn" type="Decimal" />
    <aura:attribute name="PrctDebExt" type="Decimal" />
    <aura:attribute name="PrctCredOwn" type="Decimal" />
    <aura:attribute name="PrctCredExt" type="Decimal" />
    <aura:attribute name="PrctInt" type="Decimal" />
    <aura:attribute name="PrctTotal" type="Decimal" />

    <aura:attribute name="resultRatesSimulation" type="String" default="---" />
    <aura:attribute name="debitSimulation" type="Decimal" />
    <aura:attribute name="creditSimulation" type="Decimal" />
    <aura:attribute name="internationalSimulation" type="Decimal" />
    <aura:attribute name="profitabilitySimulation" type="Decimal" />
    <aura:attribute name="profitAmountSimulation" type="Decimal" />

    <aura:attribute name="editDebitbool" type="Boolean" default="true" />
    <aura:attribute name="editCreditbool" type="Boolean" default="true" />
    <aura:attribute name="editInternationalbool" type="Boolean" default="true" />
    <aura:attribute name="sendConditionLst" type="List" default="[]" />
    <aura:attribute name="sendConditionPositionDcm" type="Decimal" />
    <aura:attribute name="disableSubmitBtn" type="Boolean" default="false" />
    <aura:attribute name="disableAuthBtn" type="Boolean" default="false" />
    <aura:attribute name="disableSaveEditBtn" type="Boolean" default="false" />
    <aura:attribute name="disableSaveEditSimBtn" type="Boolean" default="false" />

    <aura:attribute name="editDebitSimulationbool" type="Boolean" default="true" />
    <aura:attribute name="editCreditSimulationbool" type="Boolean" default="true" />
    <aura:attribute name="editInternationalSimulationbool" type="Boolean" default="true" />
    <aura:attribute name="disableUpdateBtn" type="Boolean" default="true" />
    <aura:attribute name="disableUpdateSimulationBtn" type="Boolean" default="true" />
    <aura:attribute name="simulationWrapper" type="Object" />
    <aura:attribute name="sendSimulationLst" type="List" default="[]" />
    <aura:attribute name="disableSubmitSimulationBtn" type="Boolean" default="false" />
    <aura:attribute name="disableAuthSimulationBtn" type="Boolean" default="false" />
    <aura:attribute name="simulationBool" type="Boolean" default="false" />
    <aura:attribute name="commisionTPV" type="String" />
    <aura:attribute name="commisionRedCelular" type="Decimal" />
    <aura:attribute name="commisionBajaFact" type="Decimal" />
    <aura:attribute name="commisionTPVOpp" type="String" />
    <aura:attribute name="commisionRedCelularOpp" type="Decimal" />
    <aura:attribute name="commisionBajaFactOpp" type="Decimal" />

    <aura:attribute name="mostrarAuth" type="Boolean" default="false" />
    <aura:attribute name="authList" type="List" default="[]" />

    <aura:attribute name="historalTasasBol" type="Boolean" default="false" />
    <aura:attribute name="validateresponseWraper" type="Object" />
    <aura:attribute name="rates" type="Object" />

    <aura:attribute name="gastoTotal" type="String" default="0" />
    <aura:attribute name="gastMit" type="String" default="0" />
    <aura:attribute name="basisPoint" type="String" default="0" />
    <aura:attribute name="commisionRedCel" type="String" />
    <aura:attribute name="commisionBajFac" type="String" />
    <aura:attribute name="razonSocialLst" type="List" default="[]" />
    <aura:attribute name="razonSocialMp" type="Map" />
    <aura:attribute name="existingSubs" type="Object" />
    <aura:attribute name="valueDefault" type="String" default="Selecione Familia" />

    <aura:attribute name="isSimulationTab" type="Boolean" default="true" />
    <aura:attribute name="isLastMonthTab" type="Boolean" default="false" />

    <aura:attribute name="pageKey" type="Decimal" default="1" />
    <aura:attribute name="getStatus" type="Object" />

    <aura:attribute name="formalizeAcceptedCheck" type="Boolean" default="false" />
    <aura:attribute name="deniedFormalizeCheck" type="Boolean" default="false" />
    <aura:attribute name="deniedAuthorizeCheck" type="Boolean" default="false" />

    <aura:attribute name="deniedFormalizeSimCheck" type="Boolean" default="false" />
    <aura:attribute name="deniedAuthorizeSimCheck" type="Boolean" default="false" />

    <aura:attribute name="isBreakEvenOutOfLimits" type="Boolean" default="false" />

    <aura:attribute name="isfirstTime" type="Boolean" default="true" />

    <aura:attribute name="isTasaSelect" type="Boolean" default="false" />

    <aura:registerEvent name="DPMX_SimulatorRefresh_evt" type="c.DPMX_SimulatorRefresh_evt" />
    <aura:handler event="c:DPMX_SimulatorRefresh_evt" action="{!c.doInit}" />

    <div class="slds-grid slds-wrap">
        <aura:if isTrue="{!v.waiting}">
            <lightning:spinner variant="brand" />
        </aura:if>
        <div class="slds-box slds-m-vertical_x-small">
            <aura:if isTrue="{!v.isCustom}">
                <div class="slds-m-right_small slds-p-vertical_xx-small">
                    <div class="slds-col">
                        <table class="slds-table slds-table--col-bordered roundtable slds-m-right_small">
                            <td>
                                <th scope="col">
                                    <div>
                                        <div class="slds-text-heading--medium slds-p-bottom_xxx-small">
                                            <lightning:select name="existingSubs" aura:id="existingSubs" label="Familia" required="true" value="{!v.valueDefault}" onchange="{!c.handleSaveFamily}">
                                                <aura:iteration items="{!v.razonSocialLst}" var="razonSocial">
                                                    <option text="{!razonSocial}" value="{!razonSocial}" />
                                                </aura:iteration>
                                            </lightning:select>
                                        </div>
                                    </div>
                                </th>
                            </td>
                        </table>
                    </div>
                </div>
                <aura:set attribute="else">
                    <strong>{!$Label.c.DPMX_ActualDiscountRates_Title}</strong>
                </aura:set>
            </aura:if>
            <aura:if isTrue="{!v.isCustom}">
                <aura:set attribute="else">
                    <div class="slds-grid slds-m-top_medium slds-m-bottom_medium">
                        <div class="slds-m-right_small slds-p-vertical_xx-small">
                            <div class="slds-col">
                                <table class="slds-table slds-table--col-bordered roundtable slds-m-right_small">
                                    <td>
                                        <th scope="col">
                                            <div>
                                                <div>
                                                    <div class="slds-truncate">{!$Label.c.DPMX_Family}</div>
                                                </div>
                                                <div class="slds-text-heading--medium slds-p-bottom_xxx-small">
                                                    <strong>
                                                        <c:DPMX_DynamicTableField fieldType="STRING" fieldValue="{!v.acquirerActivitiesWrapper.businessInformation.familyAcquirer}"/>
                                                    </strong>
                                                </div>
                                            </div>
                                        </th>
                                    </td>
                                </table>
                            </div>
                        </div>
                        <div class="slds-m-left_medium slds-m-right_small slds-p-vertical_xx-small">
                            <div class="slds-col">
                                <table class="slds-table slds-table--col-bordered roundtable">
                                    <td>
                                        <th scope="col">
                                            <div>
                                                <div>
                                                    <div class="slds-truncate">{!$Label.c.DPMX_Debit}</div>
                                                </div>
                                                <div class="slds-text-heading--medium">
                                                    <strong>
                                                        <aura:if isTrue="{!v.DiscoruntDebitIsAmount}">
                                                            <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!v.acquirerActivitiesWrapper.discount.debit.itemizeType.amount}" currencyText="{!v.acquirerActivitiesWrapper.billing.debit.thirdParty.currency_y}" />
                                                            <aura:set attribute="else">
                                                                <c:DPMX_DynamicTableField fieldType="PERCENT" fieldValue="{!v.acquirerActivitiesWrapper.discount.debit.itemizeType.value}"/>
                                                            </aura:set>
                                                        </aura:if>
                                                    </strong>
                                                </div>
                                            </div>
                                        </th>
                                    </td>
                                    <td>
                                        <th scope="col">
                                            <div>
                                                <div>
                                                    <div class="slds-truncate">{!$Label.c.DPMX_Credit}</div>
                                                </div>
                                                <div class="slds-text-heading--medium">
                                                    <strong>
                                                        <c:DPMX_DynamicTableField fieldType="PERCENT" fieldValue="{!v.acquirerActivitiesWrapper.discount.percentage.credit}"/>
                                                    </strong>
                                                </div>
                                            </div>
                                        </th>
                                    </td>
                                    <td>
                                        <th scope="col">
                                            <div>
                                                <div>
                                                    <div class="slds-truncate">{!$Label.c.DPMX_International}</div>
                                                </div>
                                                <div class="slds-text-heading--medium">
                                                    <strong>
                                                        <c:DPMX_DynamicTableField fieldType="PERCENT" fieldValue="{!v.acquirerActivitiesWrapper.discount.percentage.international}"/>
                                                    </strong>
                                                </div>
                                            </div>
                                        </th>
                                    </td>
                                    <td class="color">
                                        <th scope="col">
                                            <div>
                                                <div class="slds-truncate">{!$Label.c.DPMX_Result}</div>
                                                <aura:if isTrue="{!v.acquirerActivitiesWrapper.yieldPercentage > 0}">
                                                    <div class="slds-grid slds-text-heading--medium">
                                                        <div>
                                                            <lightning:icon size='small' iconName="utility:check" variant="approve"></lightning:icon>
                                                        </div>
                                                        <div>
                                                            <strong>
                                                            <c:DPMX_DynamicTableField fieldType="STRING" fieldValue="{!$Label.c.DPMX_Profitable}"/>
                                                        </strong>
                                                        </div>
                                                    </div>
                                                    <aura:set attribute="else">
                                                        <div class="slds-grid slds-text-heading--medium">
                                                            <div>
                                                                <lightning:icon size='small' iconName="utility:error" variant="error"></lightning:icon>
                                                            </div>
                                                            <div>
                                                                <strong>
                                                                <c:DPMX_DynamicTableField fieldType="STRING" fieldValue="{!$Label.c.DPMX_NoProfitable}"/>
                                                            </strong>
                                                            </div>
                                                        </div>
                                                    </aura:set>
                                                </aura:if>
                                            </div>
                                        </th>
                                    </td>
                                </table>
                            </div>
                        </div>
                        <div class="slds-m-left_medium slds-m-right_small slds-p-vertical_xx-small">
                            <div class="slds-col">
                                <table class="slds-table slds-table--col-bordered roundtable">
                                    <td>
                                        <th scope="col">
                                            <div>
                                                <div>
                                                    <lightning:layout>
                                                        <lightning:layoutItem size="12" class="slds-p-around_small">
                                                            <div class="slds-truncate" title="{!$Label.c.DPMX_ActualDiscountRates_Field1}">{!$Label.c.DPMX_ActualDiscountRates_Field1} &nbsp;
                                                                    <lightning:helptext icon-name="utility:info_alt" content="Es el resultado de la facturación mensual multiplicada por la tasa de descuento." class="customIcon" id="IngresoBrutoToolTip" />
                                                            </div>
                                                        </lightning:layoutItem>
                                                    </lightning:layout>
                                                </div>
                                                <div class="slds-text-heading--medium slds-p-bottom_xxx-small">
                                                    <strong>
                                                        <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!v.acquirerActivitiesWrapper.discount.totalAmount.amount}" currencyText="{!v.acquirerActivitiesWrapper.discount.totalAmount.currency_y}"/>
                                                    </strong>
                                                </div>
                                            </div>
                                        </th>
                                    </td>
                                </table>
                            </div>
                        </div>
                        <div class="slds-m-left_medium slds-p-vertical_xx-small">
                            <div class="slds-col">
                                <table class="slds-table slds-table--col-bordered roundtable">
                                    <td>
                                        <th scope="col">
                                            <div>
                                                <div>
                                                    <lightning:layout>
                                                        <lightning:layoutItem size="12" class="slds-p-around_small">
                                                            <div class="slds-truncate" title="{!$Label.c.DPMX_ActualDiscountRates_Field2}">{!$Label.c.DPMX_ActualDiscountRates_Field2} &nbsp;
                                                                    <lightning:helptext icon-name="utility:info_alt" content="Es el resultado del descuento total más las comisiones, menos los gastos totales." class="customIcon" id="IngresoBrutoToolTip" />
                                                            </div>
                                                        </lightning:layoutItem>
                                                    </lightning:layout>
                                                </div>
                                                <div class="slds-text-heading--medium slds-p-bottom_xxx-small">
                                                    <strong>
                                                        <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!v.acquirerActivitiesWrapper.taxAcquirer.amount}" currencyText="{!v.acquirerActivitiesWrapper.taxAcquirer.currency_y}"/>
                                                    </strong>
                                                </div>
                                            </div>
                                        </th>
                                    </td>
                                    <td class="color">
                                        <th scope="col">
                                            <div>
                                                <div>
                                                    <div class="slds-truncate">{!$Label.c.DPMX_Profitability}</div>
                                                </div>
                                                <div class="slds-text-heading--medium">
                                                    <strong>
                                                        <c:DPMX_DynamicTableField fieldType="PERCENT" fieldValue="{!v.acquirerActivitiesWrapper.yieldPercentage}"/>
                                                    </strong>
                                                </div>
                                            </div>
                                        </th>
                                    </td>
                                </table>
                            </div>
                        </div>
                    </div>
                </aura:set>
            </aura:if>
        </div>
        <lightning:tabset>
            <aura:if isTrue="{!v.isCustom}">
                <div class="slds-grid slds-m-vertical_medium slds-p-right_medium">
                    <div class="slds-box slds-size_2-of-4 slds-m-right_xx-small">
                        <div class="slds-m-top_small slds-m-bottom_large slds-text-heading_small">
                            <lightning:layout>
                                <lightning:layoutItem size="12" class="slds-p-around_small">
                                    <div class="slds-truncate" title="{!$Label.c.DPMX_Client_Information}">
                                        <strong>
                                            {!$Label.c.DPMX_Client_Information}
                                        </strong>&nbsp;
                                            <lightning:helptext icon-name="utility:info_alt" content="Resumen del último mes de las transacciones y facturaciones del cliente." class="customIcon" id="IngresoBrutoToolTip" />
                                    </div>
                                </lightning:layoutItem>
                            </lightning:layout>
                        </div>
                        <aura:if isTrue="{!v.dynamicPricing.Client_Information__c}">
                            <table class="slds-table slds-table_cell-buffer slds-table_bordered">
                                <thead>
                                    <tr class="slds-line-height_reset">
                                        <th scope="col">
                                            <div class="slds-truncate">{!$Label.c.DPMX_InformationDetail_Client_Information_Column1}</div>
                                        </th>
                                        <th scope="col">
                                            <div class="slds-truncate">{!$Label.c.DPMX_InformationDetail_Client_Information_Column2}</div>
                                        </th>
                                        <th scope="col">
                                            <div class="slds-truncate">{!$Label.c.DPMX_InformationDetail_Client_Information_Column3}</div>
                                        </th>
                                        <th scope="col">
                                            <div class="slds-truncate">{!$Label.c.DPMX_InformationDetail_Client_Information_Column4}</div>
                                        </th>
                                        <th scope="col">
                                            <div class="slds-truncate">{!$Label.c.DPMX_InformationDetail_Client_Information_Column5}</div>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="slds-hint-parent">
                                        <th scope="row">
                                            <div class="slds-truncate">{!$Label.c.DPMX_Debit}</div>
                                        </th>
                                        <td>
                                            <div class="slds-truncate">
                                                <c:DPMX_DynamicTableField fieldType="INTEGER" fieldValue="{!v.dynamicPricing.Sim_Transaction_Debit_Own__c}" />
                                            </div>
                                        </td>
                                        <td>
                                            <div class="slds-truncate">
                                                <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!v.dynamicPricing.Sim_Billing_Debit_Own_Amount__c}" currencyText="{!v.dynamicPricing.Sim_Billing_Debit_Own_Currency__c}" />
                                            </div>
                                        </td>
                                        <td>
                                            <div class="slds-truncate">
                                                <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!v.dynamicPricing.Sim_Tickets_Debit_Own_Amount__c}" currencyText="{!v.dynamicPricing.Sim_Tickets_Debit_Own_Currency__c}" />
                                            </div>
                                        </td>
                                        <td>
                                            <div class="slds-truncate">
                                                <c:DPMX_DynamicTableField fieldType="PERCENT" fieldValue="{!v.PrctMixOwn}" />
                                            </div>
                                        </td>
                                    </tr>
                                    <tr class="slds-hint-parent">
                                        <th scope="row">
                                            <div class="slds-truncate">{!$Label.c.DPMX_Credit}</div>
                                        </th>
                                        <td>
                                            <div class="slds-truncate">
                                                <c:DPMX_DynamicTableField fieldType="INTEGER" fieldValue="{!v.dynamicPricing.Sim_Transaction_Credit_Own__c}" />
                                            </div>
                                        </td>
                                        <td>
                                            <div class="slds-truncate">
                                                <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!v.dynamicPricing.Sim_Billing_Credit_Own_Amount__c}" currencyText="{!v.dynamicPricing.Sim_Billing_Credit_Own_Currency__c}" />
                                            </div>
                                        </td>
                                        <td>
                                            <div class="slds-truncate">
                                                <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!v.dynamicPricing.Sim_Tickets_Credit_Own_Amount__c}" currencyText="{!v.dynamicPricing.Sim_Tickets_Credit_Own_Currency__c}" />
                                            </div>
                                        </td>
                                        <td>
                                            <div class="slds-truncate">
                                                <c:DPMX_DynamicTableField fieldType="PERCENT" fieldValue="{!v.PrctCrMixOwn}" />
                                            </div>
                                        </td>
                                    </tr>
                                    <tr class="slds-hint-parent">
                                        <th scope="row">
                                            <div class="slds-truncate">{!$Label.c.DPMX_InformationDetail_Client_Information_Product5}</div>
                                        </th>
                                        <td>
                                            <div class="slds-truncate">
                                                <c:DPMX_DynamicTableField fieldType="INTEGER" fieldValue="{!v.dynamicPricing.Sim_Transaction_International__c}" />
                                            </div>
                                        </td>
                                        <td>
                                            <div class="slds-truncate">
                                                <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!v.dynamicPricing.Sim_Billing_International_Amount__c}" currencyText="{!v.dynamicPricing.Sim_Billing_International_Currency__c}" />
                                            </div>
                                        </td>
                                        <td>
                                            <div class="slds-truncate">
                                                <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!v.dynamicPricing.Sim_Tickets_International_Amount__c}" currencyText="{!v.dynamicPricing.Sim_Tickets_International_Currency__c}" />
                                            </div>
                                        </td>
                                        <td>
                                            <div class="slds-truncate">
                                                <c:DPMX_DynamicTableField fieldType="PERCENT" fieldValue="{!v.PrctIntMix}" />
                                            </div>
                                        </td>
                                    </tr>
                                    <tr class="slds-hint-parent">
                                        <th scope="row">
                                            <div class="slds-truncate">{!$Label.c.DPMX_InformationDetail_Client_Information_Product6}</div>
                                        </th>
                                        <td>
                                            <div class="slds-truncate">
                                                <c:DPMX_DynamicTableField fieldType="INTEGER" fieldValue="{!v.dynamicPricing.Sim_Transaction_AcquirerAffiliation__c}" />
                                            </div>
                                        </td>
                                        <td>
                                            <div class="slds-truncate">
                                                <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!v.dynamicPricing.Sim_Billing_TotalAmount_Amount__c}" currencyText="{!v.dynamicPricing.Sim_Billing_TotalAmount_Currency__c}" />
                                            </div>
                                        </td>
                                        <td>
                                            <div class="slds-truncate">
                                                <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!v.dynamicPricing.Sim_Tickets_TotalAmount_Amount__c}" currencyText="{!v.dynamicPricing.Sim_Tickets_TotalAmount_Currency__c}" />
                                            </div>
                                        </td>
                                        <td>
                                            <div class="slds-truncate">
                                                <c:DPMX_DynamicTableField fieldType="PERCENT" fieldValue="{!v.PrctTotalMix}" />
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <div class="slds-m-vertical_small">
                                <lightning:button label="{!$Label.c.DPMX_Update_Information}" iconName="utility:edit" iconPosition="left" onclick="{!c.handleModifyClientInformation}" />
                            </div>
                            <aura:set attribute="else">
                                <img class="slds-align_absolute-center slds-m-top_small" src="{!$Resource.DPMX_Simulator_Image}" />
                                <div class="slds-align_absolute-center slds-text-heading_medium slds-m-top_small">
                                    <p>{!$Label.c.DPMX_Simulator_Text2}</p>
                                </div>
                                <div class="slds-align_absolute-center slds-m-top_small">
                                    <p>{!$Label.c.DPMX_Simulator_Text3}</p>
                                </div>
                                <div class="alturadd slds-align_absolute-center slds-m-top_small">
                                    <p>
                                        <lightning:button class="slds-button slds-button_brand" label="{!$Label.c.DPMX_Add}" onclick="{!c.handleAddClientInformation}" />
                                    </p>
                                </div>
                            </aura:set>
                        </aura:if>
                    </div>

                    <div class="slds-box slds-size_2-of-4 slds-m-right_xx-small slds-m-left_xx-small">
                        <div class="slds-m-top_small slds-m-bottom_large slds-text-heading_small">
                            <lightning:layout>
                                <lightning:layoutItem size="12" class="slds-p-around_small">
                                    <div class="slds-truncate" title="{!$Label.c.DPMX_Devices}"><strong>{!$Label.c.DPMX_Devices}</strong>&nbsp;
                                    <lightning:helptext icon-name="utility:info_alt" content="Los dipositivos son los métodos de pago y las comisiones son los ingresos adicionales que se le cobran al cliente." class="customIcon" id="IngresoBrutoToolTip" />
                                    </div>
                                </lightning:layoutItem>
                            </lightning:layout>
                        </div>
                        <aura:if isTrue="{!v.dynamicPricing.Devices__c}">
                            <div class="slds-grid slds-gutters">
                                <div class="slds-col">
                                    <table class="slds-table slds-table_cell-buffer slds-table_bordered" aria-label="Información del cliente">
                                        <thead>
                                            <tr class="slds-line-height_reset">
                                                <th scope="col">
                                                    <div class="slds-truncate">{!$Label.c.DPMX_InformationDetail_Devices_Column1}</div>
                                                </th>
                                                <th scope="col">
                                                    <div class="slds-truncate">{!$Label.c.DPMX_InformationDetail_Devices_Column2}</div>
                                                </th>

                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr class="slds-hint-parent">
                                                <th scope="row">
                                                    <div class="slds-truncate">{!$Label.c.DPMX_InformationDetail_Devices_Row1}</div>
                                                </th>
                                                <td>
                                                    <div class="slds-truncate">
                                                        <c:DPMX_DynamicTableField fieldType="INTEGER" fieldValue="{!v.dynamicPricing.Sim_Terminal_Id__c}" />
                                                    </div>
                                                </td>
                                            </tr>
                                            <tr class="slds-hint-parent">
                                                <th scope="row">
                                                    <div class="slds-truncate">{!$Label.c.DPMX_InformationDetail_Devices_Row2}</div>
                                                </th>
                                                <td>
                                                    <div class="slds-truncate">
                                                        <aura:if isTrue="{!v.dynamicPricing.withOutPinPadsCheckbox__c}">
                                                            <c:DPMX_DynamicTableField fieldType="INTEGER" fieldValue="{!v.dynamicPricing.pinPadsInfo_withoutPinPads__c}" />
                                                            <aura:set attribute="else">
                                                                <c:DPMX_DynamicTableField fieldType="INTEGER" fieldValue="{!v.dynamicPricing.Sim_PinPadsInfo_PinPads__c}" />
                                                            </aura:set>
                                                        </aura:if>
                                                    </div>
                                                </td>

                                            </tr>
                                            <tr class="slds-hint-parent">
                                                <th scope="row">
                                                    <div class="slds-truncate">POS</div>
                                                </th>
                                                <td>
                                                    <div class="slds-truncate">
                                                        <c:DPMX_DynamicTableField fieldType="CHECKBOX" fieldValue="{!v.dynamicPricing.posCheckbox__c}" />
                                                    </div>
                                                </td>
                                            </tr>
                                            <tr class="slds-hint-parent">
                                                <th scope="row">
                                                    <div class="slds-truncate">{!$Label.c.DPMX_InformationDetail_Devices_Row4}</div>
                                                </th>
                                                <td>
                                                    <div class="slds-truncate">
                                                        <c:DPMX_DynamicTableField fieldType="INTEGER" fieldValue="{!v.dynamicPricing.Sim_DevicesInfo_Devices__c}" />
                                                    </div>
                                                </td>
                                            </tr>
                                            <tr class="slds-hint-parent">
                                                <th scope="row">
                                                    <div class="slds-truncate">{!$Label.c.DPMX_InformationDetail_Devices_Row3}</div>
                                                </th>
                                                <td>
                                                    <div class="slds-truncate">
                                                        <c:DPMX_DynamicTableField fieldType="CHECKBOX" fieldValue="{!v.dynamicPricing.Sim_Ecommerce__c}" />
                                                    </div>
                                                </td>
                                            </tr>
                                            <tr class="slds-hint-parent">
                                                <th scope="row">
                                                    <div class="slds-truncate">Cargos recurrentes</div>
                                                </th>
                                                <td>
                                                    <div class="slds-truncate">
                                                        <c:DPMX_DynamicTableField fieldType="CHECKBOX" fieldValue="{!v.dynamicPricing.Sim_Recurring_Charges__c}" />
                                                    </div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <div class="slds-m-vertical_small">
                                        <lightning:button label="{!$Label.c.DPMX_Update_Information}" iconName="utility:edit" iconPosition="left" onclick="{!c.handleModifyDevices}" />
                                    </div>
                                </div>
                                <div class="slds-col">
                                    <table class="slds-table slds-table_cell-buffer slds-table_bordered" aria-label="Información del cliente">
                                        <thead>
                                            <tr class="slds-line-height_reset">
                                                <th scope="col">
                                                    <div class="slds-truncate">{!$Label.c.DPMX_InformationDetail_Devices_Column3}</div>
                                                </th>
                                                <th scope="col">
                                                    <div class="slds-truncate">{!$Label.c.DPMX_InformationDetail_Devices_Column4}</div>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr class="slds-hint-parent">
                                                <td>
                                                    <div class="slds-truncate">{!$Label.c.DPMX_InformationDetail_Devices_Row5}</div>
                                                </td>
                                                <td>
                                                    <div class="slds-truncate">
                                                        <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!v.commisionTPV}" currencyText="{!v.acquirerActivitiesWrapper.commission.extraBilling.currency_y}" />
                                                    </div>
                                                </td>
                                            </tr>
                                            <tr class="slds-hint-parent">
                                                <td>
                                                    <div class="slds-truncate">{!$Label.c.DPMX_InformationDetail_Devices_Row6}</div>
                                                </td>
                                                <td>
                                                    <div class="slds-truncate">
                                                        <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!v.commisionRedCel}" currencyText="{!v.acquirerActivitiesWrapper.commission.cellnet.currency_y}" />
                                                    </div>
                                                </td>
                                            </tr>
                                            <tr class="slds-hint-parent">
                                                <td>
                                                    <div class="slds-truncate">{!$Label.c.DPMX_InformationDetail_Devices_Row7}</div>
                                                </td>
                                                <td>
                                                    <div class="slds-truncate">
                                                        <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!v.commisionBajFac}" currencyText="{!v.acquirerActivitiesWrapper.commission.billing.currency_y}" />
                                                    </div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <aura:set attribute="else">
                                <div class="slds-align_absolute-center slds-text-heading_medium slds-m-top_small">
                                    <p>{!$Label.c.DPMX_Simulator_Text4}</p>
                                </div>
                                <div class="slds-align_absolute-center slds-m-top_small">
                                    <p>{!$Label.c.DPMX_Simulator_Text5}</p>
                                </div>
                                <div class="slds-align_absolute-center slds-m-top_small">
                                    <p>
                                        <lightning:button class="slds-button slds-button_brand" label="{!$Label.c.DPMX_Add}" onclick="{!c.handleAddDevices}" />
                                    </p>
                                </div>
                            </aura:set>
                        </aura:if>
                    </div>
                </div>
                <div class="slds-grid slds-gutters">
                    <div class="slds-box slds-size_2-of-4 slds-m-right_xx-small">
                        <div class="slds-m-top_small slds-m-bottom_large slds-text-heading_small">
                            <strong>
                                <p>{!$Label.c.DPMX_SimulationResult_Title}</p>
                            </strong>
                        </div>
                        <aura:if isTrue="{!v.simulationBool}">
                            <fieldset class="slds-form-element">
                                <legend class="slds-form-element__legend slds-form-element__label"></legend>
                                <div class="slds-form-element__control">

                                    <table class="slds-table slds-table_cell-buffer slds-table_bordered">
                                        <thead>
                                            <tr class="slds-line-height_reset">
                                                <th scope="col">
                                                    <div class="slds-truncate"></div>
                                                </th>
                                                <th scope="col">
                                                    <div class="slds-truncate">{!$Label.c.DPMX_Result}</div>
                                                </th>
                                                <th scope="col">
                                                    <div class="slds-truncate">{!$Label.c.DPMX_Debit}</div>
                                                </th>
                                                <th scope="col">
                                                    <div class="slds-truncate">{!$Label.c.DPMX_Credit}</div>
                                                </th>
                                                <th scope="col">
                                                    <div class="slds-truncate">{!$Label.c.DPMX_International}</div>
                                                </th>
                                                <th scope="col">
                                                    <div class="slds-truncate">{!$Label.c.DPMX_Profitability}</div>
                                                </th>
                                                <th scope="col">
                                                    <div class="slds-truncate">{!$Label.c.DPMX_BAI}</div>
                                                </th>
                                            </tr>
                                        </thead>
                                        <aura:iteration items="{!v.validateresponseWraper.proposed}" var="SimulationRecord" indexVar="indexSimulation">
                                            <tbody>
                                                <tr class="slds-hint-parent">
                                                    <th scope="row">
                                                        <div class="slds-truncate slds-p-vertical_small">
                                                            <div class="slds-radio-Simulation" onclick="{!c.handlesaveSimulateRate}">
                                                                <input type="radio" id="{!'Simulation_'+indexSimulation}" value="{!indexSimulation}" name="Simulation" checked="false" />
                                                                <label class="slds-radio__label-Simulation" for="{!indexSimulation}">
                                                        <div class="slds-radio_faux"/>
                                                    </label>
                                                            </div>
                                                        </div>
                                                    </th>
                                                    <td>
                                                        <div class="slds-truncate">
                                                            <aura:if isTrue="{!SimulationRecord.scenaryType == 'BREAK_EVEN'}">
                                                                <c:DPMX_DynamicTableField fieldType="STRING" fieldValue="Break even" />
                                                                <aura:set attribute="else">
                                                                    <aura:if isTrue="{!SimulationRecord.scenaryType == 'OPTIMAL'}">
                                                                        <c:DPMX_DynamicTableField fieldType="STRING" fieldValue="Optimo" />
                                                                        <aura:set attribute="else">
                                                                            <aura:if isTrue="{!SimulationRecord.scenaryType == 'GOOD'}">
                                                                                <c:DPMX_DynamicTableField fieldType="STRING" fieldValue="Bueno" />
                                                                                <aura:set attribute="else">
                                                                                    <c:DPMX_DynamicTableField fieldType="STRING" fieldValue="{!SimulationRecord.scenaryType}" />
                                                                                </aura:set>
                                                                            </aura:if>
                                                                        </aura:set>
                                                                    </aura:if>
                                                                </aura:set>
                                                            </aura:if>
                                                        </div>
                                                    </td>
                                                    <aura:iteration items="{!SimulationRecord.rate.itemizeRates}" var="simulationTypes" indexVar="indexSimulation">
                                                        <td>
                                                            <div class="slds-truncate">
                                                                <aura:if isTrue="{!indexSimulation == 0}">
                                                                    <aura:if isTrue="{!v.isGs}">
                                                                        <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!simulationTypes.itemizeRatesUnit.amount}" currencyText="MXN" />
                                                                        <aura:set attribute="else">
                                                                            <c:DPMX_DynamicTableField fieldType="PERCENT" fieldValue="{!simulationTypes.itemizeRatesUnit.percentage}" />
                                                                        </aura:set>
                                                                    </aura:if>
                                                                    <aura:set attribute="else">
                                                                        <c:DPMX_DynamicTableField fieldType="PERCENT" fieldValue="{!simulationTypes.itemizeRatesUnit.percentage}" />
                                                                    </aura:set>
                                                                </aura:if>
                                                            </div>
                                                        </td>
                                                    </aura:iteration>
                                                    <td>
                                                        <div class="slds-truncate">
                                                            <aura:if isTrue="{!SimulationRecord.scenaryType == 'BREAK_EVEN'}">
                                                                <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="0" currencyText="{!SimulationRecord.amount.currency_y}" />
                                                                <aura:set attribute="else">
                                                                    <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!SimulationRecord.amount.amount}" currencyText="{!SimulationRecord.amount.currency_y}" />
                                                                </aura:set>
                                                            </aura:if>
                                                        </div>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </aura:iteration>
                                        <tbody>
                                            <tr class="slds-hint-parent">
                                                <th scope="row">
                                                    <div class="slds-truncate">
                                                        <div class="slds-radio-Simulation" onclick="{!c.handlesaveSimulateRate}">
                                                            <input type="radio" id="Simulation_5" value="5" name="Simulation" checked="false" />
                                                            <label class="slds-radio__label-Simulation" for="5">
                                                    <div class="slds-radio_faux"></div>
                                                        </label>
                                                        </div>
                                                    </div>
                                                </th>
                                                <td>
                                                    <div class="slds-truncate">
                                                        <c:DPMX_DynamicTableField fieldType="STRING" fieldValue="{!v.resultRatesSimulation}" />
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="slds-grid slds-gutters">
                                                        <div class="slds-col">
                                                            <lightning:recordEditForm aura:id="dynamicPricingForm" objectApiName="DPMX_Dynamic_Pricing__c" class="slds-card__body_inner">
                                                                <div class="slds-grid">
                                                                    <div class="slds-col">
                                                                        <aura:if isTrue="{!v.isGs}">
                                                                            <aura:if isTrue="{!v.editDebitSimulationbool}">
                                                                                <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!v.debitSimulation}" currencyText="MXN" />
                                                                                <aura:set attribute="else">
                                                                                    <lightning:recordEditForm aura:id="dynamicPricingForm" objectApiName="DPMX_Dynamic_Pricing__c" class="slds-card__body_inner">
                                                                                        <lightning:inputField fieldName="CustomSimulatedDebit__c" variant="label-hidden" readonly="{!v.editDebitSimulationbool}" aura:id="edtSimulationDebito" required="true" value="{!v.debitSimulation}" />
                                                                                    </lightning:recordEditForm>
                                                                                </aura:set>
                                                                            </aura:if>
                                                                            <aura:set attribute="else">
                                                                                <aura:if isTrue="{!v.editDebitSimulationbool}">
                                                                                    <c:DPMX_DynamicTableField fieldType="PERCENT" fieldValue="{!v.debitSimulation}" />
                                                                                    <aura:set attribute="else">
                                                                                        <lightning:recordEditForm aura:id="dynamicPricingForm" objectApiName="DPMX_Dynamic_Pricing__c" class="slds-card__body_inner">
                                                                                            <lightning:inputField fieldName="CustomSimulatedDebit__c" variant="label-hidden" readonly="{!v.editDebitSimulationbool}" aura:id="edtSimulationDebito" required="true" value="{!v.debitSimulation}" />
                                                                                        </lightning:recordEditForm>
                                                                                    </aura:set>
                                                                                </aura:if>
                                                                            </aura:set>
                                                                        </aura:if>
                                                                    </div>
                                                                </div>
                                                            </lightning:recordEditForm>
                                                        </div>
                                                        <div class="slds-col">
                                                            <div>
                                                                <button class="slds-button slds-button_icon" onclick="{!c.handleEditDebitSimulation}" title="Editar">
                                                                    <lightning:icon iconName="utility:edit" size="xx-small" />
                                                                    <div class="slds-assistive-text">Edit</div>
                                                            </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="slds-grid slds-gutters">
                                                        <div class="slds-col">
                                                            <lightning:recordEditForm aura:id="dynamicPricingForm" objectApiName="DPMX_Dynamic_Pricing__c" class="slds-card__body_inner">
                                                                <div class="slds-grid">
                                                                    <div class="slds-col">
                                                                        <lightning:inputField fieldName="CustomSimulatedCredit__c" variant="label-hidden" readonly="{!v.editCreditSimulationbool}" aura:id="edtSimulationCredit" required="true" value="{!v.creditSimulation}" />
                                                                    </div>
                                                                </div>
                                                            </lightning:recordEditForm>
                                                        </div>
                                                        <div class="slds-col">
                                                            <div>
                                                                <button class="slds-button slds-button_icon" onclick="{!c.handleEditCreditSimulation}" title="Editar">
                                                                    <lightning:icon iconName="utility:edit" size="xx-small" />
                                                                    <div class="slds-assistive-text">Edit</div>
                                                            </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="slds-grid slds-gutters">
                                                        <div class="slds-col">
                                                            <lightning:recordEditForm aura:id="dynamicPricingForm" objectApiName="DPMX_Dynamic_Pricing__c" class="slds-card__body_inner">
                                                                <div class="slds-grid">
                                                                    <div class="slds-col">
                                                                        <lightning:inputField fieldName="CustomSimulatedInternational__c" variant="label-hidden" readonly="{!v.editInternationalSimulationbool}" aura:id="edtSimulationInternational" required="true" value="{!v.internationalSimulation}" />
                                                                    </div>
                                                                </div>
                                                            </lightning:recordEditForm>
                                                        </div>
                                                        <div class="slds-col">
                                                            <div>
                                                                <button class="slds-button slds-button_icon" onclick="{!c.handleEditInternationalSimulation}" title="Editar">
                                                                    <lightning:icon iconName="utility:edit" size="xx-small" />
                                                                    <div class="slds-assistive-text">Edit</div>
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="slds-grid slds-gutters">
                                                        <div class="slds-col">
                                                            <div>
                                                                <c:DPMX_DynamicTableField fieldType="PERCENT" fieldValue="{!v.profitabilitySimulation}" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="slds-truncate">
                                                        <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!v.profitAmountSimulation}" currencyText="MXN" />
                                                    </div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </fieldset>
                            <div class="slds-m-top_small slds-p-left_medium ">
                                <p class="slds-grid slds-wrap">
                                    <lightning:icon class="slds-p-left_xx-small slds-p-right_small" iconName="utility:info" alternativeText="Info" title="Info" size="small" />
                                    <div class="slds-p-top_xxx-small">
                                        <strong>{!$Label.c.DPMX_ProposedDiscountRates_Text3}</strong>
                                    </div>
                                </p>
                            </div>
                            <div class="slds-clearfix slds-m-top_large">
                                <aura:if isTrue="{!v.disableSaveEditSimBtn}">
                                    <lightning:button class="slds-m-top_none slds-float_right slds-m-horizontal_xx-small" disabled="{!v.disableUpdateSimulationBtn}" label="{!$Label.c.DPMX_Update}" onclick="{!c.handleSaveSimulation}" iconName="utility:edit" />
                                </aura:if>
                            </div>
                            <aura:set attribute="else">
                                <div class="slds-modal__container slds-align_absolute-center slds-size_xx-large">
                                    <div class="slds-var-p-around_medium slds-m-left_xx-small slds-m-right_xx-small">
                                        <img class="slds-align_absolute-center slds-m-top_small" src="{!$Resource.DPMX_SimulationResult_Image}" />
                                        <div class="slds-text-align_center slds-text-heading_medium slds-m-top_small">
                                            <p>{!$Label.c.DPMX_SimulationResult_Text2}</p>
                                        </div>
                                        <div class="slds-text-align_center slds-m-top_small">
                                            <p>{!$Label.c.DPMX_SimulationResult_Text3}</p>
                                        </div>
                                        <div class="slds-align_absolute-center slds-m-top_small">
                                            <p>
                                                <lightning:button class="slds-button slds-button_brand" label="{!$Label.c.DPMX_Simulate}" onclick="{!c.handleOnSimulate}" disabled="{!or(!v.dynamicPricing.Client_Information__c,!v.dynamicPricing.Devices__c)}" />
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </aura:set>
                        </aura:if>
                    </div>
                    <div class="slds-box slds-size_1-of-4 slds-m-left_xx-small">
                        <div class="slds-text-heading_small slds-m-top_small">
                            <p><strong>{!$Label.c.DPMX_ReferenceRates_Title}</strong></p>
                        </div>
                        <div class="slds-p-vertical_small">
                            <div class="slds-m-top_small slds-m-bottom_xxx-small">
                                <p>{!$Label.c.DPMX_ReferenceRates_Section2}</p>
                            </div>
                            <table class="slds-table slds-table--col-bordered roundtable">
                                <td border="1">
                                    <tr>
                                        <div>
                                            <div>
                                                <div class="slds-truncate">{!$Label.c.DPMX_Debit}</div>
                                            </div>
                                            <div class="slds-text-heading--medium slds-p-bottom_xxx-small">
                                                <aura:if isTrue="{!v.isGs}">
                                                    <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!v.discountRates.debit}" currencyText="MXN" />
                                                    <aura:set attribute="else">
                                                        <c:DPMX_DynamicTableField fieldType="PERCENT" fieldValue="{!v.discountRates.debit}" />
                                                    </aura:set>
                                                </aura:if>
                                            </div>
                                        </div>
                                    </tr>
                                </td>
                                <td border="1">
                                    <tr>
                                        <div>
                                            <div>
                                                <div class="slds-truncate">{!$Label.c.DPMX_Credit}</div>
                                            </div>
                                            <div class="slds-text-heading--medium">
                                                <c:DPMX_DynamicTableField fieldType="PERCENT" fieldValue="{!v.discountRates.credit}" />
                                            </div>
                                        </div>
                                    </tr>
                                </td>
                                <td border="1">
                                    <tr>
                                        <div>
                                            <div>
                                                <div class="slds-truncate">{!$Label.c.DPMX_International}</div>
                                            </div>
                                            <div class="slds-text-heading--medium">
                                                <c:DPMX_DynamicTableField fieldType="PERCENT" fieldValue="{!v.discountRates.international}" />
                                            </div>
                                        </div>
                                    </tr>
                                </td>
                            </table>
                        </div>
                        <div class="slds-p-vertical_small">
                            <div class="slds-m-top_small slds-m-bottom_xxx-small">
                                <p>{!$Label.c.DPMX_ReferenceRates_Section1}</p>
                            </div>
