                                    <tbody>
                                        <tr class="slds-line-height_reset">
                                            <th scope="col">
                                                <div class="slds-truncate">{!$Label.c.DPMX_InformationDetail_Devices_Row5}</div>
                                            </th>
                                            <td data-label="Close Date">
                                                <div class="slds-truncate">
                                                    <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!v.acquirerActivitiesWrapper.commission.opportunity.posExtra.amount}" currencyText="{!v.acquirerActivitiesWrapper.commission.opportunity.posExtra.currency_y}" />
                                                </div>
                                            </td>
                                        </tr>
                                        <tr class="slds-hint-parent">
                                            <th scope="col">
                                                <div class="slds-truncate">{!$Label.c.DPMX_InformationDetail_Devices_Row6}</div>
                                            </th>
                                            <td data-label="Close Date">
                                                <div class="slds-truncate">
                                                    <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!v.acquirerActivitiesWrapper.commission.opportunity.cellnet.amount}" currencyText="{!v.acquirerActivitiesWrapper.commission.opportunity.cellnet.currency_y}" />
                                                </div>
                                            </td>
                                        </tr>
