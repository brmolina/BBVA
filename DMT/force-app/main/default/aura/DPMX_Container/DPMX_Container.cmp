                                                        <c:DPMX_DynamicTableField fieldType="PERCENT" fieldValue="{!v.PrctIntMix}" />
                                                    </div>
                                                </td>
                                            </tr>
                                            <tr class="slds-hint-parent">
                                                <th scope="row">
                                                    <div class="slds-truncate">{!$Label.c.DPMX_InformationDetail_Client_Information_Product6}</div>
                                                </th>
                                                <td>
                                                    <div class="slds-truncate">
                                                        <c:DPMX_DynamicTableField fieldType="INTEGER" fieldValue="{!v.dynamicPricing.Sim_Transaction_AcquirerAffiliation__c}" />
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="slds-truncate">
                                                        <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!v.dynamicPricing.Sim_Billing_TotalAmount_Amount__c}" currencyText="{!v.dynamicPricing.Sim_Billing_TotalAmount_Currency__c}" />
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="slds-truncate">
                                                        <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!v.dynamicPricing.Sim_Tickets_TotalAmount_Amount__c}" currencyText="{!v.dynamicPricing.Sim_Tickets_TotalAmount_Currency__c}" />
                                                    </div>
                                                </td>
                                                <td>
