                                                        <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!v.dynamicPricing.Sim_Billing_International_Amount__c}" currencyText="{!v.dynamicPricing.Sim_Billing_International_Currency__c}" />
                                                    </div>
                                                </td>
                                                <td>
