                                        </lightning:layoutItem>
                                    </lightning:layout>
                                </div>
                                <div class="slds-m-top_xx-small slds-m-bottom_small">
                                    <p>{!$Label.c.DPMX_ProposedDiscountRates_Text1}&nbsp;{!v.acquirerFeesWrapper.consultMonth}&nbsp;{!$Label.c.DPMX_ProposedDiscountRates_Text2}</p>
                                    <aura:if isTrue="{!v.isBreakEvenOutOfLimits}">
                                        <div class="slds-p-top_xxx-small">
                                            <div class="slds-grid slds-wrap  slds-box slds-theme_shade">
                                                <div class="slds-grid slds-gutters">
                                                    <div class="slds-col slds-size_1-of-8">
                                                        <lightning:icon class="slds-p-left_xx-small slds-p-right_small" iconName="utility:info" alternativeText="Info" title="Info" size="small" />
                                                    </div>
                                                    <div class="slds-col slds-size_7-of-8">
                                                        <div>
                                                            La rentabilidad actual no corresponde a un escenario de break-even. La tasa que puedes proponer debe estar por encima de la tasa de intercambio. Te recomendamos ingresar esos datos como tasa personalizada para calcular la rentabilidad correcta.
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </aura:if>
                                </div>
                                <fieldset class="slds-form-element">
                                    <legend class="slds-form-element__legend slds-form-element__label"></legend>
                                    <div class="slds-form-element__control">
                                        <table class="slds-table slds-table_cell-buffer slds-table_bordered">
                                            <thead>
                                                <tr class="slds-line-height_reset">
                                                    <th scope="col">
                                                        <div class="slds-truncate"></div>
                                                    </th>
                                                    <th scope="col">
                                                        <div class="slds-truncate">{!$Label.c.DPMX_Result}</div>
                                                    </th>
                                                    <th scope="col">
                                                        <div class="slds-truncate">{!$Label.c.DPMX_Debit}</div>
                                                    </th>
                                                    <th scope="col">
                                                        <div class="slds-truncate">{!$Label.c.DPMX_Credit}</div>
                                                    </th>
                                                    <th scope="col">
                                                        <div class="slds-truncate">{!$Label.c.DPMX_International}</div>
                                                    </th>
                                                    <th scope="col">
                                                        <div class="slds-truncate">{!$Label.c.DPMX_Profitability}</div>
                                                    </th>
                                                    <th scope="col">
                                                        <div class="slds-truncate">{!$Label.c.DPMX_BAI}</div>
                                                    </th>
                                                </tr>
                                            </thead>
                                            <aura:iteration items="{!v.lstScenearios}" var="acquirerFeesRecord" indexVar="index">
                                                <tbody>
                                                    <tr class="slds-hint-parent">
                                                        <th scope="row">
                                                            <div class="slds-truncate slds-p-vertical_small">
                                                                <div class="slds-radio" onclick="{!c.handlesaveDiscountRate}">
                                                                    <input type="radio" id="{!index}" value="{!index}" name="default" checked="false" />
                                                                    <label class="slds-radio__label" for="{!index}">
                                                                        <div class="slds-radio_faux"/>
                                                                    </label>
                                                                </div>
                                                            </div>
                                                        </th>
                                                        <td>
                                                            <div class="slds-truncate">
                                                                <aura:if isTrue="{!acquirerFeesRecord.scenarioType == 'BREAK_EVEN'}">
                                                                    <c:DPMX_DynamicTableField fieldType="STRING" fieldValue="Break even" />
                                                                    <aura:set attribute="else">
                                                                        <aura:if isTrue="{!acquirerFeesRecord.scenarioType == 'OPTIMAL'}">
                                                                            <c:DPMX_DynamicTableField fieldType="STRING" fieldValue="Optimo" />
                                                                            <aura:set attribute="else">
                                                                                <aura:if isTrue="{!acquirerFeesRecord.scenarioType == 'GOOD'}">
                                                                                    <c:DPMX_DynamicTableField fieldType="STRING" fieldValue="Bueno" />
                                                                                    <aura:set attribute="else">
                                                                                        <c:DPMX_DynamicTableField fieldType="STRING" fieldValue="{!acquirerFeesRecord.scenarioType}" />
                                                                                    </aura:set>
                                                                                </aura:if>
                                                                            </aura:set>
                                                                        </aura:if>
                                                                    </aura:set>
                                                                </aura:if>
                                                            </div>
                                                        </td>
                                                        <aura:iteration items="{!acquirerFeesRecord.fees.itemizeFees}" var="acquirerFeesTypes" indexVar="index2">
                                                            <td>
                                                                <div class="slds-truncate">
                                                                    <aura:if isTrue="{!index2 == 0}">
                                                                        <aura:if isTrue="{!v.acquirerActivitiesWrapper.isGS}">
                                                                            <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!acquirerFeesTypes.itemizeFeeUnit.amount}" currencyText="{!acquirerFeesTypes.itemizeFeeUnit.currency_y}" />
                                                                            <aura:set attribute="else">
                                                                                <c:DPMX_DynamicTableField fieldType="PERCENT" fieldValue="{!acquirerFeesTypes.itemizeFeeUnit.value}" />
                                                                            </aura:set>
                                                                        </aura:if>
                                                                        <aura:set attribute="else">
                                                                            <c:DPMX_DynamicTableField fieldType="PERCENT" fieldValue="{!acquirerFeesTypes.itemizeFeeUnit.value}" />
                                                                        </aura:set>
                                                                    </aura:if>
                                                                </div>
                                                            </td>
                                                        </aura:iteration>
                                                        <td>
                                                            <div class="slds-truncate">
                                                                <c:DPMX_DynamicTableField fieldType="NUMBER" fieldValue="{!acquirerFeesRecord.fees.profitability.percentage}" />
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <div class="slds-truncate">
                                                                <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!acquirerFeesRecord.fees.profitability.amount.amount}" currencyText="{!acquirerFeesRecord.fees.profitability.amount.currency_y}" />
                                                            </div>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </aura:iteration>

                                            <tbody>
                                                <tr class="slds-hint-parent">
                                                    <th scope="row">
                                                        <div class="slds-truncate">
                                                            <div class="slds-radio" onclick="{!c.handlesaveDiscountRate}">
                                                                <input type="radio" id="5" value="5" name="default" checked="false" />
                                                                <label class="slds-radio__label" for="5">
                                                    <div class="slds-radio_faux"></div>
                                                            </label>
                                                            </div>
                                                        </div>
                                                    </th>
                                                    <td>
                                                        <div class="slds-truncate">
                                                            <c:DPMX_DynamicTableField fieldType="STRING" fieldValue="{!v.resultRates}" />
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="slds-grid slds-gutters">
                                                            <div class="slds-col">
                                                                <div class="slds-grid">
                                                                    <div class="slds-col">
                                                                        <aura:if isTrue="{!v.acquirerActivitiesWrapper.isGS}">
                                                                            <aura:if isTrue="{!v.editDebitbool}">
                                                                                <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!v.debit}" currencyText="MXN" />
                                                                                <aura:set attribute="else">
                                                                                    <lightning:recordEditForm aura:id="dynamicPricingForm" objectApiName="DPMX_Dynamic_Pricing__c" class="slds-card__body_inner">
                                                                                        <lightning:inputField fieldName="CustomAcquiredFeesDebit__c" variant="label-hidden" readonly="{!v.editDebitbool}" aura:id="edtDebito" required="true" value="{!v.debit}" />
                                                                                    </lightning:recordEditForm>
                                                                                </aura:set>
                                                                            </aura:if>
                                                                            <aura:set attribute="else">
                                                                                <aura:if isTrue="{!v.editDebitbool}">
                                                                                    <c:DPMX_DynamicTableField fieldType="PERCENT" fieldValue="{!v.debit}" />
                                                                                    <aura:set attribute="else">
                                                                                        <lightning:recordEditForm aura:id="dynamicPricingForm" objectApiName="DPMX_Dynamic_Pricing__c" class="slds-card__body_inner">
                                                                                            <lightning:inputField fieldName="CustomAcquiredFeesDebit__c" variant="label-hidden" readonly="{!v.editDebitbool}" aura:id="edtDebito" required="true" value="{!v.debit}" />
                                                                                        </lightning:recordEditForm>
                                                                                    </aura:set>
                                                                                </aura:if>
                                                                            </aura:set>
                                                                        </aura:if>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="slds-col">
                                                                <div>
                                                                    <button class="slds-button slds-button_icon" onclick="{!c.handleEditDebit}" title="Editar">
                                                                        <lightning:icon iconName="utility:edit" size="xx-small" />
                                                                        <div class="slds-assistive-text">Edit</div>
                                                                </button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="slds-grid slds-gutters">
                                                            <div class="slds-col">
                                                                <lightning:recordEditForm aura:id="dynamicPricingForm" objectApiName="DPMX_Dynamic_Pricing__c" class="slds-card__body_inner">
                                                                    <div class="slds-grid">
                                                                        <div class="slds-col">
                                                                            <lightning:inputField fieldName="CustomAcquiredFeesCredit__c" variant="label-hidden" readonly="{!v.editCreditbool}" aura:id="edtCredit" required="true" value="{!v.credit}" />
                                                                        </div>
                                                                    </div>
                                                                </lightning:recordEditForm>
                                                            </div>
                                                            <div class="slds-col">
                                                                <div>
                                                                    <button class="slds-button slds-button_icon" onclick="{!c.handleEditCredit}" title="Editar">
                                                                    <lightning:icon iconName="utility:edit" size="xx-small" />
                                                                    <div class="slds-assistive-text">Edit</div>
                                                                </button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="slds-grid slds-gutters">
                                                            <div class="slds-col">
                                                                <lightning:recordEditForm aura:id="dynamicPricingForm" objectApiName="DPMX_Dynamic_Pricing__c" class="slds-card__body_inner">
                                                                    <div class="slds-grid">
                                                                        <div class="slds-col">
                                                                            <lightning:inputField fieldName="CustomAcquiredFeesInternational__c" variant="label-hidden" readonly="{!v.editInternationalbool}" aura:id="edtInternational" required="true" value="{!v.international}" />
                                                                        </div>
                                                                    </div>
                                                                </lightning:recordEditForm>
                                                            </div>
                                                            <div class="slds-col">
                                                                <div>
                                                                    <button class="slds-button slds-button_icon" onclick="{!c.handleEditInternational}" title="Editar">
                                                                        <lightning:icon iconName="utility:edit" size="xx-small" />
                                                                        <div class="slds-assistive-text">Edit</div>
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td>

                                                        <div class="slds-grid slds-gutters">
                                                            <div class="slds-col">
                                                                <div>
                                                                    <c:DPMX_DynamicTableField fieldType="NUMBER" fieldValue="{!v.profitability}" />
                                                                </div>
                                                            </div>
                                                            <div class="slds-col">
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="slds-truncate">
                                                            <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!v.profitAmount}" currencyText="MXN" />
                                                        </div>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </fieldset>
                                <div class="slds-m-top_small slds-p-left_medium ">
                                    <lightning:icon iconName="utility:info" size="small" alternativetext="Infoormación" title="Infoormación"></lightning:icon> &nbsp; {!$Label.c.DPMX_ProposedDiscountRates_Text3}
                                </div>
                                <div class="slds-clearfix slds-m-top_large">
                                    <aura:if isTrue="{!v.disableSaveEditBtn}">
                                        <lightning:button class="slds-m-top_none slds-float_right slds-m-horizontal_xx-small" disabled="{!v.disableUpdateBtn}" label="{!$Label.c.DPMX_Update}" onclick="{!c.handleSave}" iconName="utility:edit" />
                                    </aura:if>
                                    <aura:if isTrue="{!v.disableSubmitBtn}">
                                        <lightning:button class="slds-m-top_none slds-float_right slds-m-horizontal_xx-small" disabled="{!v.deniedFormalizeCheck}" label="{!$Label.c.DPMX_Formalizar}" onclick="{!c.handleVerificarTasa}" variant="brand" />
                                        <aura:if isTrue="{!v.disableAuthBtn}">
                                            <lightning:button class="slds-m-top_none slds-float_right slds-m-horizontal_xx-small" disabled="{!v.deniedAuthorizeCheck}" label="{!$Label.c.DPMX_request_authorization}" onclick="{!c.handleAuthoritation }" />
                                        </aura:if>
                                    </aura:if>
                                </div>
                            </div>
                            <div class="slds-box slds-size_1-of-4 slds-m-right_xx-small slds-m-left_xx-small">
                                <div class="slds-text-heading_small slds-m-top_small">
                                    <p><strong>{!$Label.c.DPMX_ReferenceRates_Title}</strong></p>
                                </div>
                                <div class="slds-m-top_xx-small slds-m-bottom_small">
                                    <p>{!$Label.c.DPMX_ReferenceRates_Subtitle}&nbsp;{!v.acquirerActivitiesWrapper.businessInformation.familyAcquirer} - {!v.acquirerActivitiesWrapper.informationDate}</p>
                                </div>
                                <div class="slds-p-vertical_small">
                                    <div>
                                        <div class="slds-m-top_small slds-m-bottom_xxx-small">
                                            <p>{!$Label.c.DPMX_ReferenceRates_Section2}</p>
                                        </div>
                                        <table class="slds-table slds-table--col-bordered roundtable">
                                            <td border="1">
                                                <tr>
                                                    <div>
                                                        <div>
                                                            <div class="slds-truncate">
                                                                {!$Label.c.DPMX_Debit}
                                                            </div>
                                                        </div>
                                                        <div class="slds-text-heading--medium slds-p-bottom_xxx-small">
                                                            <aura:if isTrue="{!v.acquirerActivitiesWrapper.isGS}">
                                                                <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!v.discountRates.debit}" currencyText="MXN" />
                                                                <aura:set attribute="else">
                                                                    <c:DPMX_DynamicTableField fieldType="PERCENT" fieldValue="{!v.discountRates.debit}" />
                                                                </aura:set>
                                                            </aura:if>
                                                        </div>
                                                    </div>
                                                </tr>
                                            </td>
                                            <td border="1">
                                                <tr>
                                                    <div>
                                                        <div>
                                                            <div class="slds-truncate">{!$Label.c.DPMX_Credit}</div>
                                                        </div>
                                                        <div class="slds-text-heading--medium">
                                                            <c:DPMX_DynamicTableField fieldType="PERCENT" fieldValue="{!v.discountRates.credit}" />
                                                        </div>
                                                    </div>
                                                </tr>
                                            </td>
                                            <td border="1">
                                                <tr>
                                                    <div>
                                                        <div>
                                                            <div class="slds-truncate">{!$Label.c.DPMX_International}</div>
                                                        </div>
                                                        <div class="slds-text-heading--medium">
                                                            <c:DPMX_DynamicTableField fieldType="PERCENT" fieldValue="{!v.discountRates.international}" />
                                                        </div>
                                                    </div>
                                                </tr>
                                            </td>
                                        </table>
                                    </div>
                                </div>
                                <div class="slds-p-vertical_small">
                                    <div>
                                        <div class="slds-m-top_small slds-m-bottom_xxx-small">
                                            <p>{!$Label.c.DPMX_ReferenceRates_Section1}</p>
                                        </div>
                                        <table class="slds-table slds-table--col-bordered roundtable slds-theme_shade">
                                            <td border="1">
                                                <tr>
                                                    <div>
                                                        <div>
                                                            <div class="slds-truncate">{!$Label.c.DPMX_Debit}</div>
                                                        </div>
                                                        <div class="slds-text-heading--medium slds-p-bottom_xxx-small">
                                                            <aura:if isTrue="{!v.acquirerActivitiesWrapper.isGS}">
                                                                <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!v.interchangeRates.debit}" currencyText="MXN" />
                                                                <aura:set attribute="else">
                                                                    <c:DPMX_DynamicTableField fieldType="PERCENT" fieldValue="{!v.interchangeRates.debit}" />
                                                                </aura:set>
                                                            </aura:if>
                                                        </div>
                                                    </div>
                                                </tr>
                                            </td>
                                            <td border="1">
                                                <tr>
                                                    <div>
                                                        <div>
                                                            <div class="slds-truncate">{!$Label.c.DPMX_Credit}</div>
                                                        </div>
                                                        <div class="slds-text-heading--medium">
                                                            <c:DPMX_DynamicTableField fieldType="PERCENT" fieldValue="{!v.interchangeRates.credit}" />
                                                        </div>
                                                    </div>
                                                </tr>
                                            </td>
                                            <td border="1">
                                                <tr>
                                                    <div>
                                                        <div>
                                                            <div class="slds-truncate">{!$Label.c.DPMX_International}</div>
                                                        </div>
                                                        <div class="slds-text-heading--medium">
                                                            <c:DPMX_DynamicTableField fieldType="PERCENT" fieldValue="{!v.interchangeRates.international}" />
                                                        </div>
                                                    </div>
                                                </tr>
                                            </td>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div class="slds-box slds-size_1-of-4 slds-m-left_xx-small">
                                <div class="slds-text-heading_small slds-m-top_small">
                                    <p><strong>{!$Label.c.DPMX_Opportunities}</strong></p>
                                </div>
