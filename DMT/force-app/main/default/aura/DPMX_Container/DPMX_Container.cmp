                                                    <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!v.acquirerActivitiesWrapper.commission.opportunity.lowBilling.amount}" currencyText="{!v.acquirerActivitiesWrapper.commission.opportunity.lowBilling.currency_y}" />
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </lightning:tab>
                    <lightning:tab label="Simulación" id="two" onactive="{!c.handleTabSimulationSelected}" iconName="standard:calculated_insights">
                        <div class="slds-grid slds-m-vertical_medium slds-p-right_medium">
                            <div class="slds-box slds-size_2-of-4 slds-m-right_xx-small">
                                <div class="slds-m-top_small slds-m-bottom_large slds-text-heading_small">
                                    <strong>
                        {!$Label.c.DPMX_Client_Information}
                    </strong>
                                </div>
                                <aura:if isTrue="{!v.dynamicPricing.Client_Information__c}">
                                    <table class="slds-table slds-table_cell-buffer slds-table_bordered">
                                        <thead>
                                            <tr class="slds-line-height_reset">
                                                <th scope="col">
                                                    <div class="slds-truncate">{!$Label.c.DPMX_InformationDetail_Client_Information_Column1}</div>
                                                </th>
                                                <th scope="col">
                                                    <div class="slds-truncate">{!$Label.c.DPMX_InformationDetail_Client_Information_Column2}</div>
                                                </th>
                                                <th scope="col">
                                                    <div class="slds-truncate">{!$Label.c.DPMX_InformationDetail_Client_Information_Column3}</div>
                                                </th>
                                                <th scope="col">
                                                    <div class="slds-truncate">{!$Label.c.DPMX_InformationDetail_Client_Information_Column4}</div>
                                                </th>
                                                <th scope="col">
                                                    <div class="slds-truncate">{!$Label.c.DPMX_InformationDetail_Client_Information_Column5}</div>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr class="slds-hint-parent">
                                                <th scope="row">
                                                    <div class="slds-truncate">{!$Label.c.DPMX_Debit}</div>
                                                </th>
                                                <td>
                                                    <div class="slds-truncate">
                                                        <c:DPMX_DynamicTableField fieldType="INTEGER" fieldValue="{!v.dynamicPricing.Sim_Transaction_Debit_Own__c}" />
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="slds-truncate">
                                                        <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!v.dynamicPricing.Sim_Billing_Debit_Own_Amount__c}" currencyText="{!v.dynamicPricing.Sim_Billing_Debit_Own_Currency__c}" />
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="slds-truncate">
                                                        <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!v.dynamicPricing.Sim_Tickets_Debit_Own_Amount__c}" currencyText="{!v.dynamicPricing.Sim_Tickets_Debit_Own_Currency__c}" />
                                                    </div>
