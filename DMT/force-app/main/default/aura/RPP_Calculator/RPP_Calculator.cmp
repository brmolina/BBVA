<aura:component implements="flexipage:availableForAllPageTypes,force:hasRecordId" access="global" controller="RPP_Calculator_Ctrl">
    <aura:attribute name="recordId" type="String"/>
    <aura:attribute name="waiting" type="Boolean" default="false"/>
    <aura:attribute name="RPPCalculator" type="Object"/>
    <aura:attribute name="RPPCalculatorFields" type="Map"/>
    <aura:attribute name="RPPCalculatorDebtors" type="List" default="[]"/>
    <aura:attribute name="RPPCalculatorDebtorFields" type="Map"/>
    <aura:attribute name="RPPCalculatorSimulation" type="Object"/>
    <aura:attribute name="RPPCalculatorSimFields" type="Map"/>
    <aura:attribute name="RPPCalculatorSimulationDebtors" type="List" default="[]"/>
    <aura:attribute name="RPPCalculatorSimDebtorFields" type="Map"/>
    <aura:attribute name="hasSimulations" type="Boolean" default="false"/>
    <aura:attribute name="selectedTab" type="String" default="googlesheet"/>
    <aura:attribute name="selectedSimTab" type="String" default="rppport"/>
    <aura:attribute name="errorsList" type="List" default="[]"/>
    <aura:attribute name="hasErrors" type="Boolean" default="false" />
    <aura:attribute name="simulationsWrapperList" type="List" default="[]"/>
    <aura:attribute name="selectedSimulation" type="String"/>
    <aura:attribute name="canSimulate" type="Boolean"/>
    <aura:attribute name="showSimulationButtons" type="Boolean"/>
    <aura:attribute name="showSimulationResults" type="Boolean"/>
    <aura:attribute name="hasPermission" type="Boolean"/>
    <aura:attribute name="isGoal1" type="Boolean"/>
    <aura:attribute name="options" type="List" />
    <aura:attribute name="selectedValue" type="String"/>

    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <aura:handler event="c:RPP_CalculatorRefresh_evt" action="{!c.doInit}" />

    <aura:if isTrue="{!v.waiting}">
        <lightning:spinner variant="brand" />
    </aura:if>
    <aura:if isTrue="{!v.hasErrors}">
        <div class="slds-notify slds-notify_alert slds-theme_alert-texture slds-theme_error" role="alert">
            <span class="slds-icon_container slds-icon-utility-error slds-m-right_x-small">
                <lightning:icon iconName="utility:error" size="xx-small" variant="inverse"/>
            </span>
            <h2>{!$Label.c.RPP_Load_Gsheet_Error}</h2>
        </div>
        <div>
            <table class="slds-table slds-table_cell-buffer slds-table_bordered slds-m-top_small">
                <thead>
                    <tr class="slds-line-height_reset">
                        <th scope="col">
                            <div class="slds-truncate">{!$Label.c.RPP_GOOGLE_SHEET_TAB}</div>
                        </th>
                        <th scope="col">
                            <div class="slds-truncate">{!$Label.c.RPP_GOOGLE_SHEET_CELL}</div>
                        </th>
                        <th scope="col">
                            <div class="slds-truncate">{!$Label.c.RPP_DEBTORS_ROW}</div>
                        </th>
                        <th scope="col">
                            <div class="slds-truncate">{!$Label.c.RPP_TYPE_COLUMN}</div>
                        </th>
                        <th scope="col">
                            <div class="slds-truncate">{!$Label.c.RPP_FIELD}</div>
                        </th>
                        <th scope="col">
                            <div class="slds-truncate">{!$Label.c.RPP_ERROR}</div>
                        </th>
                        <th scope="col">
                            <div class="slds-truncate">{!$Label.c.RPP_SUPPORTED_VALUES}</div>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <aura:iteration items="{!v.errorsList}" var="error">
                        <tr class="slds-hint-parent">
                            <td>
                                <div class="slds-truncate">
                                    <ui:outputText value="{!error.tab}"/>
                                </div>
                            </td>
                            <td>
                                <div class="slds-truncate">
                                    <ui:outputText value="{!error.cell}"/>
                                </div>
                            </td>
                            <td>
                                <div class="slds-truncate">
                                    <ui:outputText value="{!error.row}"/>
                                </div>
                            </td>
                            <td>
                                <div class="slds-truncate">
                                    <ui:outputText value="{!error.type}"/>
                                </div>
                            </td>
                            <td>
                                <div class="slds-truncate">
                                    <ui:outputText value="{!error.field}"/>
                                </div>
                            </td>
                            <td>
                                <div class="slds-truncate">
                                    <ui:outputText value="{!error.message}"/>
                                </div>
                            </td>
                            <td>
                                <div class="slds-truncate">
                                    <ui:outputText value="{!error.values}"/>
                                </div>
                            </td>
                        </tr>
                    </aura:iteration>
                </tbody>
            </table>
        </div>
        <aura:set attribute="else">
            <div class="slds-page-header">
                <div class="slds-page-header__row">
                    <div class="slds-page-header__col-title">
                        <div class="slds-media">
                            <div class="slds-media__body">
                                <div class="slds-page-header__name">
                                    <div class="slds-page-header__name-title">
                                        <h1>
                                            <span class="slds-page-header__title slds-truncate" title="Rohde Corp - 80,000 Widgets">{!v.RPPCalculator.Name}</span>
                                        </h1>
                                    </div>
                                </div>
                                <p class="slds-page-header__name-meta">Created by {!v.RPPCalculator.CreatedBy.Name} on <ui:outputDate value="{!v.RPPCalculator.CreatedDate}"/></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <lightning:tabset selectedTabId="{!v.selectedTab}" variant="default">
                <lightning:tab label="{!$Label.c.RPP_CONFIG}" id="config">
                    <article>
                        <div class="slds-card__body slds-card__body_inner">
                            <ul class="slds-grid slds-wrap slds-grid_pull-padded">
                                <li class="slds-p-horizontal_small slds-size_1-of-1 slds-medium-size_1-of-2">
                                    <article class="slds-tile slds-media slds-card__tile slds-hint-parent">
                                        <div class="slds-media__body">
                                            <div class="slds-tile__detail">
                                                <table class="slds-table slds-table_cell-buffer slds-table_bordered slds-m-top_small">
                                                    <thead>
                                                        <tr class="slds-line-height_reset">
                                                            <th scope="col">
                                                                <div class="slds-truncate">
                                                                    {!$Label.c.RPP_Config_Section_1}
                                                                </div>
                                                            </th>
                                                        </tr>
                                                    </thead>
                                                </table>
                                                <table class="slds-table slds-table_cell-buffer slds-table_bordered slds-m-top_small">
                                                    <tbody>
                                                        <tr class="slds-hint-parent">
                                                            <td>
                                                                <div class="slds-truncate">
                                                                    <ui:outputText value="{!v.RPPCalculatorFields.target__c}"/>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <div class="slds-truncate slds-text-align_right">
                                                                    <ui:outputText value="{!v.RPPCalculator.Target__c}"/>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <tr class="slds-hint-parent">
                                                            <td>
                                                                <div class="slds-truncate">
                                                                    <ui:outputText value="{!v.RPPCalculatorFields.target_rating_sim__c}"/>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <div class="slds-truncate slds-text-align_right">
                                                                    <ui:outputText value="{!v.RPPCalculator.Target_Rating_Sim__c}"/>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <tr class="slds-hint-parent">
                                                            <td>
                                                                <div class="slds-truncate">
                                                                    <ui:outputText value="{!v.RPPCalculatorFields.prefixed_first_loss__c}"/>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <div class="slds-truncate slds-text-align_right">
                                                                    <ui:outputNumber value="{!v.RPPCalculator.Prefixed_First_Loss__c}"/>%
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                                <table class="slds-table slds-table_cell-buffer slds-table_bordered slds-m-top_small">
                                                    <thead>
                                                        <tr class="slds-line-height_reset">
                                                            <th scope="col">
                                                                <div class="slds-truncate">
                                                                    {!$Label.c.RPP_Config_Section_2}
                                                                </div>
                                                            </th>
                                                        </tr>
                                                    </thead>
                                                </table>
                                                <table class="slds-table slds-table_cell-buffer slds-table_bordered slds-m-top_small">
                                                    <tbody>
                                                        <tr class="slds-hint-parent">
                                                            <td>
                                                                <div class="slds-truncate">
                                                                    <ui:outputText value="{!v.RPPCalculatorFields.obligors_debtors_number__c}"/>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <div class="slds-truncate slds-text-align_right">
                                                                    <ui:outputNumber value="{!v.RPPCalculator.Obligors_Debtors_Number__c}"/>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <tr class="slds-hint-parent">
                                                            <td>
                                                                <div class="slds-truncate">
                                                                    <ui:outputText value="{!v.RPPCalculatorFields.average_portfolio_dilution__c}"/>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <div class="slds-truncate slds-text-align_right">
                                                                    <ui:outputNumber value="{!v.RPPCalculator.Average_Portfolio_Dilution__c}"/>%
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <tr class="slds-hint-parent">
                                                            <td>
                                                                <div class="slds-truncate">
                                                                    <ui:outputText value="{!v.RPPCalculatorFields.max_unrated_limit__c}"/>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <div class="slds-truncate slds-text-align_right">
                                                                    <ui:outputNumber value="{!v.RPPCalculator.Max_Unrated_Limit__c}"/>%
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <tr class="slds-hint-parent">
                                                            <td>
                                                                <div class="slds-truncate">
                                                                    <ui:outputText value="{!v.RPPCalculatorFields.unrated_pd_equivalency__c}"/>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <div class="slds-truncate slds-text-align_right">
                                                                    <ui:outputText value="{!v.RPPCalculator.Unrated_PD_Equivalency__c}"/>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <tr class="slds-hint-parent">
                                                            <td>
                                                                <div class="slds-truncate">
                                                                    <ui:outputText value="{!v.RPPCalculatorFields.seller_internal_rating__c}"/>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <div class="slds-truncate slds-text-align_right">
                                                                    <ui:outputText value="{!v.RPPCalculator.Seller_Internal_Rating__c}"/>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <tr class="slds-hint-parent">
                                                            <td>
                                                                <div class="slds-truncate">
                                                                    <ui:outputText value="{!v.RPPCalculatorFields.mean_dilution__c}"/>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <div class="slds-truncate slds-text-align_right">
                                                                    <ui:outputNumber value="{!v.RPPCalculator.Mean_Dilution__c}"/>%
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <tr class="slds-hint-parent">
                                                            <td>
                                                                <div class="slds-truncate">
                                                                    <ui:outputText value="{!v.RPPCalculatorFields.mean_dilution_deviation__c}"/>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <div class="slds-truncate slds-text-align_right">
                                                                    <ui:outputNumber value="{!v.RPPCalculator.Mean_Dilution_Deviation__c}"/>%
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </article>
                                </li>
                                <li class="slds-p-horizontal_small slds-size_1-of-1 slds-medium-size_1-of-2">
                                    <article class="slds-tile slds-media slds-card__tile slds-hint-parent">
                                        <div class="slds-media__body">
                                            <div class="slds-tile__detail">
                                                <table class="slds-table slds-table_cell-buffer slds-table_bordered slds-m-top_small">
                                                    <thead>
                                                        <tr class="slds-line-height_reset">
                                                            <th scope="col">
                                                                <div class="slds-truncate">
                                                                    {!$Label.c.RPP_Config_Section_3}
                                                                </div>
                                                            </th>
                                                        </tr>
                                                    </thead>
                                                </table>
                                                <table class="slds-table slds-table_cell-buffer slds-table_bordered slds-m-top_small">
                                                    <tbody>
                                                        <tr class="slds-hint-parent">
                                                            <td>
                                                                <div class="slds-truncate">
                                                                    <ui:outputText value="{!v.RPPCalculatorFields.insurer__c}"/>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <div class="slds-truncate slds-text-align_right">
                                                                    <ui:outputText value="{!v.RPPCalculator.Insurer__c}"/>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <tr class="slds-hint-parent">
                                                            <td>
                                                                <div class="slds-truncate">
                                                                    <ui:outputText value="{!v.RPPCalculatorFields.insurer_limit__c}"/>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <div class="slds-truncate slds-text-align_right">
                                                                    <ui:outputNumber value="{!v.RPPCalculator.Insurer_Limit__c}"/>%
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <tr class="slds-hint-parent">
                                                            <td>
                                                                <div class="slds-truncate">
                                                                    <ui:outputText value="{!v.RPPCalculatorFields.insurer_name__c}"/>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <div class="slds-truncate slds-text-align_right">
                                                                    <ui:outputText value="{!v.RPPCalculator.Insurer_Name__c}"/>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <tr class="slds-hint-parent">
                                                            <td>
                                                                <div class="slds-truncate">
                                                                    <ui:outputText value="{!v.RPPCalculatorFields.insurer_internal_rating__c}"/>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <div class="slds-truncate slds-text-align_right">
                                                                    <ui:outputText value="{!v.RPPCalculator.Insurer_Internal_Rating__c}"/>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                                <table class="slds-table slds-table_cell-buffer slds-table_bordered slds-m-top_small">
                                                    <thead>
                                                        <tr class="slds-line-height_reset">
                                                            <th scope="col">
                                                                <div class="slds-truncate">
                                                                    {!$Label.c.RPP_Config_Section_4}
                                                                </div>
                                                            </th>
                                                        </tr>
                                                    </thead>
                                                </table>
                                                <table class="slds-table slds-table_cell-buffer slds-table_bordered slds-m-top_small">
                                                    <tbody>
                                                        <tr class="slds-hint-parent">
                                                            <td>
                                                                <div class="slds-truncate">
                                                                    <ui:outputText value="{!v.RPPCalculatorFields.number_of_simulations__c}"/>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <div class="slds-truncate slds-text-align_right">
                                                                    <ui:outputNumber value="{!v.RPPCalculator.Number_Of_Simulations__c}"/>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <tr class="slds-hint-parent">
                                                            <td>
                                                                <div class="slds-truncate">
                                                                    <ui:outputText value="{!v.RPPCalculatorFields.lgd_capital__c}"/>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <div class="slds-truncate slds-text-align_right">
                                                                    <ui:outputNumber value="{!v.RPPCalculator.LGD_Capital__c}"/>%
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <tr class="slds-hint-parent">
                                                            <td>
                                                                <div class="slds-truncate">
                                                                    <ui:outputText value="{!v.RPPCalculatorFields.maturity__c}"/>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <div class="slds-truncate slds-text-align_right">
                                                                    <ui:outputNumber value="{!v.RPPCalculator.Maturity__c}" format="#0.00"/>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </article>
                                </li>
                            </ul>
                        </div>
                    </article>
                </lightning:tab>
                <lightning:tab label="{!$Label.c.RPP_Google_Sheet}" id="googlesheet">
                    <div>
                        <aura:if isTrue="{!v.hasPermission}">
                            <aura:if isTrue="{!v.showSimulationButtons}">
                                <div class="slds-text-align_center">
                                    <lightning:button class="slds-button_brand" label="{!$Label.c.RPP_Get_Ratings}" onclick="{!c.handleOnGetRatings}"/>
                                </div>
                            </aura:if>
                        </aura:if>
                        <table class="slds-table slds-table_cell-buffer slds-table_bordered slds-m-top_small">
                            <thead>
                                <tr class="slds-line-height_reset">
                                    <th scope="col">
                                        <div class="slds-truncate"></div>
                                    </th>
                                    <th scope="col">
                                        <div class="slds-truncate"></div>
                                    </th>
                                    <th scope="col">
                                        <div class="slds-truncate">{!v.RPPCalculatorFields.tax_id__c}</div>
                                    </th>
                                    <th scope="col">
                                        <div class="slds-truncate"></div>
                                    </th>
                                    <th scope="col">
                                        <div class="slds-truncate">{!v.RPPCalculatorFields.seller_assignor__c}</div>
                                    </th>
                                    <th scope="col">
                                        <div class="slds-truncate"></div>
                                    </th>
                                    <th scope="col">
                                        <div class="slds-truncate"></div>
                                    </th>
                                    <th scope="col">
                                        <div class="slds-truncate"></div>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="slds-hint-parent">
                                    <td>
                                        <div class="slds-truncate">
                                            <ui:outputText value=""/>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="slds-truncate">
                                            <ui:outputText value=""/>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="slds-truncate">
                                            <ui:outputText value="{!v.RPPCalculator.Tax_Id__c}"/>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="slds-truncate">
                                            <ui:outputText value=""/>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="slds-truncate">
                                            <ui:outputText value="{!v.RPPCalculator.Seller_Assignor__c}"/>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="slds-truncate">
                                            <ui:outputText value=""/>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="slds-truncate">
                                            <ui:outputText value=""/>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="slds-truncate">
                                            <ui:outputText value=""/>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                            <br></br>
                            <thead>
                                <tr class="slds-line-height_reset">
                                    <th scope="col">
                                        <div class="slds-truncate slds-text-align_right">{!v.RPPCalculatorDebtorFields.number__c}</div>
                                    </th>
                                    <th scope="col">
                                        <div class="slds-truncate slds-text-align_right">{!v.RPPCalculatorDebtorFields.insurer_internal_rating__c}</div>
                                    </th>
                                    <th scope="col">
                                        <div class="slds-truncate">{!v.RPPCalculatorDebtorFields.tax_id__c}</div>
                                    </th>
                                    <th scope="col">
                                        <div class="slds-truncate">{!v.RPPCalculatorDebtorFields.lei__c}</div>
                                    </th>
                                    <th scope="col">
                                        <div class="slds-truncate">{!v.RPPCalculatorDebtorFields.obligor_debtor__c}</div>
                                    </th>
                                    <th scope="col">
                                        <div class="slds-truncate">{!v.RPPCalculatorDebtorFields.currency__c}</div>
                                    </th>
                                    <th scope="col">
                                        <div class="slds-truncate slds-text-align_right">{!v.RPPCalculatorDebtorFields.total_amount_local__c}</div>
                                    </th>
                                    <th scope="col">
                                        <div class="slds-truncate slds-text-align_right">{!v.RPPCalculatorDebtorFields.authorised_limit_local__c}</div>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <aura:iteration items="{!v.RPPCalculatorDebtors}" var="RPPCalculatorDebtor">
                                    <tr class="slds-hint-parent">
                                        <td>
                                            <div class="slds-truncate slds-text-align_right">
                                                <ui:outputNumber value="{!RPPCalculatorDebtor.Number__c}"/>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="slds-truncate slds-text-align_right">
                                                <ui:outputText value="{!RPPCalculatorDebtor.Insurer_Internal_Rating__c}"/>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="slds-truncate">
                                                <ui:outputText value="{!RPPCalculatorDebtor.Tax_Id__c}"/>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="slds-truncate">
                                                <ui:outputText value="{!RPPCalculatorDebtor.LEI__c}"/>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="slds-truncate">
                                                <ui:outputText value="{!RPPCalculatorDebtor.Obligor_Debtor__c}"/>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="slds-truncate">
                                                <ui:outputText value="{!RPPCalculatorDebtor.Currency__c}"/>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="slds-truncate slds-text-align_right">
                                                <ui:outputNumber value="{!RPPCalculatorDebtor.Total_Amount_Local__c}" format="#,###,###,###,###,##0.00"/>
                                            </div>
