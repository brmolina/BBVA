                                            <lightning:button class="slds-button slds-button_brand " label="{!$Label.c.RPP_Simulate}" onclick="{!c.handleOnSimulate}"/>
                                            <aura:set attribute="else">
                                                <lightning:button class="slds-button slds-button_brand " label="{!$Label.c.RPP_Select_As_Final_Simulation}" onclick="{!c.handleOnSetFinalSimulation}"/>
                                            </aura:set>
                                        </aura:if>
                                    </aura:if>
                                </aura:if>
                            </div>
                        </div>
                        <lightning:tabset selectedTabId="{!v.selectedSimTab}" variant="default">
