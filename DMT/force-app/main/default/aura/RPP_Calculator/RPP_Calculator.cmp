                                <h2>{!$Label.c.RPP_THIS_IS_THE_FINAL_SIMULATION}</h2>
                            </div>
                        </aura:if>
                        <div class="slds-grid slds-wrap slds-m-bottom_medium">
                            <div class="slds-col slds-size_1-of-4">
                                <lightning:select name="selectedOption" aura:id="selectedOption" label="{!$Label.c.RPP_Select_Simulation}" required="true" value="{!v.selectedSimulation}" onchange="{!c.handleOnGetSimulationData}">
                                    <aura:iteration items="{!v.simulationsWrapperList}" var="simulationsWrapperElement">
                                        <option text="{!simulationsWrapperElement.name}" value="{!simulationsWrapperElement.id}" selected="{!simulationsWrapperElement.selected}"/>
                                    </aura:iteration>
                                </lightning:select>
                            </div>
