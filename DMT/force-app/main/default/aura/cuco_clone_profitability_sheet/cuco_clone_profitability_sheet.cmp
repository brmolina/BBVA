<aura:component implements="lightning:actionOverride,force:lightningQuickActionWithoutHeader,force:hasRecordId,force:hasSObjectName" access="global" controller="CucoCloneProfitabilitySheet_Ctrl">
  <aura:handler event="force:refreshView" action="{!c.doInit}" />
  <aura:attribute name="conditionsSelected" type="Object" />
  <aura:attribute name="recordId" type="String" />
  <aura:attribute name="conditions" type="Object" />
  <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
  <aura:attribute name="clonefr" type="Boolean" default="true" />
  <aura:attribute name="clonesc" type="Boolean" default="true" />
  <aura:set attribute="title" value="{!$Label.c.cuco_clone_title}" />
  <aura:set attribute="modalSizeSLDS" value="slds-modal_small" />
  <aura:attribute name="errors" type="Object" />
  <aura:attribute name="waiting" type="Boolean" default="false" />
  <aura:html tag="style">
      .cuf-content {
          padding: 0 0rem !important;
      }
      .slds-p-around--medium {
          padding: 0rem !important;
      }
      .slds-modal__content{
          overflow-y:hidden !important;
          height:unset !important;
          max-height:unset !important;
      }
  </aura:html>
  <div class="modal-header slds-modal__header slds-size_1-of-1">
    <h4 class="title slds-text-heading--medium" >{!$Label.c.cuco_clone_title}</h4>
  </div>
  <div class="slds-modal__content slds-p-around--x-small slds-align_absolute-center slds-size_1-of-1 slds-is-relative" aura:id="modalbody" id="modalbody">
    <aura:if isTrue="{!v.waiting}">
      <lightning:spinner variant="brand" alternativeText="Loading" />
    </aura:if >
    <lightning:recordEditForm aura:id="cloneForm" objectApiName="cuco__profitability_analysis__c" class="slds-card__body_inner slds-size_5-of-6">
      <lightning:messages/>
      <div class="slds-grid">
        <div class="slds-col slds-size_2-of-2">
          <lightning:inputField fieldName="Name" aura:id="name" required="true"/>
        </div>
      </div>
      <div class="slds-grid">
        <div class="slds-col slds-size_2-of-2">
          <lightning:inputField fieldName="cuco__participant_id__c" aura:id="group" required="true"/>
        </div>
      </div>
      <div class="slds-grid slds-var-p-around_large">
        <div class="slds-col slds-size_1-of-2">
          <lightning:input type="toggle" label="Clone Flat Rates" aura:id="clonefr" name="clonefr" messageToggleActive="" messageToggleInactive="" onchange="{!c.handleCheckBox}" checked="{!v.clonefr}"/>
        </div>
        <div class="slds-col slds-size_1-of-2">
          <lightning:input type="toggle" label="Clone Conditions" aura:id="clonesc" name="clonesc" messageToggleActive="" messageToggleInactive="" onchange="{!c.handleCheckBox}" checked="{!v.clonesc}"/>
        </div>
      </div>
    </lightning:recordEditForm>
  </div>
  <div class="modal-footer slds-modal__footer slds-size_1-of-1">
    <lightning:button label="{!$Label.cuco.cancel}" onclick="{!c.handleCancel}" disabled="{!v.waiting}" class="slds-m-top_none" />
    <lightning:button label="{!$Label.c.cuco_clone_submit}" onclick="{!c.handleOnSubmit}" disabled="{!v.waiting}" variant="brand" class="slds-m-top_none" />
  </div>
</aura:component>