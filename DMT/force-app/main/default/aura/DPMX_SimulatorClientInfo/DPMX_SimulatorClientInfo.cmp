                -->
                <tr class="slds-hint-parent">
                    <th scope="row">
                        <div class="slds-truncate">{!$Label.c.DPMX_InformationDetail_Client_Information_Product5}</div>
                    </th>
                    <aura:if isTrue="{!v.isCustom}">
                        <td>
                            <div class="slds-truncate">
                                <c:DPMX_DynamicTableField fieldType="INTEGER" fieldValue="{!v.acquirerActivitiesWrapper.transaction_y.international}" />
                            </div>
                        </td>
                    </aura:if>
                    <td>
                        <div class="slds-truncate">
                            <ui:inputNumber value="{!v.dynamicPricingUpsert.Sim_Transaction_International__c}" />
                        </div>
                    </td>
                    <aura:if isTrue="{!v.isCustom}">
                        <td>
                            <div class="slds-truncate">
                                <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!v.acquirerActivitiesWrapper.billing.international.amount}" currencyText="{!v.acquirerActivitiesWrapper.billing.international.currency_y}" />
                            </div>
                        </td>
                    </aura:if>
                    <td>
                        <div class="slds-truncate">
                            <ui:inputNumber value="{!v.dynamicPricingUpsert.Sim_Billing_International_Amount__c}" />
                        </div>
                    </td>
                    <aura:if isTrue="{!v.isCustom}">
                        <td>
                            <div class="slds-truncate">
                                <c:DPMX_DynamicTableField fieldType="CURRENCY" fieldValue="{!v.acquirerActivitiesWrapper.tickets.international.amount}" currencyText="{!v.acquirerActivitiesWrapper.tickets.international.currency_y}" />
                            </div>
                        </td>
                    </aura:if>
                    <td>
                        <div class="slds-truncate">
                            <ui:inputNumber value="{!v.dynamicPricingUpsert.Sim_Tickets_International_Amount__c}" />
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <footer class="slds-modal__footer">
        <lightning:button label="{!$Label.c.DPMX_Cancel}" onclick="{!c.handleOnCancel}" disabled="{!v.waiting}" class="slds-m-top_none" />
        <lightning:button label="{!$Label.c.DPMX_Save}" onclick="{!c.handleOnSave}" disabled="{!v.waiting}" variant="brand" class="slds-m-top_none" />
    </footer>
</aura:component>