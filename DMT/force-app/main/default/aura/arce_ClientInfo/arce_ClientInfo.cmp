                </td>
            </tr>
            <tr class="slds-hint-parent">
                <td>
                    <lightning:buttonIcon onclick="{!c.handleMostrarInfo2}" iconName="utility:hierarchy" alternativeText="ShadowBanking" title="ShadowBanking" />
                </td>
                <td>
                    <div class="slds-truncate">
                        <c:DPMX_DynamicTableField fieldType="STRING" fieldValue="Test Insurance" />
                    </div>
                </td>
                <td>
                    <div class="slds-truncate">
                        <c:DPMX_DynamicTableField fieldType="DATE" fieldValue="" />
                    </div>
                </td>
                <td>
                    <div class="slds-truncate">
                        <c:DPMX_DynamicTableField fieldType="DATE" fieldValue="" />
                    </div>
                </td>
            </tr>
        <tr class="slds-hint-parent">
            <td>
                <lightning:buttonIcon onclick="{!c.handleMostrarInfo3}" iconName="utility:hierarchy" alternativeText="ShadowBanking" title="ShadowBanking" />
            </td>
            <td>
                <div class="slds-truncate">
                    <c:DPMX_DynamicTableField fieldType="STRING" fieldValue="Test Corpo" />
                </div>
            </td>
            <td>
                <div class="slds-truncate">
                    <c:DPMX_DynamicTableField fieldType="DATE" fieldValue="" />
                </div>
            </td>
