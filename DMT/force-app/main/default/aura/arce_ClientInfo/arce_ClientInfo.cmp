        </tr>
        <tr class="slds-hint-parent">
            <td>
                <lightning:buttonIcon onclick="{!c.handleMostrarInfo4}" iconName="utility:hierarchy" alternativeText="ShadowBanking" title="ShadowBanking" />
            </td>
            <td>
                <div class="slds-truncate">
                    <c:DPMX_DynamicTableField fieldType="STRING" fieldValue="Test Funds" />
                </div>
            </td>
            <td>
                <div class="slds-truncate">
                    <c:DPMX_DynamicTableField fieldType="DATE" fieldValue="" />
                </div>
            </td>
            <td>
                <div class="slds-truncate">
                    <c:DPMX_DynamicTableField fieldType="DATE" fieldValue="" />
                </div>
            </td>
        </tr>
        -->
    </table>
    {!v.body}
</aura:component>