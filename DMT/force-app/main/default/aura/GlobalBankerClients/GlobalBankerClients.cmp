<aura:component implements="force:hasSObjectName,force:hasRecordId,flexipage:availableForAllPageTypes"
                controller="GlobalBankerClientsController" access="global">
                <aura:attribute type="DES_BBVA_Management_team__c[]" name="acctList"/>
                <aura:attribute name="mycolumns" type="List"/>
                <aura:attribute name="recordId" type="Id" />

                <aura:handler name="init" value="{!this}" action="{!c.fetchAccounts}"/>

                <lightning:datatable data="{! v.acctList }"
                                     columns="{! v.mycolumns }"
                                     keyField="Id"
                                     hideCheckboxColumn="true"/>
</aura:component>