    <decisions>
        <name>Is_Opp_Line_Init_Date_Less_Than_Initial_Date_To_Check</name>
        <label>Is Opp Line Init Date Less Than Initial Date To Check?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Is_Opp_Line_Mat_Date_Great_Than_Maturity_Date_To_Check</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>YesInitial</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Formula_LoopEffectiveInitialDate</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>InitialDateToCheck</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Formula_LoopEffectiveInitialDate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_New_Initial_Date_To_Check</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Opp_Line_Mat_Date_Great_Than_Maturity_Date_To_Check</name>
        <label>Is Opp Line Mat Date Great Than Maturity Date To Check?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Opp_Line_Items_For_Opp</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>YesMat</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Formula_LoopEffectiveMaturityDate</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>MaturityDateToCheck</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Formula_LoopEffectiveMaturityDate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_New_Maturity_Date_To_Check</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>New_Initial_Date_To_Set</name>
        <label>New Initial Date To Set?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>New_Maturity_Date_To_Set</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>YesNewInitial</name>
            <conditionLogic>(1 AND 2 AND 3) OR (2 AND 4)</conditionLogic>
            <conditions>
                <leftValueReference>InitialDateToCheck</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>ActualOppInitDate</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Opportunity.DMT_Initial_Date_Changed__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ActualOppInitDate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
