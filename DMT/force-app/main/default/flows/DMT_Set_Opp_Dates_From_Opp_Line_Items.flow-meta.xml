    <environments>Default</environments>
    <formulas>
        <name>Formula_LoopEffectiveInitialDate</name>
        <dataType>Date</dataType>
        <expression>IF(
    AND(
        TEXT({!Loop_Opp_Line_Items_For_Opp.DMT_Line_Oneoffdeal__c}) = &quot;Line&quot;,
        {!Loop_Opp_Line_Items_For_Opp.DMT_Line_Tenor__c} &gt; 0,
        ISBLANK({!Loop_Opp_Line_Items_For_Opp.gf_initial_date__c})
    ),
    TODAY(),
    {!Loop_Opp_Line_Items_For_Opp.gf_initial_date__c}
)</expression>
    </formulas>
    <formulas>
        <name>Formula_LoopEffectiveMaturityDate</name>
        <dataType>Date</dataType>
        <expression>IF(
    AND(
        TEXT({!Loop_Opp_Line_Items_For_Opp.DMT_Line_Oneoffdeal__c}) = &quot;Line&quot;,
        {!Loop_Opp_Line_Items_For_Opp.DMT_Line_Tenor__c} &gt; 0
    ),
    {!Formula_LoopEffectiveInitialDate} + {!Loop_Opp_Line_Items_For_Opp.DMT_Line_Tenor__c},
    {!Loop_Opp_Line_Items_For_Opp.gf_maturity_date__c}
)</expression>
    </formulas>
    <formulas>
        <name>Formula_RecordEffectiveInitialDate</name>
        <dataType>Date</dataType>
        <expression>IF(
    AND(
        TEXT({!$Record.DMT_Line_Oneoffdeal__c}) = &quot;Line&quot;,
        {!$Record.DMT_Line_Tenor__c} &gt; 0,
        ISBLANK({!$Record.gf_initial_date__c})
    ),
    TODAY(),
    {!$Record.gf_initial_date__c}
)</expression>
    </formulas>
    <formulas>
        <name>Formula_RecordEffectiveMaturityDate</name>
        <dataType>Date</dataType>
        <expression>IF(
    AND(
        TEXT({!$Record.DMT_Line_Oneoffdeal__c}) = &quot;Line&quot;,
        {!$Record.DMT_Line_Tenor__c} &gt; 0
    ),
    {!Formula_RecordEffectiveInitialDate} + {!$Record.DMT_Line_Tenor__c},
    {!$Record.gf_maturity_date__c}
)</expression>
    </formulas>
