    <formulas>
        <name>formula_TRUE_myRule_11</name>
        <dataType>Boolean</dataType>
        <expression>AND(
TEXT({!$Record.opportunity_stage_type__c}) != $Label.DES_Closed_Lose,
TEXT({!$Record.opportunity_stage_type__c}) != $Label.DES_Closed_Won,
TEXT({!$Record.Opportunity.StageName}) != $Label.DES_Closed_Lose,
TEXT({!$Record.Opportunity.StageName}) != $Label.DES_Closed_Won,
NOT(AND(
	OR(
		PRIORVALUE({!$Record.Opportunity.Template_pending_approval_type__c}) == true,
		PRIORVALUE({!$Record.Opportunity.Template_approved_type__c}) == true
	),
	{!$Record.Opportunity.Template_pending_approval_type__c} == false,
	{!$Record.Opportunity.Template_approved_type__c} == false
)),

	NOT(AND(TEXT(PRIORVALUE({!$Record.opportunity_nbc_recm_ind_type__c})) != &apos;N.A.&apos;, TEXT({!$Record.opportunity_nbc_recm_ind_type__c}) == &apos;N.A.&apos;)),

ISCHANGED({!$Record.LastModifiedDate}),
TEXT({!$Record.Opportunity.NBC_Decision_Taken_type__c}) != $Label.NBC_Decision_Not_Recommended,
TEXT({!$Record.Opportunity.NBC_Decision_Taken_type__c}) != $Label.NBC_Decision_Recommended,
OR(NOT({!$Record.Opportunity.Template_pending_approval_type__c}),TEXT({!$Record.Opportunity.NBC_Decision_Taken_type__c}) = $Label.NBC_Decision_Pending, TEXT({!$Record.Opportunity.NBC_Decision_Taken_type__c}) = $Label.NBC_Decision_Outdated),
OR({!$Record.solution_classification_desc__c} ==$Label.DES_Corporate_Loans,
{!$Record.solution_classification_desc__c} ==$Label.DES_Leverage_Buyout_LBOs,
{!$Record.solution_classification_desc__c} ==$Label.DES_Structure_Trade_Finance,
{!$Record.solution_classification_desc__c} ==$Label.DES_Transaction_Trade_Finance,
{!$Record.solution_classification_desc__c} ==$Label.DES_Working_Capital,
{!$Record.solution_classification_desc__c} ==$Label.DES_Project_Finance_Lending))</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_4</name>
        <dataType>Boolean</dataType>
        <expression>AND(
NOT(ISBLANK(PRIORVALUE({!$Record.DES_Product_Specialist__c}))),
ISCHANGED({!$Record.DES_Product_Specialist__c} )
)</expression>
    </formulas>
