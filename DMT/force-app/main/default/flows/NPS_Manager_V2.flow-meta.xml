    <decisions>
        <name>is_valid_NPS</name>
        <label>is valid NPS?</label>
        <locationX>774</locationX>
        <locationY>701</locationY>
        <defaultConnector>
            <targetReference>updateNPSContact</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>no_active_wave</name>
            <conditionLogic>(1 AND 2 AND (3 OR 4) AND 5) OR 6</conditionLogic>
            <conditions>
                <leftValueReference>contact.survey_nps_contact_type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>NPS_2020</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Flow.CurrentDate</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>wave_country_record.nps_start_date__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Flow.CurrentDate</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>wave_country_record.nps_end_date__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>contact.DES_Client_NPS__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>country_wave_variable</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>No_country_wave_error</targetReference>
            </connector>
            <label>no active wave</label>
        </rules>
    </decisions>
