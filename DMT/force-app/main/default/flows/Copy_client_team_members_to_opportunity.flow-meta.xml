<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Client_team_members_to_Opportunity</name>
        <label>Assign Client team members to Opportunity</label>
        <locationX>840</locationX>
        <locationY>198</locationY>
        <assignmentItems>
            <assignToReference>SO_Opportunity_Team_Member.OpportunityId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SO_Opportunity_Team_Member.TeamMemberRole</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Account_Team_Member_inLoop.TeamMemberRole</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SO_Opportunity_Team_Member.UserId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Account_Team_Member_inLoop.UserId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Put_all_Opportunity_team_members_together</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Put_all_Opportunity_team_members_together</name>
        <label>Put all Opportunity team members together</label>
        <locationX>875</locationX>
        <locationY>36</locationY>
        <assignmentItems>
            <assignToReference>SOC_OpportunityTeamMembers</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>SO_Opportunity_Team_Member</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>DisplayMembers</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>TeamList</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>DisplayMembers</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>NewLine</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Go_through_the_Client_team_members</targetReference>
        </connector>
    </assignments>
    <choices>
        <name>add_No</name>
        <choiceText>No</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>No</stringValue>
        </value>
    </choices>
    <choices>
        <name>add_Yes</name>
        <choiceText>Yes</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Yes</stringValue>
        </value>
    </choices>
    <decisions>
        <name>Check_opportunity_team_is_empty</name>
        <label>Check opportunity team is empty</label>
        <locationX>762</locationX>
        <locationY>314</locationY>
        <defaultConnector>
            <targetReference>There_already_is_a_team</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Existing team members</defaultConnectorLabel>
        <rules>
            <name>No_existing_team_members</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>SOC_ExistingOpportunityTeam</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Opp_team_members</targetReference>
            </connector>
            <label>No existing team members</label>
        </rules>
    </decisions>
    <decisions>
        <name>Wants_to_proceed</name>
        <label>Wants to proceed?</label>
        <locationX>315</locationX>
        <locationY>330</locationY>
        <defaultConnector>
            <targetReference>Action_cancelled</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Do not proceed</defaultConnectorLabel>
        <rules>
            <name>Proceed_with_copy</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Do_you_want_to_proceed_to_copy_from_Client_team</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>add_Yes</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_the_opportunity_team</targetReference>
            </connector>
            <label>Proceed with copy</label>
        </rules>
    </decisions>
    <description>Proceso para copiar de manera manual el equipo de cuenta en una oportunidad</description>
    <formulas>
        <name>GetUserName</name>
        <dataType>String</dataType>
        <expression>&quot; &quot; &amp; {!SO_Opportunity_Team_Member.User.FirstName} &amp; &quot; &quot; &amp; {!SO_Opportunity_Team_Member.User.LastName}</expression>
    </formulas>
    <interviewLabel>Copy client team members to opportunity {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Copy client team members to opportunity</label>
    <loops>
        <name>Go_through_the_Client_team_members</name>
        <label>Go through the Client team members</label>
        <locationX>563</locationX>
        <locationY>47</locationY>
        <assignNextValueToReference>Account_Team_Member_inLoop</assignNextValueToReference>
        <collectionReference>SOC_Account_team_members</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Client_team_members_to_Opportunity</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Warning_Screen</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Opp_team_members</name>
        <label>Create Opp team members</label>
        <locationX>1042</locationX>
        <locationY>324</locationY>
        <inputReference>SOC_OpportunityTeamMembers</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Get_all_the_account_team</name>
        <label>Get all the account team</label>
        <locationX>292</locationX>
        <locationY>57</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Go_through_the_Client_team_members</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>CLIENT_ID</elementReference>
            </value>
        </filters>
        <object>AccountTeamMember</object>
        <outputReference>SOC_Account_team_members</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>TeamMemberRole</queriedFields>
        <queriedFields>UserId</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Opportunity_Data</name>
        <label>Get Opporunity Data</label>
        <locationX>92</locationX>
        <locationY>59</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_all_the_account_team</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <object>Opportunity</object>
        <outputAssignments>
            <assignToReference>CLIENT_ID</assignToReference>
            <field>AccountId</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <name>Get_the_opportunity_team</name>
        <label>Get the opportunity team</label>
        <locationX>563</locationX>
        <locationY>332</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_opportunity_team_is_empty</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <object>OpportunityTeamMember</object>
        <outputReference>SOC_ExistingOpportunityTeam</outputReference>
        <queriedFields>Id</queriedFields>
    </recordLookups>
