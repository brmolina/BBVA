<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Validated</name>
        <label>Validated?</label>
        <locationX>164</locationX>
        <locationY>200</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Validated_or_Pending_Validation</name>
            <conditionLogic>2 OR (1 AND 3)</conditionLogic>
            <conditions>
                <leftValueReference>currentAPcheck.acpl__gf_ap_status_type_name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Validated</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>currentAPcheck.acpl__gf_ap_status_type_name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending Validation</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>currentAPcheck.acpl__gf_ap_substatus_type_name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>In place</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>screenBlocked</targetReference>
            </connector>
            <label>Validated or Pending Validation</label>
        </rules>
        <rules>
            <name>Blocked</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>currentAPcheck.acpl__gf_ap_indvi_lock_edit_ind_type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>screenBlocked_0</targetReference>
            </connector>
            <label>Blocked</label>
        </rules>
        <rules>
            <name>In_Progress</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>currentAPcheck.acpl__gf_ap_status_type_name__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Pending Validation</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>currentAPcheck.acpl__gf_ap_substatus_type_name__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>In place</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>toggleSubflow</targetReference>
            </connector>
            <label>In Progress</label>
        </rules>
    </decisions>
    <description>Only available for non Validated and non Pending-Validation APs</description>
    <interviewLabel>Account Planning Privacy Control {!$Flow.CurrentDateTime}</interviewLabel>
