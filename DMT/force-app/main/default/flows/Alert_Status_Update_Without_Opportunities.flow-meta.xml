<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Overdue_Without_Opps</name>
        <label>Overdue Without Opps</label>
        <locationX>441</locationX>
        <locationY>151</locationY>
        <assignmentItems>
            <assignToReference>CurrentAlert.DES_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Overdue</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Overdue_Alert</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Opportunity_Counter</name>
        <label>Opportunity Counter</label>
        <locationX>361</locationX>
        <locationY>47</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Any_Opportunity</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>SOC_OpportunitiesLinked</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Alert_Update_when_the_Alert_is_modified</targetReference>
            </connector>
            <label>Any Opportunity</label>
        </rules>
        <rules>
            <name>No_Opportunities</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>SOC_OpportunitiesLinked</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CurrentAlert.DES_Maturity_Date__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Overdue_Without_Opps</targetReference>
            </connector>
            <label>No Opportunities</label>
        </rules>
    </decisions>
    <interviewLabel>Alert Status Update Without Opportunities {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Alert Status Update Without Opportunities</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Alert_Id_Stage_Lookup</name>
