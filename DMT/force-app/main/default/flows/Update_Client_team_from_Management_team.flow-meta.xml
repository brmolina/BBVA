    <decisions>
        <name>Is_the_user_populated</name>
        <label>Is the user populated?</label>
        <locationX>311</locationX>
        <locationY>190</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>User_populated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>SO_CurrentTeamMember.DES_User__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Was_the_user_id_previously_populated</targetReference>
            </connector>
            <label>User populated</label>
        </rules>
        <rules>
            <name>User_not_populated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>SO_CurrentTeamMember.DES_User__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>User not populated</label>
        </rules>
    </decisions>
    <decisions>
        <name>Was_the_user_id_previously_populated</name>
        <label>Was the user id previously populated?</label>
        <locationX>555</locationX>
        <locationY>190</locationY>
        <defaultConnector>
            <targetReference>Create_new_team_member</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>User has not changed</defaultConnectorLabel>
        <rules>
            <name>User_has_changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>PRIOR_ID</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>SO_CurrentTeamMember.DES_User__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>PRIOR_ID</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Delete_existing_user</targetReference>
            </connector>
            <label>User has changed</label>
        </rules>
    </decisions>
