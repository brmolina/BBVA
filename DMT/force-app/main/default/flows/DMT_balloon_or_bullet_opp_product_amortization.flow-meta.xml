    <decisions>
        <name>check_is_bullet_or_balloon</name>
        <label>check is bullet or balloon</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>update_opli_uncheck_bullet_and_balloin</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>balloon</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>SumAMountCurrentTenorBalloon</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>valorIndicadorBalloon</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>update_opli_balloon</targetReference>
            </connector>
            <label>balloon</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if the tenor is the secondt to last</description>
        <name>isSecondToLastTenorPayment</name>
        <label>is second to last Tenor</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_1</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>counterTenorLooping</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>numberOfTenors</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>check_is_bullet_or_balloon</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>comprueba si cumple para ser bullet</description>
        <name>its_bullet_amortization</name>
        <label>its bullet amortization</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>assign_new_amount_of_tenor_to_compare</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>no_bullet</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>counterTenorLooping</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>numberOfTenors</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>previusUndrawnAmountTenorInLoop</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>iterate_tenors_to_check_bullet.gf_nominal_amount_fb__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>previusDrawnAmountTenorInLoop</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>iterate_tenors_to_check_bullet.gj_nominal_amount_db__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>uncheck</targetReference>
            </connector>
            <label>no bullet</label>
        </rules>
    </decisions>
    <decisions>
        <name>Its_bullet_amortization_opli</name>
        <label>Its bullet amortization opli</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_1</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No bullet, evaluate ballon</defaultConnectorLabel>
        <rules>
            <name>Yes_its_bullet</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>itsBulletAmortization</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>update_opli_with_bullet</targetReference>
            </connector>
            <label>Yes its bullet</label>
        </rules>
    </decisions>
    <decisions>
        <name>its_firs_loop_iteration</name>
        <label>its firs loop iteration</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>sum_counter</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Its_first_iteration</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>counterTenorLooping</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>assign_amounts_to_compare</targetReference>
            </connector>
            <label>Its first iteration</label>
        </rules>
    </decisions>
    <decisions>
        <description>Si el numero de tenors es igual a dos, significa que uno es el por defecto y el otro el que tiene amounts, por lo que debe de ser bullet</description>
        <name>Number_of_tenors_equals_2</name>
        <label>Number of tenors equals 2</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>iterate_tenors_to_check_bullet</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_only_2_tenors</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>numberOfTenors</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>2.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>update_opli_with_bullet</targetReference>
            </connector>
            <label>Yes only 2 tenors</label>
        </rules>
    </decisions>
    <decisions>
        <name>there_are_changes_on_tenor</name>
        <label>there are changes on tenor</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>yes_tenor_changed</name>
            <conditionLogic>(1 OR 2 OR 3 OR 4 OR 5 OR 6 OR 7) AND 8</conditionLogic>
            <conditions>
                <leftValueReference>$Record.gf_tenor_date__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.gf_tenor_date__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.gf_accrual_fees_bp__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.gf_accrual_fees_bp__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.gj_nominal_amount_db__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.gj_nominal_amount_db__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.gf_nominal_amount_fb__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.gf_nominal_amount_fb__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.gf_non_accrual_fees_bp__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.gf_non_accrual_fees_bp__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.gf_spread_db__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.gf_spread_db__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.gf_spread_fb__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.gf_spread_fb__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.DMT_Opportunity_Product__r.gf_amortization_type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>User-Defined</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetAllTenorsRelated</targetReference>
            </connector>
            <label>yes tenor changed</label>
        </rules>
        <rules>
            <name>change_from_user_defined_to_other</name>
            <conditionLogic>(1 OR 2) AND (3 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.DMT_Opportunity_Product__r.gf_amortization_type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Bullet</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.DMT_Opportunity_Product__r.gf_amortization_type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Linear</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.DMT_Opportunity_Product__r.DMT_bullet_amortization_indicator__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.DMT_Opportunity_Product__r.DMT_balloon_amortization_indicator__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>update_opli_uncheck_bullet_and_balloin</targetReference>
            </connector>
            <label>change from user defined to other</label>
        </rules>
    </decisions>
    <description>Indicates if the amortization user-defined is balloon or bullet</description>
    <environments>Default</environments>
    <formulas>
        <name>currentTenorAmountLoopBullet</name>
        <dataType>Currency</dataType>
        <expression>{!iterate_tenors_to_check_bullet.gj_nominal_amount_db__c}+{!iterate_tenors_to_check_bullet.gf_nominal_amount_fb__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>Indicates de total amount of current tenor in iteration</description>
        <name>SumAMountCurrentTenorBalloon</name>
        <dataType>Currency</dataType>
        <expression>{!Loop_1.gj_nominal_amount_db__c}+{!Loop_1.gf_nominal_amount_fb__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>valorIndicadorBalloon</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.DMT_Opportunity_Product__r.DMT_Deal_Amount_Tenors__c}/2</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>DMT balloon or bullet opp product amortization {!$Flow.CurrentDateTime}</interviewLabel>
    <label>DMT balloon or bullet opp product amortization</label>
    <loops>
