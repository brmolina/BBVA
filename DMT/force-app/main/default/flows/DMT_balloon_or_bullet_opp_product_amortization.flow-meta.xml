            <targetReference>Number_of_tenors_equals_2</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Reset_couter_looping</name>
        <label>Reset couter looping</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>counterTenorLooping</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Its_bullet_amortization_opli</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>sum_counter</name>
        <label>Sum counter</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>counterTenorLooping</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>its_bullet_amortization</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>sum_one_count</name>
        <label>sum one count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>counterTenorLooping</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>isSecondToLastTenorPayment</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>uncheck</name>
        <label>uncheck bullet</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>itsBulletAmortization</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Reset_couter_looping</targetReference>
        </connector>
