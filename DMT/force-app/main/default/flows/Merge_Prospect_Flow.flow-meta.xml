    <formulas>
        <name>filters_for_account_selector</name>
        <dataType>String</dataType>
        <expression>IF(
    ISPICKVAL({!get_Prospect.DES_Structure_Type__c}, &apos;Subsidiary&apos;), 
    {!cons_filter_subsidiary}, 
    IF(
            ISPICKVAL({!get_Prospect.DES_Structure_Type__c}, &apos;Group&apos;),
            {!cons_filter_group},
            {!cons_filter}
     )
)</expression>
