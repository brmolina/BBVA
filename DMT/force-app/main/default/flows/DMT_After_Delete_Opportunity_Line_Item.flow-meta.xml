        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Is_OLI_From_DMT_Opportunity_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Opportunity.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>DMT_Opportunity</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_OLI_From_Opp_With_Remaining_Product</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
