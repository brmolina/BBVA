    <description>Migrated from the Task Management process using multiple criteria.</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_TRUE_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(
	!$Setup.CIB_Bypass__c.CIB_skip_ProcessBuilder__c, 
	$Setup.CIB_User_Org__c.CIB_Is_Service__c,
	OR	(	
		AND(
			ISNEW(),
			TEXT({!$Record.gf_task_execution_team_name__c}) == $Label.SER_EGS_TeamResFUCIB_lbl
		),

		AND(
			!ISNEW(),
			ISCHANGED({!$Record.gf_task_execution_team_name__c}),
			TEXT({!$Record.gf_task_execution_team_name__c}) == $Label.SER_EGS_TeamResFUCIB_lbl
		)
	)
)</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_3</name>
        <dataType>Boolean</dataType>
        <expression>AND(
	!$Setup.CIB_Bypass__c.CIB_skip_ProcessBuilder__c, 
	$Setup.CIB_User_Org__c.CIB_Is_Service__c,
	OR	(	
		AND(
			ISNEW(),
			Not(TEXT({!$Record.gf_task_execution_team_name__c}) == $Label.SER_EGS_TeamResFUCIB_lbl),
			{!$Record.gf_task_notif_fucib_ind_type__c}  = true
		),

		AND(
			!ISNEW(),
			Not(TEXT({!$Record.gf_task_execution_team_name__c}) == $Label.SER_EGS_TeamResFUCIB_lbl),
			ISCHANGED({!$Record.gf_task_notif_fucib_ind_type__c} ),
			{!$Record.gf_task_notif_fucib_ind_type__c}  = true
		)
	)
)</expression>
    </formulas>
