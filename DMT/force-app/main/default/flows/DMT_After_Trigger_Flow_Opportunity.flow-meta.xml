<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Has_GUMS_Product</name>
        <label>Has GUMS Product?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Has_GUMS_Product_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_First_OLI_With_GUMS</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_OLI_Underwriting_Holder_True</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_DMT_Opportunity</name>
        <label>Is DMT Opportunity?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Is_DMT_Opportunity_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>DMT_Opportunity</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_First_OLI_With_GUMS</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Should_Process_Underwriting_Form_Fields</name>
        <label>Should Process Underwriting Form Fields?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Should_Process_Underwriting_Form_Fields_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Copy_Needed</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_OLI_Set_Underwriting_And_Other_Fields</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Skip_If_Only_Has_GUMS_Changed</name>
        <label>Skip If Only Has GUMS Changed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Is_DMT_Opportunity</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Skip_If_Only_Has_GUMS_Changed_Skip</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>HasGUMSChanged</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>BusinessChanged</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Skip</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>BusinessChanged</name>
        <dataType>Boolean</dataType>
        <expression>OR({!Underwriting_Changed_Or_Init}, {!Other_Fields_Changed})</expression>
    </formulas>
    <formulas>
        <name>Copy_Needed</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  NOT( ISBLANK( TEXT($Record.underwriting_agreement_type__c) ) ),
  OR(
    {!Underwriting_Changed_Or_Init},
    {!Other_Fields_Changed}
  )
)</expression>
    </formulas>
    <formulas>
        <name>HasGUMSChanged</name>
        <dataType>Boolean</dataType>
        <expression>ISCHANGED($Record.DMT_HasGUMSProduct__c)</expression>
    </formulas>
    <formulas>
        <name>Other_Fields_Changed</name>
        <dataType>Boolean</dataType>
        <expression>OR(
  ISCHANGED($Record.deal_total_amount__c),
  ISCHANGED($Record.bbva_prtcp_tranche_amount__c),
  ISCHANGED($Record.syndicated_loan_drawn_amount__c),
  ISCHANGED($Record.operation_underwriting_per__c),
  ISCHANGED($Record.gf_est_fee_cust_sycr_bp_amount__c),
  ISCHANGED($Record.opening_fee_per__c),
  ISCHANGED($Record.risk_committee_aprvl_ind_type__c),
  ISCHANGED($Record.signing_date__c),
  ISCHANGED($Record.underwriting_amount__c),
  ISCHANGED($Record.gf_synd_fnl_primry_allc_amount__c),
  ISCHANGED($Record.risk_effective_date__c),
  ISCHANGED($Record.gf_settlement_date__c),
  ISCHANGED($Record.gf_oppy_credit_agree_sign_date__c),
  ISCHANGED($Record.clan_syndicated_loan_id__c),
  ISCHANGED($Record.oppy_undwr_cmtee_approval_date__c),
  ISCHANGED($Record.oppy_undwr_cmtee_rspse_type__c)
)</expression>
    </formulas>
    <formulas>
        <name>Underwriting_Changed_Or_Init</name>
        <dataType>Boolean</dataType>
        <expression>OR(
  ISCHANGED($Record.underwriting_agreement_type__c),
  AND(
    ISBLANK(TEXT($Record__Prior.underwriting_agreement_type__c)),
    NOT(ISBLANK(TEXT($Record.underwriting_agreement_type__c)))
  )
)</expression>
    </formulas>
    <interviewLabel>DMT_After_Trigger_Flow_Opportunity {!$Flow.CurrentDateTime}</interviewLabel>
    <label>DMT After Trigger Flow Opportunity</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_First_OLI_With_GUMS</name>
        <label>Get First OLI With GUMS</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_GUMS_Product</targetReference>
        </connector>
        <filterLogic>(1 AND (2 OR 3 OR 4 OR 5))</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>DES_Product_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>LOAN</stringValue>
            </value>
        </filters>
        <filters>
            <field>DES_Product_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Leverage Buyout (LBOs)</stringValue>
            </value>
        </filters>
        <filters>
            <field>DES_Product_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Liability Management</stringValue>
            </value>
        </filters>
        <filters>
            <field>DES_Product_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Project Finance</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>OpportunityLineItem</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
