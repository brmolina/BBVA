	}else{
		saveLogUserCTI('Make call by ClickToDial: current tab is target tab. No tab is needed to be opened.', 'OpenTab', false, '', '','','');
		syncFocusedTabWithCallLog(); // add current tab to SelectPicklis "RelatedTo"
	}
	//makeCallByClickToDial = '';
};	
	
	
