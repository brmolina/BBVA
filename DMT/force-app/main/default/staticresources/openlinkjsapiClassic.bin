			alert('The tab "' + tabName + '" is already opened.');			
			//sforce.console.focusPrimaryTabByName( tabName);
        }
		//tabName = '';
    };

var showObjectId = function showObjectId(result) {
	console.log(' --- result.id: ' + result.id);
	console.log(' --- makeCallByClickToDial: ' + makeCallByClickToDial);
	if (result.id != makeCallByClickToDial.split('%%')[0]){
		//sforce.console.openPrimaryTab(null, '/' + makeCallByClickToDial.split('%%')[0], true, makeCallByClickToDial.split('%%')[1], openSuccess, makeCallByClickToDial.split('%%')[1]);
		tabName = makeCallByClickToDial.split('%%')[2];
		var url = '/' + makeCallByClickToDial.split('%%')[0];
