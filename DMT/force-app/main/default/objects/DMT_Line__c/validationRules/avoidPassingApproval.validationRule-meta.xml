<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>avoidPassingApproval</fullName>
    <active>false</active>
    <errorConditionFormula>ISCHANGED(Status__c) &amp;&amp;  ISPICKVAL(PRIORVALUE(Status__c), &quot;Approval&quot;)  &amp;&amp; (ISPICKVAL(Status__c, &quot;Ready to close&quot;) || ISPICKVAL(Status__c, &quot;Closed&quot;)) &amp;&amp;  !DMT_Approval_Validation__c &amp;&amp;  !$Permission.DMT_Not_Approval_Required &amp;&amp; !DMT_Cancel__c</errorConditionFormula>
    <errorMessage>At least one of the approval features is not approved, you can&apos;t change status</errorMessage>
</ValidationRule>
