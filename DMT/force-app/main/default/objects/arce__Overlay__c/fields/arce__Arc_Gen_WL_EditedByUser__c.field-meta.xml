<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>arce__Arc_Gen_WL_EditedByUser__c</fullName>
    <deprecated>false</deprecated>
    <description>Checks if Watch List value was edited, comparing the actual value with origin value. Return N if value was not changed and Y otherwise.</description>
    <externalId>false</externalId>
    <formula>IF(TEXT(arce__Arc_Gen_WL_Level_Origin__c) == TEXT(arce__Arc_Gen_WL_Level__c), &apos;N&apos;, &apos;Y&apos;)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>WL Edited by User</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
