<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DES_NotChange_CloseOpportunityProduct</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT( $Profile.Name = &quot;System Administrator&quot;),
                OR(TEXT(opportunity_stage_type__c) == $Label.DES_Closed_Won,TEXT(opportunity_stage_type__c) == $Label.DES_Closed_Lose),
                NOT(ISCHANGED(opportunity_stage_type__c)),NOT(ISCHANGED(fprd__GBL_Empty_visible_fields__c)))</errorConditionFormula>
    <errorMessage>You cannot modify a product in a closed opportunity.</errorMessage>
</ValidationRule>
