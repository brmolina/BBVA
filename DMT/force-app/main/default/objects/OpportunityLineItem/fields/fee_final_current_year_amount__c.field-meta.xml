<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>fee_final_current_year_amount__c</fullName>
    <description>Total Commissions to charge in the remaining year</description>
    <formula>fee_next_12m_amount__c *((13 - MONTH(TODAY())) / 12)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Fees Year End (amount)</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <type>Currency</type>
</CustomField>
