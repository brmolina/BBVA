<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>endrs_fee_fnl_curr_year_amount__c</fullName>
    <description>Commission that accrues a guarantee issued in this year</description>
