<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validate_AcivityCustom_Name</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISCHANGED( Name ), 
NOT(OR  ($Profile.Name = &quot;System Administrator&quot;,$Permission.Champions_Locales)))</errorConditionFormula>
    <errorDisplayField>Name</errorDisplayField>
    <errorMessage>Name is not editable</errorMessage>
</ValidationRule>
