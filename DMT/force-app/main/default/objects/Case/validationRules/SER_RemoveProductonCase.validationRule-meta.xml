<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SER_RemoveProductonCase</fullName>
    <active>false</active>
    <description>User can&apos;t remove the product once selected</description>
    <errorConditionFormula>AND(
!$Setup.CIB_Bypass__c.CIB_skip_validationrule__c,
$Setup.CIB_User_Org__c.CIB_Is_Service__c,
ISCHANGED( SER_Transactional_Reference__c ),
NOT(ISBLANK(PRIORVALUE(SER_Transactional_Reference__c )))
)</errorConditionFormula>
    <errorMessage>The product selected can&apos;t be removed or changed</errorMessage>
</ValidationRule>
