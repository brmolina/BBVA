<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SER_Type_Field_Validation_WEB_APP_Opposi</fullName>
    <active>false</active>
    <description>Element field has to be &quot;App Movilidad&quot; if  Web / App field has &quot;APP&quot; value</description>
    <errorConditionFormula>AND(
!$Setup.CIB_Bypass__c.CIB_skip_validationrule__c,
$Setup.CIB_User_Org__c.CIB_Is_Service__c,
ISPICKVAL(SER_Web_App__c , &quot;APP&quot;),
NOT(CONTAINS(TEXT(SER_Type_EST__c ),&quot;App Movilidad&quot;))
)</errorConditionFormula>
    <errorDisplayField>SER_Type_EST__c</errorDisplayField>
    <errorMessage>Element field has to be &quot;App Movilidad&quot; if  Web / App field has &quot;APP&quot; value</errorMessage>
</ValidationRule>
