<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>cond__Acc_Cmp_Clarification_Validation_Allow</fullName>
    <active>true</active>
    <description>Evaluates if the profile is allow to make the clarification operation.</description>
    <errorConditionFormula>IF(AND(NOT($Setup.cond__GBL_Permission_Create_Acc_Clarification__c.cond__GBL_Active__c),CONTAINS(RecordType.DeveloperName, &apos;GBL_Account_Campaign_Clarification&apos;)),true, false)</errorConditionFormula>
    <errorMessage>This user is not allow to create a Account Campaign Clarification.</errorMessage>
</ValidationRule>
