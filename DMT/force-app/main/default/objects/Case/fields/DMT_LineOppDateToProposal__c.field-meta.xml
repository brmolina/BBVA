<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DMT_LineOppDateToProposal__c</fullName>
    <description>Field that shows the date from the Date to Proposal field in Opportunity or Line depending on what the Case is related to.</description>
    <formula>IF(DMT_LineOpportunity__c = &quot;L&quot;, DMT_Line__r.DMT_DateToProposal__c, IF(DMT_LineOpportunity__c = &quot;O&quot;, opportunity_id__r.DMT_DateToProposal__c, NULL))</formula>
    <label>Line/Opportunity Date To Proposal</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>DateTime</type>
</CustomField>
