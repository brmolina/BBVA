<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>almd__most_recent_tasks_type__c</fullName>
    <deprecated>false</deprecated>
    <externalId>false</externalId>
    <formula>IF(
ISPICKVAL(Status,&apos;Completed&apos;),
TEXT(almd__ActivityDateCloned__c)&amp;&apos; (&apos;&amp;TEXT(Status)&amp;&apos;)&apos;,
IF (almd__ActivityDateCloned__c&lt;TODAY(),&apos;Overdue&apos;,&apos; &apos;&amp;TEXT(almd__ActivityDateCloned__c))
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Most Recent Tasks</label>
    <required>false</required>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
