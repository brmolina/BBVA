<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Matudurity_Date_after_Initial_date</fullName>
    <active>true</active>
    <errorConditionFormula>DMT_DATE_Initial_Date__c &gt;= DMT_DATE_Maturity_Date__c</errorConditionFormula>
    <errorDisplayField>DMT_DATE_Maturity_Date__c</errorDisplayField>
    <errorMessage>Maturity Date cannot be earlier or same than Initial Date</errorMessage>
</ValidationRule>
