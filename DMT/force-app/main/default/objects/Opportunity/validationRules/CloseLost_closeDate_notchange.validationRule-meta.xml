<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CloseLost_closeDate_notchange</fullName>
    <active>true</active>
    <errorConditionFormula>AND( OR(ISCHANGED(CloseDate),ISCHANGED(DES_Product_name__c), ISCHANGED(DES_Product_Family__c) ), ISPICKVAL(StageName,&apos;Closed Lost&apos;) )</errorConditionFormula>
    <errorMessage>Sorry, but you can&apos;t modify the Close Date, Product Name or Product Family fields for a Closed Opportunity.</errorMessage>
</ValidationRule>
