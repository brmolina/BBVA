<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Draft_Status_TCM</fullName>
    <active>false</active>
    <description>You cant change status draft in dmt opp.</description>
    <errorConditionFormula>AND(
				DMT_RecordTypeName__c == &quot;DMT Opportunity&quot;,
				ISPICKVAL(PRIORVALUE(StageName), &quot;Draft&quot;) ,
				NOT(ISPICKVAL(StageName, &quot;Draft&quot; ))
				)</errorConditionFormula>
    <errorMessage>You cant change status in DMT Opportunity.</errorMessage>
</ValidationRule>
