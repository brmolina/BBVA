<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Adjusted_Prior_Year_Franchise__c</fullName>
    <description>Franquicia Prior Year ajustada por días transcurridos del año en curso para poder comparar este valor con franquicia YTD</description>
    <formula>Prior_Year_Franchise__c *(TODAY() - DATE(Year(TODAY()),01,01))/365</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Adjusted PY Franchise</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <type>Currency</type>
</CustomField>
