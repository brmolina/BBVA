<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Data_up_to_date__c</fullName>
    <externalId>false</externalId>
    <formula>IF( AND(LastModifiedBy.ProfileId = $Setup.Application_Settings_Hierarchy__c.DataLoader_ProfileId__c, DATEVALUE(LastModifiedDate)  &gt;=  TODAY() + 7), IMAGE(&quot;/resource/RedIcon2&quot;, &apos;&apos;), &apos;&apos;)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Red if the account has not been updated in the last 7 days.</inlineHelpText>
    <label>Data up-to-date</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
