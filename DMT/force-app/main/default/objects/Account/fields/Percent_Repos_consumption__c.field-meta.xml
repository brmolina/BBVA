<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Percent_Repos_consumption__c</fullName>
    <description>% ​Repos consumption / Repos limit​</description>
    <formula>if( Repos_limit__c &lt;&gt; 0, ( Repos_consumption__c / Repos_limit__c ) * 100, 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>% ​Repos consumption / Repos limit​</inlineHelpText>
    <label>% ​Repos consumption</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <type>Percent</type>
</CustomField>
