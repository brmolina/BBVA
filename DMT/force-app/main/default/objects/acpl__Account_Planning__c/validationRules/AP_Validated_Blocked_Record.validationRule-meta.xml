<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>AP_Validated_Blocked_Record</fullName>
    <active>true</active>
    <description>Validation Rule que evita que se pueda modificar un registro que está en estado Validated.</description>
    <errorConditionFormula>AND(
$Profile.Name &lt;&gt; &quot;System Administrator&quot;,
$Profile.Name &lt;&gt; &quot;Desktop Integration&quot;,
NOT(ISCHANGED(acpl__gf_ap_status_type_name__c)),

NOT(ISCHANGED(acpl__gf_ap_substatus_type_name__c)), NOT(ISCHANGED(gf_participant_analysis_id__c)),
ISPICKVAL(acpl__gf_ap_status_type_name__c, &apos;Validated&apos;),
AND(
NOT(ISCHANGED(acpl__gf_ap_public_ind_type__c)),
ISPICKVAL(acpl__gf_ap_substatus_type_name__c, &apos;Under Review&apos;))
)</errorConditionFormula>
    <errorMessage>Sorry, this Account Plan is already validated and cannot be modified.</errorMessage>
</ValidationRule>
