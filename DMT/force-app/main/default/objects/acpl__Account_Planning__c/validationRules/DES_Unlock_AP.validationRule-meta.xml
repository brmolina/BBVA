<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DES_Unlock_AP</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(ISCHANGED(acpl__gf_ap_status_type_name__c))
&amp;&amp; NOT(ISCHANGED(acpl__gf_ap_substatus_type_name__c))
&amp;&amp; ISCHANGED(acpl__gf_ap_indvi_lock_edit_ind_type__c) 
&amp;&amp; ($Permission.AP_Administrator = FALSE 
				&amp;&amp;  $Profile.Name &lt;&gt;  $Label.DES_ADMIN_PROFILE 
				&amp;&amp; $Profile.Name &lt;&gt; $Label.DES_INTEGRATION_PROFILE
			&amp;&amp; $Profile.Name &lt;&gt; $Label.DES_AP_ADMIN_PROFILE)</errorConditionFormula>
    <errorDisplayField>acpl__gf_ap_indvi_lock_edit_ind_type__c</errorDisplayField>
    <errorMessage>Sorry, this operation can only be performed by an administrator</errorMessage>
</ValidationRule>
