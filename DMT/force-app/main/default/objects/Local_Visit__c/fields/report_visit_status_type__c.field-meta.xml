<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>report_visit_status_type__c</fullName>
    <description>Status to Vistit Reports</description>
    <externalId>false</externalId>
    <formula>IF(visit_start_date__c  &gt;  Now()   ,
        &apos;No realizada&apos;
        ,
        IF(ISPICKVAL(visit_status_type__c, &quot;05&quot;),
        &apos;Finalizada&apos;
        ,
        &apos;Pendiente de feedback&apos;
        )
        )</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Estado de visitas</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
