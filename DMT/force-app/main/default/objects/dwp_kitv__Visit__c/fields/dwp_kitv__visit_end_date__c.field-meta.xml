<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>dwp_kitv__visit_end_date__c</fullName>
    <deprecated>false</deprecated>
    <description>Formula field where the duration was added to start date.</description>
    <formula>dwp_kitv__visit_start_date__c + VALUE(TEXT( dwp_kitv__visit_duration_number__c ))/1440</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>End Date</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>DateTime</type>
</CustomField>
