<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SER_Contact_PhoneOrMail_Mandatory</fullName>
    <active>true</active>
    <description>When creating a Contact, the phone or the email has to be included.</description>
    <errorConditionFormula>AND(
  !$Setup.CIB_Bypass__c.CIB_skip_validationrule__c,
  ISBLANK(Email_ExternalID__c),
  ISBLANK(Email_2__c),
  ISBLANK(Phone)
)</errorConditionFormula>
    <errorMessage>Phone or Email must be completed</errorMessage>
</ValidationRule>
