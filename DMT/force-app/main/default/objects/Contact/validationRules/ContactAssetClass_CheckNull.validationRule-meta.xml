<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ContactAssetClass_CheckNull</fullName>
    <active>false</active>
    <description>Check if Asset Class is null and the user is a Sales User</description>
    <errorConditionFormula>AND(!$Setup.CIB_Bypass__c.CIB_skip_validationrule__c,
$Setup.CIB_User_Org__c.CIB_Is_Sales__c,ISBLANK(Asset_Class__c))</errorConditionFormula>
    <errorDisplayField>Asset_Class__c</errorDisplayField>
    <errorMessage>Asset Class can not be null</errorMessage>
</ValidationRule>
