<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>StageToolkitChange</fullName>
    <active>true</active>
    <errorConditionFormula>AND(RecordType.Name  = &quot;Commercial Task Toolkit&quot;,AND(  ISPICKVAL(altm__alert_stage_type__c , &quot;Unread&quot;),  ISPICKVAL(PRIORVALUE(altm__alert_stage_type__c ),&quot;Pending&quot;) ))</errorConditionFormula>
    <errorDisplayField>altm__alert_stage_type__c</errorDisplayField>
    <errorMessage>You  cannot  mark this  item  as  unread.</errorMessage>
</ValidationRule>
