<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DES_GB_role_edition</fullName>
    <active>true</active>
    <description>Global Banker role can not be modified.</description>
    <errorConditionFormula>AND(
$Profile.Name &lt;&gt; &quot;System Administrator&quot;,
$Profile.Name &lt;&gt; &quot;Desktop Integration&quot;,
ISCHANGED(bupl__gf_ap_team_role_user_name__c),
ISPICKVAL(PRIORVALUE(bupl__gf_ap_team_role_user_name__c), &apos;Global Banker&apos;)
)</errorConditionFormula>
    <errorDisplayField>bupl__gf_ap_team_role_user_name__c</errorDisplayField>
    <errorMessage>The Global Banker role can not be modified.</errorMessage>
</ValidationRule>
